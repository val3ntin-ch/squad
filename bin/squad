#!/usr/bin/env bash
# squad - run a team of coding agents on a repository, inside herdr.
# https://herdr.dev is the terminal runtime; squad sets up the team on top of it.

set -euo pipefail
VERSION="0.7.0"

# ---- locate our own files (follow symlinks; works on macOS bash 3.2) ---------

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  dir=$(cd -P "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
SQUAD_HOME=$(cd -P "$(dirname "$self")/.." && pwd)
TEMPLATES="$SQUAD_HOME/templates"
PRESETS="$SQUAD_HOME/presets"
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/squad/team.conf"

die()  { printf 'squad: %s\n' "$*" >&2; exit 1; }
say()  { printf '%s\n' "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed. $2"; }

usage() {
  cat <<EOF
squad $VERSION - a team of coding agents on your repository, inside herdr

Usage:
  squad new <dir> [--preset NAME]   create a new project with git and a team
  squad init [--preset NAME]        add a team to the current repository
  squad up                          start the team (run inside herdr)
  squad brief                       re-send the role briefing to a running team
  squad status                      show seats, agent states and the task table
  squad down                        stop the team (close its herdr workspace)
  squad clean                       remove the team's worktrees (clean ones only)
  squad config [--preset NAME]      create or show your personal default team
  squad doctor                      check that everything needed is installed
  squad presets                     list the built-in team presets
  squad permissions                 let Codex run 'squad herdr' in every project
  squad herdr <args>                herdr, bound to this team's session (used by agents)
  squad watch                       live strip: plan usage, tasks, seats (runs in the team tab)
  squad usage                       one line of plan usage per vendor (Claude, Codex)
  squad statusline                  Claude Code status line: shows and records Claude's usage
  squad done <seat> <task> <status> a worker tells the lead it finished (used by agents)
  squad git <args>                  git writes for agents (switch/add/commit/merge...; no push/force/delete)

A team is defined in .team/team.conf. 'squad init' copies your personal
default ($USER_CONF) if it exists, otherwise the
'default' preset. Edit the file to change seats, agents or models.
EOF
}

# ---- repository --------------------------------------------------------------

REPO="" TEAM_DIR="" WT_ROOT="" GIT_COMMON=""
find_repo() {
  need git ""
  git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository. Use 'squad new <dir>' to start a project."
  # The main checkout, even when called from one of the team's worktrees.
  REPO=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
  [ -n "$REPO" ] || die "could not find the repository root."
  TEAM_DIR="$REPO/.team"
  WT_ROOT="${REPO}-team"
  GIT_COMMON=$(cd "$REPO" && git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || GIT_COMMON="$REPO/.git"  # git < 2.31
}

# ---- team.conf ---------------------------------------------------------------

S_NAME=() S_KIND=() S_ROLE=() S_REVIEWS=() S_ARGS=()
TEAM_BASE="team/integration"
SETUP_CMD=""
LEAD=""

load_conf() {
  local conf="$TEAM_DIR/team.conf" kw name kind role reviews rest n=0 line_no=0
  [ -f "$conf" ] || die "$conf not found. Run 'squad init' first."
  S_NAME=() S_KIND=() S_ROLE=() S_REVIEWS=() S_ARGS=()
  while IFS= read -r line || [ -n "$line" ]; do
    line_no=$((line_no + 1))
    line=${line%%#*}
    read -r kw rest <<<"$line" || true
    case "${kw:-}" in
      "") continue ;;
      base)  [ -n "$rest" ] && TEAM_BASE=$rest ;;
      setup) SETUP_CMD=$rest ;;
      seat)
        read -r name kind role reviews rest <<<"$rest" || true
        [ -n "${role:-}" ] || die "team.conf line $line_no: expected 'seat <name> <agent> <role> <reviews> [args]'."
        [[ "$name" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "team.conf line $line_no: seat name '$name' must be lowercase letters, digits, - or _."
        case "$role" in lead|dev|reviewer|tester) ;; *) die "team.conf line $line_no: role '$role' must be lead, dev, reviewer or tester." ;; esac
        local i
        for ((i = 0; i < n; i++)); do
          [ "${S_NAME[$i]}" != "$name" ] || die "team.conf line $line_no: seat '$name' is defined twice."
        done
        S_NAME[$n]=$name; S_KIND[$n]=$kind; S_ROLE[$n]=$role
        S_REVIEWS[$n]=${reviews:--}; S_ARGS[$n]=${rest:-}
        n=$((n + 1)) ;;
      *) die "team.conf line $line_no: unknown keyword '$kw'." ;;
    esac
  done <"$conf"

  local leads=0 i
  for ((i = 0; i < n; i++)); do
    if [ "${S_ROLE[$i]}" = lead ]; then leads=$((leads + 1)); LEAD=${S_NAME[$i]}; fi
  done
  [ "$leads" = 1 ] || die "team.conf must define exactly one seat with the role 'lead' (found $leads)."

  # Every name a reviewer points at must be a dev.
  local r target found j
  for ((i = 0; i < n; i++)); do
    [ "${S_ROLE[$i]}" = reviewer ] || continue
    r=${S_REVIEWS[$i]}
    [ "$r" != "-" ] || die "team.conf: reviewer '${S_NAME[$i]}' must name the dev(s) it reviews."
    IFS=, read -r -a _targets <<<"$r"
    for target in "${_targets[@]}"; do
      found=0
      for ((j = 0; j < n; j++)); do
        if [ "${S_NAME[$j]}" = "$target" ] && [ "${S_ROLE[$j]}" = dev ]; then found=1; fi
      done
      [ "$found" = 1 ] || die "team.conf: reviewer '${S_NAME[$i]}' reviews '$target', which is not a dev seat."
    done
  done
}

seat_count() { echo "${#S_NAME[@]}"; }

role_file() { # role -> path
  case "$1" in
    lead) echo "$TEAM_DIR/roles/lead.md" ;;
    dev) echo "$TEAM_DIR/roles/dev.md" ;;
    reviewer) echo "$TEAM_DIR/roles/reviewer.md" ;;
    tester) echo "$TEAM_DIR/roles/tester.md" ;;
  esac
}

seat_cwd() { # index -> working directory
  case "${S_ROLE[$1]}" in
    lead|reviewer) echo "$WT_ROOT/integration" ;;
    *) echo "$WT_ROOT/${S_NAME[$1]}" ;;
  esac
}

clear_cmd() { # agent kind -> command that resets its conversation
  case "$1" in
    claude) echo "/clear" ;;
    codex|opencode) echo "/new" ;;
    *) echo "-" ;;
  esac
}

write_roster() {
  local i n; n=$(seat_count)
  {
    echo "# Roster"
    echo
    echo "Generated by squad from team.conf on every start. Do not edit; change team.conf instead."
    echo
    echo "| Seat | Role | Agent | Arguments | Reviews | Clear |"
    echo "|---|---|---|---|---|---|"
    for ((i = 0; i < n; i++)); do
      printf '| `%s` | %s | %s | %s | %s | `%s` |\n' \
        "${S_NAME[$i]}" "${S_ROLE[$i]}" "${S_KIND[$i]}" "${S_ARGS[$i]:--}" \
        "${S_REVIEWS[$i]}" "$(clear_cmd "${S_KIND[$i]}")"
    done
    echo
    echo "\"Reviews\" is the dev whose tasks that reviewer checks. \"Clear\" is the command"
    echo "to send a seat, as a prompt of its own, to reset its context between tasks"
    echo "(\"-\" means none is known for that agent; leave its context alone)."
  } >"$TEAM_DIR/ROSTER.md"
}

# ---- init / new / config -----------------------------------------------------

preset_path() {
  [ -f "$PRESETS/$1.conf" ] || die "no preset named '$1'. Run 'squad presets' to list them."
  echo "$PRESETS/$1.conf"
}

parse_preset_flag() { # sets PRESET from "--preset NAME" in "$@"
  PRESET=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --preset) [ $# -ge 2 ] || die "--preset needs a name."; PRESET=$2; shift 2 ;;
      --preset=*) PRESET=${1#--preset=}; shift ;;
      *) die "unknown option '$1'." ;;
    esac
  done
}

copy_if_missing() { # src dst
  if [ -e "$2" ]; then say "  kept     ${2#"$REPO"/}"; else cp "$1" "$2"; say "  created  ${2#"$REPO"/}"; fi
}

# Agents can't rely on their environment: Codex runs commands through a shared
# daemon that keeps the environment of whichever pane started it first (seen:
# another herdr server's socket and pane). So squad writes the real values into
# the files agents read, and gives them a herdr wrapper bound to this team's
# session.
render() { # <template> <dest>
  local text herdr_bin="$SQUAD_HOME/bin/squad herdr"
  text=$(cat "$1"; echo x); text=${text%x}
  text=${text//"\$TEAM_DIR"/"$TEAM_DIR"}
  text=${text//"\$TEAM_BASE"/"$TEAM_BASE"}
  text=${text//"herdr agent "/"$herdr_bin agent "}
  text=${text//"squad done "/"$SQUAD_HOME/bin/squad done "}
  local git_bin="$SQUAD_HOME/bin/squad git" sub
  for sub in switch add commit merge rebase restore stash; do
    text=${text//"git $sub "/"$git_bin $sub "}
  done
  printf '%s' "$text" >"$2"
}

render_team_files() {
  local f
  mkdir -p "$TEAM_DIR/roles"
  render "$TEMPLATES/PROTOCOL.md" "$TEAM_DIR/PROTOCOL.md"
  for f in "$TEMPLATES"/roles/*.md; do render "$f" "$TEAM_DIR/roles/$(basename "$f")"; done
}

write_herdr_socket() { # remember the herdr session squad runs in, for 'squad herdr'
  printf '%s\n' "${HERDR_SOCKET_PATH:-}" >"$TEAM_DIR/herdr.sock"
}

# squad herdr <args> — herdr, bound to the session of the team this directory
# belongs to. One stable command for every project, so one permission rule
# (squad permissions) covers them all.
cmd_herdr() {
  find_repo
  local sock; sock=$(cat "$TEAM_DIR/herdr.sock" 2>/dev/null || true)
  if [ -n "$sock" ]; then HERDR_SOCKET_PATH=$sock exec herdr "$@"; else exec herdr "$@"; fi
}

# ---- usage ---------------------------------------------------------------------
# Plan usage per vendor, as JSON {p5,r5,p7,r7}: percent used and reset time
# (epoch seconds) of the 5-hour and 7-day windows. Codex writes rate_limits into
# its session files; Claude passes them to its status line, which 'squad
# statusline' saves. Missing data prints nothing.
CLAUDE_USAGE="${XDG_CACHE_HOME:-$HOME/.cache}/squad/claude-usage.json"

usage_codex() {
  local dir="${CODEX_HOME:-$HOME/.codex}/sessions" f
  [ -d "$dir" ] || return 0
  f=$(find "$dir" -name 'rollout-*.jsonl' -mtime -7 -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -1)
  [ -n "$f" ] || return 0
  grep '"rate_limits"' "$f" | tail -1 \
    | jq -c '[.. | objects | select(.rate_limits? and (.rate_limits | type) == "object") | .rate_limits][0] // empty
             | {p5: .primary.used_percent, r5: .primary.resets_at, p7: .secondary.used_percent, r7: .secondary.resets_at}' 2>/dev/null
}

usage_claude() { [ -f "$CLAUDE_USAGE" ] && jq -c '{p5, r5, p7, r7}' "$CLAUDE_USAGE" 2>/dev/null; return 0; }

# bar <percent> <resets_at> -> "▓▓░░░ 41%" (a window past its reset shows 0%)
bar() {
  local pct=${1:-} reset=${2:-} now cells i out=""
  [ -n "$pct" ] && [ "$pct" != null ] || { printf '%s' "  —  "; return; }
  now=$(date +%s)
  if [ -n "$reset" ] && [ "$reset" != null ] && [ "${reset%.*}" -le "$now" ]; then pct=0; fi
  pct=${pct%.*}
  cells=$(( (pct + 10) / 20 )); [ "$cells" -gt 5 ] && cells=5
  for ((i = 0; i < 5; i++)); do if [ "$i" -lt "$cells" ]; then out="${out}▓"; else out="${out}░"; fi; done
  printf '%s %3s%%' "$out" "$pct"
}

usage_line() { # one line for every vendor with data
  local name json line="" r5 when
  for name in Claude Codex; do
    if [ "$name" = Claude ]; then json=$(usage_claude); else json=$(usage_codex); fi
    [ -n "$json" ] || { line="$line$name —   "; continue; }
    line="$line$name 5h $(bar "$(jq -r .p5 <<<"$json")" "$(jq -r .r5 <<<"$json")") 7d $(bar "$(jq -r .p7 <<<"$json")" "$(jq -r .r7 <<<"$json")")"
    # nearly used up: when does it come back?
    r5=$(jq -r --argjson now "$(date +%s)" 'if (.p5 // 0) >= 80 and (.r5 // 0) > $now then .r5 else empty end' <<<"$json")
    if [ -n "$r5" ] && [ "$r5" != null ]; then
      when=$(date -r "${r5%.*}" '+%H:%M' 2>/dev/null || date -d "@${r5%.*}" '+%H:%M' 2>/dev/null)
      line="$line (5h back $when)"
    fi
    line="$line   "
  done
  printf '%s\n' "${line%   }"
}

cmd_usage() { usage_line; }

# squad statusline — Claude Code status line: saves the plan usage Claude
# passes on stdin (for 'squad watch') and prints a compact line.
cmd_statusline() {
  local input model
  input=$(cat)
  mkdir -p "$(dirname "$CLAUDE_USAGE")"
  jq -c '.rate_limits // empty | {p5: .five_hour.used_percentage, r5: .five_hour.resets_at, p7: .seven_day.used_percentage, r7: .seven_day.resets_at}' \
    <<<"$input" 2>/dev/null >"$CLAUDE_USAGE.tmp" && [ -s "$CLAUDE_USAGE.tmp" ] && mv "$CLAUDE_USAGE.tmp" "$CLAUDE_USAGE"
  rm -f "$CLAUDE_USAGE.tmp"
  model=$(jq -r '.model.display_name // empty' <<<"$input" 2>/dev/null)
  local json; json=$(usage_claude)
  if [ -n "$json" ]; then
    printf '%s  5h %s  7d %s\n' "$model" "$(bar "$(jq -r .p5 <<<"$json")" "$(jq -r .r5 <<<"$json")")" "$(bar "$(jq -r .p7 <<<"$json")" "$(jq -r .r7 <<<"$json")")"
  else
    printf '%s\n' "$model"
  fi
}

# squad watch — the live strip in the team tab: usage per vendor, each task's
# state, each seat's state and the last event. Refreshes every 20 s.
watch_once() {
  local agents_json tasks states="" i n state ev mark
  agents_json=$(herdr_team agent list 2>/dev/null) || agents_json='{"result":{"agents":[]}}'
  n=$(seat_count)
  for ((i = 0; i < n; i++)); do
    state=$(jq -r --arg n "${S_NAME[$i]}" '[.result.agents[] | select(.name == $n) | .agent_status][0] // "off"' <<<"$agents_json")
    case "$state" in working) mark="●" ;; blocked) mark="!" ;; idle|done) mark="○" ;; *) mark="·" ;; esac
    states="$states${S_NAME[$i]} $mark  "
  done
  tasks=$(awk -F'|' '/^\| *T-[0-9]/ {gsub(/^ +| +$/, "", $2); gsub(/^ +| +$/, "", $4); gsub(/^ +| +$/, "", $5); printf "%s %s %s · ", $2, $4, $5}' "$TEAM_DIR/TASKS.md" 2>/dev/null || true)
  ev=$(tail -1 "$TEAM_DIR/events.log" 2>/dev/null || true)  # no events yet on a fresh team
  printf '\033[H\033[2J'
  printf ' %s\n' "$(usage_line)"
  printf ' %s\n' "${tasks% · }"
  printf ' %s%s\n' "$states" "${ev:+  last: $ev}"
}

herdr_team() { # herdr bound to this team's session
  local sock; sock=$(cat "$TEAM_DIR/herdr.sock" 2>/dev/null || true)
  if [ -n "$sock" ]; then HERDR_SOCKET_PATH=$sock herdr "$@"; else herdr "$@"; fi
}

cmd_watch() {
  find_repo; load_conf
  local once=0; [ "${1:-}" = --once ] && once=1
  while :; do
    watch_once
    [ "$once" = 1 ] && return 0
    sleep 20
  done
}

# squad done <seat> <task> <status> — a worker's last step: tell the lead it
# finished, even while the lead is busy (herdr queues the message for it).
# herdr's 'agent wait' watches one agent at a time, so a lead waiting on one
# worker never noticed another one finishing; this push replaces that.
cmd_done() {
  [ $# -ge 3 ] || die "usage: squad done <seat> <task> <status>"
  local seat=$1 task=$2 status=$3 i n role="" report sock
  find_repo; load_conf; n=$(seat_count)
  for ((i = 0; i < n; i++)); do [ "${S_NAME[$i]}" = "$seat" ] && role=${S_ROLE[$i]}; done
  [ -n "$role" ] || die "no seat named '$seat' in this team."
  case "$role" in
    dev) report="$TEAM_DIR/reports/$task-dev.md" ;;
    tester) report="$TEAM_DIR/reports/$task-test.md" ;;
    reviewer) report=$(ls -t "$TEAM_DIR/reports/$task"-review-*.md 2>/dev/null | head -1) ;;
    *) report="" ;;
  esac
  [ -z "$report" ] || [ -f "$report" ] || say "squad: note — $report does not exist yet; write the report first."
  printf '%s %s %s %s\n' "$(date '+%H:%M:%S')" "$seat" "$task" "$status" >>"$TEAM_DIR/events.log"
  [ "$seat" = "$LEAD" ] && return 0
  sock=$(cat "$TEAM_DIR/herdr.sock" 2>/dev/null || true)
  # Codex injects a message that arrives mid-turn into the running turn and
  # would drop the unfinished step; told to finish first, it does (tested).
  local msg="[squad] $seat finished $task: $status${report:+ — report: $report}. (Notification: first finish what you were doing, then handle this.)"
  if [ -n "$sock" ]; then HERDR_SOCKET_PATH=$sock herdr agent prompt "$LEAD" "$msg" >/dev/null
  else herdr agent prompt "$LEAD" "$msg" >/dev/null; fi || die "could not reach the lead; the event is in $TEAM_DIR/events.log"
  say "told $LEAD: $msg"
}

# squad git <subcommand> <args> — the git writes a team needs, for Codex seats.
# Codex's workspace-write sandbox keeps .git read-only by design (also the git
# dir a worktree points to), so switch/add/commit/merge fail inside it. This
# command, allowed by one Codex rule, runs only those writes, only inside a
# squad team, and never push, force or delete.
cmd_git() {
  find_repo
  [ -f "$TEAM_DIR/team.conf" ] || die "squad git only runs inside a repository with a squad team."
  local here; here=$(pwd -P)
  case "$here/" in "$REPO"/*|"$WT_ROOT"/*) ;; *) die "squad git only runs inside the team's repository or worktrees." ;; esac
  case "${1:-}" in
    switch|add|commit|merge|rebase|restore|stash) ;;
    branch) case " $* " in *" -d "*|*" -D "*|*" --delete "*|*" -m "*|*" -M "*|*" --force "*) die "squad git branch: deleting, renaming or forcing branches is not allowed." ;; esac ;;
    *) die "squad git: '${1:-}' is not allowed. Allowed: switch add commit merge rebase restore stash branch. Read-only git (status, diff, log, show) runs as plain git." ;;
  esac
  case " $* " in *" --force "*|*" -f "*|*" --force-with-lease"*) die "squad git: forcing is not allowed." ;; esac
  exec git "$@"
}

# squad permissions — one-time machine setup: Codex rules so 'squad herdr',
# 'squad git' and 'squad done' never ask, and Claude Code's status line set to
# 'squad statusline' (plan usage) unless you already have one.
cmd_permissions() {
  local rules="${CODEX_HOME:-$HOME/.codex}/rules/default.rules"
  local sub rule
  mkdir -p "$(dirname "$rules")"
  for sub in herdr git "done"; do
    rule="prefix_rule(pattern=[\"$SQUAD_HOME/bin/squad\", \"$sub\"], decision=\"allow\")"
    if grep -qxF "$rule" "$rules" 2>/dev/null; then say "ok       Codex may run 'squad $sub' ($rules)"; continue; fi
    printf '%s\n' "$rule" >>"$rules"
    say "Added to $rules:"
    say "  $rule"
  done
  local claude_settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" current tmp
  local line='command -v squad >/dev/null 2>&1 && squad statusline 2>/dev/null || true'
  current=$(jq -r '.statusLine.command // empty' "$claude_settings" 2>/dev/null || true)
  if [ "$current" = "$line" ]; then
    say "ok       Claude status line shows plan usage"
  elif [ -n "$current" ]; then
    say "note     Claude already has a status line; left as is. For usage bars, use: squad statusline"
  else
    mkdir -p "$(dirname "$claude_settings")"
    [ -s "$claude_settings" ] || echo '{}' >"$claude_settings"
    tmp=$(mktemp)
    jq --arg c "$line" '.statusLine = {type: "command", command: $c}' "$claude_settings" >"$tmp" && cat "$tmp" >"$claude_settings"
    rm -f "$tmp"
    say "Set Claude's status line to 'squad statusline' ($claude_settings)"
  fi
}

# The install command a fresh worktree needs, from the lockfile in the repo.
detect_setup() {
  local r=$REPO
  if   [ -f "$r/pnpm-lock.yaml" ]; then echo "pnpm install --frozen-lockfile"
  elif [ -f "$r/yarn.lock" ] && [ -f "$r/.yarnrc.yml" ]; then echo "yarn install --immutable"
  elif [ -f "$r/yarn.lock" ]; then echo "yarn install --frozen-lockfile"
  elif [ -f "$r/package-lock.json" ]; then echo "npm ci"
  elif [ -f "$r/bun.lock" ] || [ -f "$r/bun.lockb" ]; then echo "bun install --frozen-lockfile"
  elif [ -f "$r/uv.lock" ]; then echo "uv sync"
  elif [ -f "$r/poetry.lock" ]; then echo "poetry install"
  elif [ -f "$r/Gemfile.lock" ]; then echo "bundle install"
  fi
}

cmd_init() {
  parse_preset_flag "$@"
  find_repo
  local conf_src
  if [ -n "$PRESET" ]; then conf_src=$(preset_path "$PRESET")
  elif [ -f "$USER_CONF" ]; then conf_src=$USER_CONF
  else conf_src=$(preset_path default); fi

  mkdir -p "$TEAM_DIR/roles" "$TEAM_DIR/reports"
  say "Setting up $TEAM_DIR"
  local new_conf=0; [ -e "$TEAM_DIR/team.conf" ] || new_conf=1
  copy_if_missing "$conf_src" "$TEAM_DIR/team.conf"
  # a new team.conf with an empty 'setup' line gets the repo's install command
  local detected; detected=$(detect_setup)
  if [ "$new_conf" = 1 ] && [ -n "$detected" ] && grep -qE '^setup[[:space:]]*$' "$TEAM_DIR/team.conf"; then
    local tmp; tmp=$(mktemp)
    awk -v cmd="$detected" '/^setup[[:space:]]*$/ && !done {print "setup " cmd; done=1; next} {print}' "$TEAM_DIR/team.conf" >"$tmp" \
      && cat "$tmp" >"$TEAM_DIR/team.conf"; rm -f "$tmp"
    say "  setup    $detected (detected; change it in .team/team.conf)"
  fi
  copy_if_missing "$TEMPLATES/SPEC.md" "$TEAM_DIR/SPEC.md"
  copy_if_missing "$TEMPLATES/TASKS.md" "$TEAM_DIR/TASKS.md"

  # Keep team files out of commits without touching the tracked .gitignore.
  local exclude; exclude="$(cd "$REPO" && git rev-parse --git-common-dir)/info/exclude"
  case "$exclude" in /*) ;; *) exclude="$REPO/$exclude" ;; esac
  mkdir -p "$(dirname "$exclude")"
  grep -qxF '.team/' "$exclude" 2>/dev/null || printf '.team/\n' >>"$exclude"

  load_conf
  # Protocol and roles belong to the tool: refresh them so upgrades take effect.
  render_team_files
  say "  updated  .team/PROTOCOL.md and .team/roles/"
  write_roster
  say ""
  say "Team of $(seat_count) seats defined in .team/team.conf (from ${conf_src/#$HOME/~})."
  say "Next: start herdr in this repository and run 'squad up'."
}

cmd_new() {
  [ $# -ge 1 ] || die "usage: squad new <dir> [--preset NAME]"
  local dir=$1; shift
  need git ""
  [ ! -e "$dir" ] || die "'$dir' already exists. Use 'squad init' inside it instead."
  mkdir -p "$dir"
  ( cd "$dir"
    git init -q
    git commit -q --allow-empty -m "Initial commit" \
      || die "git could not create the first commit (set user.name and user.email)."
    cmd_init "$@" )
  say ""
  say "Project created in $dir. Then:  cd $dir && herdr   and run 'squad up'."
}

cmd_config() {
  parse_preset_flag "$@"
  if [ -n "$PRESET" ] || [ ! -f "$USER_CONF" ]; then
    mkdir -p "$(dirname "$USER_CONF")"
    cp "$(preset_path "${PRESET:-default}")" "$USER_CONF"
    say "Wrote your default team from the '${PRESET:-default}' preset."
  fi
  say "Your default team: $USER_CONF"
  say "Edit it to change the seats every new 'squad init' starts with."
}

cmd_presets() {
  local f
  for f in "$PRESETS"/*.conf; do
    printf '%-10s %s\n' "$(basename "$f" .conf)" "$(grep -c '^seat ' "$f") seats"
  done
}

# ---- doctor ------------------------------------------------------------------

cmd_doctor() {
  local ok=0 tool i n kinds=""
  for tool in git jq herdr; do
    if command -v "$tool" >/dev/null 2>&1; then say "ok       $tool"; else say "MISSING  $tool"; ok=1; fi
  done
  if git rev-parse --git-dir >/dev/null 2>&1; then
    find_repo
    if [ -f "$TEAM_DIR/team.conf" ]; then
      load_conf; n=$(seat_count)
      for ((i = 0; i < n; i++)); do
        case " $kinds " in *" ${S_KIND[$i]} "*) continue ;; esac
        kinds="$kinds ${S_KIND[$i]}"
        if command -v "${S_KIND[$i]}" >/dev/null 2>&1; then say "ok       ${S_KIND[$i]} (agent)"
        else say "MISSING  ${S_KIND[$i]} (agent used in team.conf; if its command has another name, ignore this)"; ok=1; fi
      done
    else
      say "note     no .team/team.conf here yet (run 'squad init')"
    fi
  fi
  if command -v codex >/dev/null 2>&1; then
    local codex_rules="${CODEX_HOME:-$HOME/.codex}/rules/default.rules"
    if grep -qF "\"$SQUAD_HOME/bin/squad\", \"herdr\"" "$codex_rules" 2>/dev/null \
       && grep -qF "\"$SQUAD_HOME/bin/squad\", \"git\"" "$codex_rules" 2>/dev/null \
       && grep -qF "\"$SQUAD_HOME/bin/squad\", \"done\"" "$codex_rules" 2>/dev/null; then
      say "ok       codex may run 'squad herdr', 'squad git' and 'squad done' without asking"
    else
      say "note     Codex seats will ask before 'squad herdr' / 'squad git' calls; run: squad permissions"
    fi
  fi
  # Codex shows an "Update available" dialog on start that blocks a seat
  if command -v codex >/dev/null 2>&1; then
    local codex_conf="${CODEX_HOME:-$HOME/.codex}/config.toml"
    if grep -Eq '^check_for_update_on_startup *= *false' "$codex_conf" 2>/dev/null; then
      say "ok       codex update check off (no update dialog blocking seats)"
    else
      say "note     codex may show an update dialog that blocks a seat on start; to avoid it add"
      say "         check_for_update_on_startup = false   to $codex_conf"
    fi
  fi
  if [ "${HERDR_ENV:-}" = 1 ]; then say "ok       running inside herdr"; else say "note     not inside herdr ('squad up' must be run from a herdr pane)"; fi
  return $ok
}

# ---- up / brief --------------------------------------------------------------

require_herdr() {
  need herdr "See https://herdr.dev"
  need jq "(brew install jq / apt install jq)"
  [ "${HERDR_ENV:-}" = 1 ] || die "run this from a pane inside herdr (start 'herdr' in the repository first)."
}

mark_briefed() { mkdir -p "$TEAM_DIR/.briefed" && : >"$TEAM_DIR/.briefed/$1"; }
is_briefed() { [ -f "$TEAM_DIR/.briefed/$1" ]; }

brief() { # [seat names...] — none: every seat. The lead goes last.
  local i n failed=0 name want=" $* "; n=$(seat_count)
  wanted() { [ "$want" = "  " ] || case "$want" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
  for ((i = 0; i < n; i++)); do
    [ "${S_ROLE[$i]}" != lead ] || continue
    name=${S_NAME[$i]}
    wanted "$name" || continue
    # role already loaded as a system prompt: nothing to type, nothing to wait for
    if loads_role "${S_KIND[$i]}"; then mark_briefed "$name"; continue; fi
    if herdr agent prompt "$name" \
      "You are '$name' on an agent team. Read $TEAM_DIR/PROTOCOL.md and $(role_file "${S_ROLE[$i]}") now. Do not start any work yet. Reply with the single word READY." \
      --wait --timeout 180000 >/dev/null; then
      say "  briefed $name"; mark_briefed "$name"
    else
      say "  could not brief $name (see the error above; open its pane and check it)"
      failed=1
    fi
  done
  wanted "$LEAD" || return $failed
  # The lead is briefed last and not waited on: it goes straight to the human.
  # A restarted team (approved spec on disk) resumes from the files instead of
  # starting over: agents have no memory, everything is in .team/ and git.
  local lead_msg
  lead_msg="You are the lead of an agent team. Read $TEAM_DIR/PROTOCOL.md, $TEAM_DIR/ROSTER.md and $(role_file lead) now, then begin Phase 1 by asking me what we are building."
  if grep -qE '^Status: *APPROVED' "$TEAM_DIR/SPEC.md" 2>/dev/null; then
    lead_msg="You are the lead of an agent team that is resuming after a restart; nobody remembers earlier work, it is all in files. Read $TEAM_DIR/PROTOCOL.md, $TEAM_DIR/ROSTER.md and $(role_file lead), then $TEAM_DIR/SPEC.md (already approved), $TEAM_DIR/TASKS.md, the reports in $TEAM_DIR/reports/ and $TEAM_DIR/events.log. Tell me in a few lines where things stand and what you will do next, then continue Phase 3 from the current state: never redo merged tasks, and check git for work on task branches that TASKS.md does not show yet."
  fi
  local k; for ((k = 0; k < n; k++)); do [ "${S_NAME[$k]}" = "$LEAD" ] && break; done
  if loads_role "${S_KIND[$k]}"; then
    # the role is in the lead's system prompt: one short line to start it
    lead_msg="Start: ask me what we are building."
    grep -qE '^Status: *APPROVED' "$TEAM_DIR/SPEC.md" 2>/dev/null \
      && lead_msg="Resume after a restart: read SPEC.md (approved), TASKS.md, reports/ and events.log, tell me where things stand, then continue Phase 3."
  fi
  if herdr agent prompt "$LEAD" "$lead_msg" >/dev/null; then
    say "  briefed $LEAD"; mark_briefed "$LEAD"
  else
    say "  could not brief $LEAD (open its pane and check it)"
    failed=1
  fi
  return $failed
}

cmd_brief() {
  require_herdr; find_repo; load_conf; render_team_files; write_herdr_socket; write_roster
  brief || die "some seats were not briefed. Fix them, then run 'squad brief' again."
}

setup_worktree() {
  [ -n "$SETUP_CMD" ] || return 0
  say "  running setup in ${1#"$WT_ROOT"/}"
  ( cd "$1" && eval "$SETUP_CMD" ) || die "the setup command failed in $1"
}

split() { # <pane> <direction> <cwd> [ratio kept by <pane>] -> new pane id
  local ratio=()
  [ -n "${4:-}" ] && ratio=(--ratio "$4")
  herdr pane split "$1" --direction "$2" --cwd "$3" ${ratio[@]+"${ratio[@]}"} --no-focus \
    | jq -er '.result.pane.pane_id' || die "unexpected response from herdr while creating panes."
}

# lay_row <first pane> <direction> <seat index...> — put the seats in equal
# parts along <direction>; the first seat takes <first pane>. Sets PANES[].
lay_row() {
  local pane=$1 dir=$2; shift 2
  local total=$# k=0 i
  for i in "$@"; do
    if [ "$k" -eq 0 ]; then PANES[$i]=$pane
    else
      # keep 1/(remaining) of the space for what is already there
      PANES[$i]=$(split "$pane" "$dir" "$(seat_cwd "$i")" "$(awk -v r="$((total - k + 1))" 'BEGIN { printf "%.3f", 1 / r }')")
      pane=${PANES[$i]}
    fi
    k=$((k + 1))
  done
}

new_tab() { # <workspace> <label> <cwd> -> root pane of the new tab
  herdr tab create --workspace "$1" --label "$2" --cwd "$3" --no-focus \
    | jq -er '.result.root_pane.pane_id' || die "unexpected response from herdr while creating a tab."
}

# The team workspace, layout picked by terminal width (SQUAD_LAYOUT overrides):
#   talk     (default)      tab team: lead 60% | devs, live strip below
#                           tab review: reviewers + tester · tab changes: lazygit
#   mission  (>= 220 cols)  one tab: lead | each dev | reviewers + tester, strip below
#   focus    (< 120 cols)   tabs: lead + strip · devs · review · changes
make_layout() { # <workspace> <tab> <root pane>; sets PANES[] and says the mode
  local ws=$1 tab=$2 root=$3 width height mode i strip p ratio
  local devs=() others=()
  for ((i = 0; i < $(seat_count); i++)); do
    case "${S_ROLE[$i]}" in dev) devs+=("$i") ;; reviewer|tester) others+=("$i") ;; esac
  done
  read -r width height < <(herdr pane layout --pane "$root" | jq -r '.result.layout.area | "\(.width) \(.height)"')
  mode=${SQUAD_LAYOUT:-}
  if [ -z "$mode" ]; then
    if [ "${width:-0}" -ge 220 ]; then mode=mission; elif [ "${width:-0}" -lt 120 ]; then mode=focus; else mode="talk"; fi
  fi
  herdr tab rename "$tab" team >/dev/null 2>&1 || true
  # live strip: 4 rows at the bottom of the first tab
  ratio=$(awk -v h="${height:-40}" 'BEGIN { r = 1 - 5 / h; if (r < 0.75) r = 0.75; if (r > 0.95) r = 0.95; printf "%.3f", r }')
  strip=$(split "$root" down "$WT_ROOT/integration" "$ratio")
  herdr pane rename "$strip" watch >/dev/null 2>&1 || true
  herdr pane run "$strip" "$SQUAD_HOME/bin/squad watch" >/dev/null
  PANES[$LEAD_I]=$root
  case "$mode" in
    mission)
      p=$(split "$root" right "$(seat_cwd "${devs[0]:-$LEAD_I}")" 0.4)
      [ "${#devs[@]}" -gt 0 ] && lay_row "$p" right "${devs[@]}"
      if [ "${#others[@]}" -gt 0 ]; then
        p=$(split "${PANES[${devs[$((${#devs[@]} - 1))]:-$LEAD_I}]}" right "$(seat_cwd "${others[0]}")" 0.5)
        lay_row "$p" down "${others[@]}"
      fi ;;
    focus)
      [ "${#devs[@]}" -gt 0 ] && lay_row "$(new_tab "$ws" devs "$(seat_cwd "${devs[0]}")")" down "${devs[@]}"
      [ "${#others[@]}" -gt 0 ] && lay_row "$(new_tab "$ws" review "$(seat_cwd "${others[0]}")")" down "${others[@]}" ;;
    *)
      mode="talk"
      if [ "${#devs[@]}" -gt 0 ]; then
        p=$(split "$root" right "$(seat_cwd "${devs[0]}")" 0.6)
        lay_row "$p" down "${devs[@]}"
      fi
      [ "${#others[@]}" -gt 0 ] && lay_row "$(new_tab "$ws" review "$(seat_cwd "${others[0]}")")" right "${others[@]}" ;;
  esac
  if command -v lazygit >/dev/null 2>&1; then
    p=$(new_tab "$ws" changes "$WT_ROOT/integration")
    herdr pane rename "$p" changes >/dev/null 2>&1 || true
    herdr pane run "$p" "lazygit" >/dev/null
  fi
  # name every seat's pane now, not when its agent starts: a seat held back
  # (trust dialog) must still be found by its label when 'squad up' resumes
  for ((i = 0; i < $(seat_count); i++)); do
    [ -n "${PANES[$i]:-}" ] && herdr pane rename "${PANES[$i]}" "${S_NAME[$i]}" >/dev/null 2>&1
  done
  say "  layout: $mode (${width:-?} columns; SQUAD_LAYOUT=talk|mission|focus to choose)"
}

# herdr's `agent start` does not wait for the pane's shell: on a shell that is
# still starting (rc files, plugin managers) it fails at once with
# agent_pane_busy. Retry that case for up to a minute; anything else is final.
start_agent() { # <herdr agent start args...>
  local out deadline=$((SECONDS + 60))
  while :; do
    if out=$(herdr agent start "$@" 2>&1); then return 0; fi
    case "$out" in
      *agent_pane_busy*) [ "$SECONDS" -lt "$deadline" ] || { printf '%s\n' "$out" >&2; return 1; }; sleep 1 ;;
      *) printf '%s\n' "$out" >&2; return 1 ;;
    esac
  done
}

# Name the first-run dialog a stuck agent is showing, from its pane's text.
explain_stuck() { # <name> <pane>
  local text; text=$(herdr pane read "$2" 2>/dev/null || true)
  case "$text" in
    *"rust this folder"*|*"o you trust"*|*"afety check"*)
      say "    → it asks whether to trust this folder (first run of this project only)."
      say "      Open pane '$1', choose trust."
      STUCK_ON_TRUST=1 ;;
    *"pdate available"*)
      say "    → Codex wants to update itself before starting. Open pane '$1' and choose Skip."
      say "      To stop this for good: check_for_update_on_startup = false in ~/.codex/config.toml" ;;
    *"ign in"*|*"og in"*|*"login"*)
      say "    → it is not signed in. Open pane '$1' and sign in once." ;;
    *)
      say "    → open pane '$1' and answer what it shows (usually a first-run dialog)." ;;
  esac
}

# Agents whose CLI can load a system prompt at start: their role is loaded
# there (survives /clear and /new, nothing typed into the pane, no READY
# round trip). Others are briefed with a typed message.
loads_role() { case "$1" in claude|codex) return 0 ;; *) return 1 ;; esac; }

write_seat_file() { # <index> -> path of .team/seats/<seat>.md
  local i=$1 f="$TEAM_DIR/seats/${S_NAME[$1]}.md"
  mkdir -p "$TEAM_DIR/seats"
  {
    printf '# You are seat `%s` (role: %s) on an agent team\n\n' "${S_NAME[$i]}" "${S_ROLE[$i]}"
    printf 'This is loaded at start and stays across context clears. Team directory: %s\n\n' "$TEAM_DIR"
    cat "$TEAM_DIR/PROTOCOL.md"; printf '\n\n'
    cat "$(role_file "${S_ROLE[$i]}")"
  } >"$f"
  echo "$f"
}

START_FAILED=0
STUCK_ON_TRUST=0
TRUST_WAIT=" "  # agent kinds held back until one trust dialog is answered
STARTED=()  # seats started or adopted in this run: only these get briefed
start_seat() { # <index> <pane>
  local i=$1 pane=$2 name kind args
  name=${S_NAME[$i]}; kind=${S_KIND[$i]}; args=${S_ARGS[$i]}
  herdr pane rename "$pane" "$name" >/dev/null 2>&1 || true
  # The agent inherits its identity from the shell environment of its pane.
  herdr pane run "$pane" "export TEAM_ROLE='$name' TEAM_DIR='$TEAM_DIR' TEAM_BASE='$TEAM_BASE'; clear" >/dev/null
  # Agent arguments: the seat's own (split on spaces by design), then write
  # access to $TEAM_DIR — it lives outside the seat's worktree, and without it
  # every report, spec or task edit stops on a permission prompt.
  local -a start_args=("$name" --kind "$kind" --pane "$pane" --timeout 90000) agent_args=()
  # shellcheck disable=SC2206  # split on spaces by design
  [ -n "$args" ] && agent_args=($args)
  # …and the repository's git directory: a worktree's commits and merges write
  # there, outside the worktree, so without it every commit asks first.
  case "$kind" in claude|codex) agent_args+=(--add-dir "$TEAM_DIR" --add-dir "$GIT_COMMON") ;; esac
  # the seat's identity, protocol and role as a system prompt
  if loads_role "$kind"; then
    local seat_file; seat_file=$(write_seat_file "$i")
    if [ "$kind" = claude ]; then agent_args+=(--append-system-prompt-file "$seat_file")
    else agent_args+=(-c "developer_instructions=$(jq -Rs . <"$seat_file")"); fi
  fi
  # Codex rejects --add-dir under its read-only default (an untrusted folder)
  # and exits; workspace-write is its normal mode in a trusted project.
  if [ "$kind" = codex ]; then
    case " $args " in *" -s "*|*" --sandbox "*|*" --sandbox="*) ;; *) agent_args+=(-s workspace-write) ;; esac
  fi
  [ "${#agent_args[@]}" -gt 0 ] && start_args+=(-- "${agent_args[@]}")
  if start_agent "${start_args[@]}"; then
    say "  started $name ($kind${args:+ $args})"
    STARTED+=("$name")
  else
    say "  $name did not become ready."
    STUCK_ON_TRUST=0
    explain_stuck "$name" "$pane"
    # Claude and Codex both save trust per repository: one answer covers every
    # seat of that agent, so don't make the human answer the same dialog again
    [ "$STUCK_ON_TRUST" = 1 ] && TRUST_WAIT="$TRUST_WAIT$kind "
    START_FAILED=1
  fi
}

cmd_up() {
  require_herdr; find_repo
  [ -f "$TEAM_DIR/team.conf" ] || cmd_init
  load_conf
  mkdir -p "$TEAM_DIR/reports"
  render_team_files
  write_herdr_socket
  write_roster
  local i n; n=$(seat_count)

  git -C "$REPO" rev-parse --verify -q HEAD >/dev/null \
    || die "the repository has no commits yet. Make a first commit, then run 'squad up'."

  say "Preparing worktrees under $WT_ROOT"
  mkdir -p "$WT_ROOT"
  if [ ! -d "$WT_ROOT/integration" ]; then
    if git -C "$REPO" show-ref --verify --quiet "refs/heads/$TEAM_BASE"; then
      git -C "$REPO" worktree add "$WT_ROOT/integration" "$TEAM_BASE" >/dev/null \
        || die "git could not create the integration worktree (see the error above)."
    else
      git -C "$REPO" worktree add -b "$TEAM_BASE" "$WT_ROOT/integration" HEAD >/dev/null \
        || die "git could not create the integration worktree (see the error above)."
    fi
    setup_worktree "$WT_ROOT/integration"
  fi
  for ((i = 0; i < n; i++)); do
    case "${S_ROLE[$i]}" in dev|tester) ;; *) continue ;; esac
    if [ ! -d "$WT_ROOT/${S_NAME[$i]}" ]; then
      git -C "$REPO" worktree add --detach "$WT_ROOT/${S_NAME[$i]}" "$TEAM_BASE" >/dev/null \
        || die "git could not create the worktree for ${S_NAME[$i]} (see the error above)."
      setup_worktree "$WT_ROOT/${S_NAME[$i]}"
    fi
  done

  # herdr agent names are unique per herdr session (server), not per workspace
  local ws_label agents_json ws_json ws other
  ws_label="$(basename "$REPO") team"
  agents_json=$(herdr agent list) || die "herdr did not answer 'agent list'."
  ws_json=$(herdr workspace list) || die "herdr did not answer 'workspace list'."
  ws=$(jq -r --arg l "$ws_label" '.result.workspaces[] | select(.label == $l) | .workspace_id' <<<"$ws_json" | head -1)
  for ((i = 0; i < n; i++)); do
    other=$(jq -r --arg n "${S_NAME[$i]}" --arg w "$ws" '.result.agents[] | select(.name == $n and .workspace_id != $w) | .pane_id' <<<"$agents_json" | head -1)
    [ -z "$other" ] || die "an agent named '${S_NAME[$i]}' already runs in another workspace of this herdr session (pane $other) — probably another project's team. Run this team in its own session: herdr --session $(basename "$REPO")"
  done

  local lead_i=0 p_lead pane
  for ((i = 0; i < n; i++)); do [ "${S_ROLE[$i]}" = lead ] && lead_i=$i; done
  local PANES=()
  if [ -z "$ws" ]; then
    say "Creating the team workspace"
    # new agents: nobody has been briefed yet
    rm -f "$TEAM_DIR"/.briefed/*
    local created
    created=$(herdr workspace create --cwd "$WT_ROOT/integration" --label "$ws_label" --focus) \
      || die "unexpected response from herdr while creating the workspace."
    p_lead=$(jq -er '.result.root_pane.pane_id' <<<"$created") || die "unexpected response from herdr while creating the workspace."
    ws=$(jq -er '.result.workspace.workspace_id' <<<"$created")
    LEAD_I=$lead_i
    make_layout "$ws" "$(jq -r '.result.tab.tab_id' <<<"$created")" "$p_lead"
  else
    # Resume: panes carry their seat name as label (squad sets it on start).
    say "Resuming the team workspace ($ws)"
    local panes_json
    panes_json=$(herdr pane list --workspace "$ws") || die "herdr did not answer 'pane list'."
    for ((i = 0; i < n; i++)); do
      PANES[$i]=$(jq -r --arg l "${S_NAME[$i]}" '.result.panes[] | select(.label == $l) | .pane_id' <<<"$panes_json" | head -1)
    done
    p_lead=${PANES[$lead_i]:-$(jq -r '.result.panes[0].pane_id' <<<"$panes_json")}
    for ((i = 0; i < n; i++)); do
      [ -z "${PANES[$i]}" ] || continue
      PANES[$i]=$(split "$p_lead" down "$(seat_cwd "$i")")
      say "  added a pane for ${S_NAME[$i]}"
    done
  fi

  say "Starting agents"
  local name detected
  for ((i = 0; i < n; i++)); do
    name=${S_NAME[$i]}; pane=${PANES[$i]}
    if [ -n "$(jq -r --arg n "$name" '.result.agents[] | select(.name == $n) | .pane_id' <<<"$agents_json")" ]; then
      if is_briefed "$name"; then say "  $name already running"
      else say "  $name already running, not briefed yet"; STARTED+=("$name"); fi
      continue
    fi
    # an agent herdr detected in the seat's pane but never named (its start
    # timed out on a first-run dialog that was answered later): adopt it
    detected=$(jq -r --arg p "$pane" '.result.agents[] | select(.pane_id == $p and .name == null) | .agent' <<<"$agents_json" | head -1)
    if [ -n "$detected" ] && herdr agent rename "$pane" "$name" >/dev/null; then
      say "  adopted the running $detected in $name's pane"
      STARTED+=("$name")
      continue
    fi
    case "$TRUST_WAIT" in
      *" ${S_KIND[$i]} "*) say "  $name waits: answer ${S_KIND[$i]}'s trust dialog once (above), it covers this seat too"; START_FAILED=1; continue ;;
    esac
    start_seat "$i" "$pane"
  done

  if [ "$START_FAILED" = 1 ]; then
    say ""
    say "Some agents need attention (see above). Answer them in their panes, then run"
    say "'squad up' again: it keeps what runs and starts only what is missing."
    exit 1
  fi

  if [ "${#STARTED[@]}" -gt 0 ]; then
    say "Briefing agents"
    brief "${STARTED[@]}" || die "some seats were not briefed. Fix them, then run 'squad brief'."
  fi

  say ""
  say "Team is up. Go to the '$LEAD' pane and say what you want built."
  say "It writes .team/SPEC.md and waits for your approval before anyone writes code."
}

# ---- status / clean ----------------------------------------------------------

cmd_status() {
  find_repo; load_conf
  local i n; n=$(seat_count)
  say "Team ($n seats) for $REPO"
  for ((i = 0; i < n; i++)); do
    printf '  %-12s %-9s %-9s %s\n' "${S_NAME[$i]}" "${S_ROLE[$i]}" "${S_KIND[$i]}" "${S_ARGS[$i]}"
  done
  if [ -f "$TEAM_DIR/SPEC.md" ]; then say ""; say "Spec: $(grep -m1 '^Status:' "$TEAM_DIR/SPEC.md" | sed 's/^Status: *//; s/ *<!--.*//' || echo unknown)"; fi
  if [ -f "$TEAM_DIR/TASKS.md" ]; then
    say ""; say "Tasks:"
    # The first table in the file is the status table.
    awk '/^\|/ {print "  " $0; seen=1; next} seen {exit}' "$TEAM_DIR/TASKS.md"
  fi
  if [ "${HERDR_ENV:-}" = 1 ] && command -v herdr >/dev/null 2>&1; then
    local agents_json state
    agents_json=$(herdr agent list 2>/dev/null) || agents_json='{"result":{"agents":[]}}'
    say ""; say "Agents:"
    for ((i = 0; i < n; i++)); do
      state=$(jq -r --arg n "${S_NAME[$i]}" '[.result.agents[] | select(.name == $n) | .agent_status][0] // "not running"' <<<"$agents_json")
      printf '  %-12s %s\n' "${S_NAME[$i]}" "$state"
    done
  fi
}

# squad down — stop the team: close its herdr workspace (and every agent in
# it). Worktrees, branches and .team/ stay; 'squad up' starts it again.
cmd_down() {
  require_herdr; find_repo
  local ws
  ws=$(herdr workspace list | jq -r --arg l "$(basename "$REPO") team" '.result.workspaces[] | select(.label == $l) | .workspace_id' | head -1)
  [ -n "$ws" ] || { say "No team workspace is open."; return 0; }
  herdr workspace close "$ws" >/dev/null || die "herdr could not close workspace $ws."
  rm -f "$TEAM_DIR"/.briefed/*
  say "Team stopped (workspace $ws closed). Worktrees and branches are kept; 'squad clean' removes the worktrees."
}

cmd_clean() {
  find_repo
  [ -d "$WT_ROOT" ] || { say "No team worktrees to remove."; return 0; }
  local wt kept=0
  for wt in "$WT_ROOT"/*/; do
    [ -d "$wt" ] || continue
    wt=${wt%/}
    # No --force: git refuses to remove a worktree with uncommitted changes.
    if git -C "$REPO" worktree remove "$wt" 2>/dev/null; then say "  removed ${wt#"$WT_ROOT"/}"
    else say "  kept    ${wt#"$WT_ROOT"/} (has uncommitted changes, or is not a worktree)"; kept=1; fi
  done
  rmdir "$WT_ROOT" 2>/dev/null || true
  say "Branches were not deleted. Your work is on '$(sed -n 's/^base  *//p' "$TEAM_DIR/team.conf" 2>/dev/null | head -1)' and the task/* branches."
  return $kept
}

# ---- main --------------------------------------------------------------------

cmd=${1:-help}; [ $# -gt 0 ] && shift
case "$cmd" in
  new)     cmd_new "$@" ;;
  init)    cmd_init "$@" ;;
  up)      cmd_up ;;
  brief)   cmd_brief ;;
  status)  cmd_status ;;
  clean)   cmd_clean ;;
  down)    cmd_down ;;
  config)  cmd_config "$@" ;;
  doctor)  cmd_doctor ;;
  presets) cmd_presets ;;
  herdr)   cmd_herdr "$@" ;;
  done)    cmd_done "$@" ;;
  usage)   cmd_usage ;;
  watch)   cmd_watch "$@" ;;
  statusline) cmd_statusline ;;
  git)     cmd_git "$@" ;;
  permissions) cmd_permissions ;;
  -v|--version|version) say "squad $VERSION" ;;
  -h|--help|help) usage ;;
  *) usage >&2; die "unknown command '$cmd'." ;;
esac
