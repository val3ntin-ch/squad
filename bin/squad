#!/usr/bin/env bash
# SPDX-License-Identifier: FSL-1.1-MIT
# squad - run a team of coding agents on a repository, inside herdr.
# https://herdr.dev is the terminal runtime; squad sets up the team on top of it.

set -euo pipefail
VERSION="0.9.2"

# ---- locate our own files (follow symlinks; works on macOS bash 3.2) ---------

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  dir=$(cd -P "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
SQUAD_HOME=$(cd -P "$(dirname "$self")/.." && pwd)
TEMPLATES="$SQUAD_HOME/templates"
PRESETS="${SQUAD_PRESETS:-$SQUAD_HOME/presets}"  # SQUAD_PRESETS: another preset folder (tests)
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/squad/team.conf"

die()  { printf 'squad: %s\n' "$*" >&2; exit 1; }
say()  { printf '%s\n' "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed. $2"; }

usage() {
  cat <<EOF
squad $VERSION - a team of coding agents on your repository, inside herdr

Usage:
  squad new <dir> [--preset NAME]   create a new project with git and a team
  squad init [--preset NAME]        add a team to the current repository
  squad up [--fresh]                start or resume the team in this repository's own herdr session
                                    (from any terminal; --fresh: new conversations, no resume)
  squad brief                       start the lead again (and brief seats that need it)
  squad status                      show seats, agent states and the task table
  squad down                        stop the team (close its herdr workspace)
  squad clean                       remove the team's worktrees (clean ones only)
  squad config [--preset NAME]      create or show your personal default team
  squad update-conf                 add the settings and seats a new squad version needs to
                                    .team/team.conf (squad up and init do it; 'upgrade off' stops it)
  squad doctor                      check that everything needed is installed
  squad presets                     list the built-in team presets
  squad permissions                 once per machine: Claude's usage status line
  squad herdr <args>                herdr, bound to this team's session (used by agents)
  squad watch [--observe]           live board: usage, tasks, seats and their trouble (team tab);
                                    --observe also starts the observer's passes (observer tab)
  squad report [--live|--open]      the report page: decisions, observer, timeline, QA, cost
                                    (.team/report.html; --live is the report tab)
  squad usage                       one line of plan usage
  squad statusline                  Claude Code status line: shows and records Claude's usage
  squad done <seat> <task> <status> a worker tells the lead it finished (used by agents)
  squad git <args>                  git writes for agents (switch/add/commit/merge...; push only the integration branch; no force/delete)
  squad heavy <seat> [task] [--limit min] [--batch file] -- cmd   run a heavy command: one at a time,
                                    first come first served (agents); --batch: a candidate's commands under one lock
  squad dispatch <seat> <task>      clear a seat, give it the task, confirm it started (the lead)
  squad candidate CANDIDATE-<n> <task...>  build a candidate from the lead's approved task commits (the lead)
  squad merge CANDIDATE-<n>         the tested candidate becomes the integration branch, exactly (the lead)
  squad notify "<where>" "<rule>"   tell the seats at work that a rule changed (the lead)
  squad consult "<question>" [f..]  an independent GPT brainstorm from official sources (the lead)
  squad plan "<goal>" [--feature]   the planner researches and proves the plan before any work
  squad timed <seconds> -- <cmd>    run a command and stop it after the seconds (a viewer or screenshot script)
  squad plan --check|--critique|--approve [F-n]   check it, let GPT critique it, approve it (the owner only)
  squad decisions [--check]         list the decisions; --check: every field filled
  squad feedback "<text>"           your feedback after testing what can be seen: saved, logged, sent to the lead
  squad wait-owner "<what>"|--done  the team waits for you: you are told now and reminded; --done ends the wait (the lead)
  squad seen <task>                 a task's pending notices need no action: they are not sent again (the lead)

A team is defined in .team/team.conf. 'squad init' copies your personal
default ($USER_CONF) if it exists, otherwise the
'default' preset. Edit the file to change seats, agents or models.
EOF
}

# ---- repository --------------------------------------------------------------

REPO="" TEAM_DIR="" WT_ROOT="" GIT_COMMON=""
find_repo() {
  need git ""
  git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository. Use 'squad new <dir>' to start a project."
  # The main checkout, even when called from one of the team's worktrees.
  REPO=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
  [ -n "$REPO" ] || die "could not find the repository root."
  TEAM_DIR="$REPO/.team"
  WT_ROOT="${REPO}-team"
  GIT_COMMON=$(cd "$REPO" && git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || GIT_COMMON="$REPO/.git"  # git < 2.31
}

# ---- team.conf ---------------------------------------------------------------

S_NAME=() S_KIND=() S_ROLE=() S_REVIEWS=() S_ARGS=()
TEAM_BASE="team/integration"
SETUP_CMD=""
REVIEW_ROUNDS=5
LEAD=""
HEAVY_TIMEOUT=20        # minutes a heavy run may hold the lock
HEAVY_TIMEOUT_DEV=""    # minutes for a dev seat's run (default: heavy_timeout)
SAMPLE_PERCENT=10       # squad heavy --sample: the share of the tests one dev run takes
HEAVY_SILENT_MINUTES=5  # a heavy run with no new output and no CPU for this long is hung (0: off)
IDLE_MINUTES=5          # a dev idle with no task for this long: the lead is told once (0: off)
IDLE_OWNER_MINUTES=30   # still no task after this long, with tasks open: the owner gets one notification
OWNER_MODE=all          # visual: the human tests what can be seen and gives feedback; the lead decides the rest
VERIFY_HOOK=on          # off: team worktrees get .agents-verify-off (the owner's global Stop hook skips them)
STALL_MINUTES=15        # a seat with an open task and no work for this long is stalled
OBSERVE_MINUTES=20      # the longest gap between two observer passes
ESCALATE_MODEL=""       # model for a fix round from round 4 on (claude seats)
OBSERVER_DEEP_MODEL=""  # model for an observer pass that found a large loss
OWNER_NAME="the owner"  # team.conf "owner_name <name>": how the agents and messages name the human who owns the project
LIMIT_FALLBACK=""       # team.conf "limit_fallback <model>": a Claude seat at its usage limit switches to it (the owner's choice)
STALL_ALERT_MINUTES=30  # team.conf "stall_alert_minutes": no event this long while work waits for the lead: tell the owner
NOTICE_REDELIVER_MINUTES=15  # team.conf "notice_redeliver_minutes": a notice the lead has not acted on is sent to it again this often
NOTICE_OWNER_MINUTES=30      # team.conf "notice_owner_minutes": a notice the lead has not acted on for this long: tell the owner once
OWNER_REMINDER_HOURS=4       # team.conf "owner_reminder_hours": squad wait-owner reminds the owner this often
NOTIFY_OS=on                 # team.conf "notify_os off": only herdr's notification, none from the operating system
SEAT_RESTART=off             # team.conf "seat_restart on": squad watch starts a seat again that is gone or runs without its squad options; off: it only tells the owner
CONSULT_CMD="codex --search exec -m gpt-6.1-sol -c model_reasoning_effort=medium"
SESSION_NAME=""         # herdr session of this team (default: the repository's name)

load_conf() {
  local conf="$TEAM_DIR/team.conf" kw name kind role reviews rest n=0 line_no=0
  [ -f "$conf" ] || die "$conf not found. Run 'squad init' first."
  S_NAME=() S_KIND=() S_ROLE=() S_REVIEWS=() S_ARGS=()
  while IFS= read -r line || [ -n "$line" ]; do
    line_no=$((line_no + 1))
    line=${line%%#*}
    read -r kw rest <<<"$line" || true
    case "${kw:-}" in
      "") continue ;;
      base)  [ -n "$rest" ] && TEAM_BASE=$rest ;;
      setup) SETUP_CMD=$rest ;;
      rounds) [[ "$rest" =~ ^[1-9][0-9]?$ ]] || die "team.conf line $line_no: 'rounds' needs a number from 1 to 99."
              REVIEW_ROUNDS=$rest ;;
      heavy_silent_minutes|idle_minutes)
              [[ "$rest" =~ ^[0-9]{1,3}$ ]] || die "team.conf line $line_no: '$kw' needs a number of minutes (0 to 999; 0 turns it off)."
              rest=$((10#$rest))   # decimal: a leading 0 must not make it octal
              if [ "$kw" = heavy_silent_minutes ]; then HEAVY_SILENT_MINUTES=$rest; else IDLE_MINUTES=$rest; fi ;;
      heavy_timeout|heavy_timeout_dev|stall_minutes|observe_minutes)
              [[ "$rest" =~ ^[1-9][0-9]{0,2}$ ]] || die "team.conf line $line_no: '$kw' needs a number of minutes (1 to 999)."
              rest=$((10#$rest))
              case "$kw" in heavy_timeout) HEAVY_TIMEOUT=$rest ;; heavy_timeout_dev) HEAVY_TIMEOUT_DEV=$rest ;; stall_minutes) STALL_MINUTES=$rest ;; *) OBSERVE_MINUTES=$rest ;; esac ;;
      verify_hook) case "$rest" in on|off) VERIFY_HOOK=$rest ;; *) die "team.conf line $line_no: 'verify_hook' is on or off." ;; esac ;;
      name|notify|step) ;;   # Squad Deck lines (reverted 16 Nov 2026): a team.conf that has them still loads
      # read by update_conf from the file itself; here it is only checked
      upgrade) case "$rest" in on|off) ;; *) die "team.conf line $line_no: 'upgrade' is on or off." ;; esac ;;
      owner) case "$rest" in visual|all) OWNER_MODE=$rest ;; *) die "team.conf line $line_no: 'owner' is visual or all." ;; esac ;;
      sample_percent) [[ "$rest" =~ ^[1-9][0-9]?$ ]] || die "team.conf line $line_no: 'sample_percent' is a number from 1 to 99."
                      SAMPLE_PERCENT=$rest ;;
      escalate_model) ESCALATE_MODEL=$rest ;;
      observer_deep_model) OBSERVER_DEEP_MODEL=$rest ;;
      owner_name) [ -n "$rest" ] || die "team.conf line $line_no: 'owner_name' needs a name."; OWNER_NAME=$rest ;;
      limit_fallback) LIMIT_FALLBACK=$rest ;;
      stall_alert_minutes) [[ "$rest" =~ ^[1-9][0-9]{0,2}$ ]] || die "team.conf line $line_no: 'stall_alert_minutes' needs minutes (1 to 999)."; STALL_ALERT_MINUTES=$((10#$rest)) ;;
      notice_redeliver_minutes|notice_owner_minutes|owner_reminder_hours)
              [[ "$rest" =~ ^[1-9][0-9]{0,2}$ ]] || die "team.conf line $line_no: '$kw' needs a number (1 to 999)."
              rest=$((10#$rest))
              case "$kw" in notice_redeliver_minutes) NOTICE_REDELIVER_MINUTES=$rest ;; notice_owner_minutes) NOTICE_OWNER_MINUTES=$rest ;; *) OWNER_REMINDER_HOURS=$rest ;; esac ;;
      notify_os) case "$rest" in on|off) NOTIFY_OS=$rest ;; *) die "team.conf line $line_no: 'notify_os' is on or off." ;; esac ;;
      seat_restart) case "$rest" in on|off) SEAT_RESTART=$rest ;; *) die "team.conf line $line_no: 'seat_restart' is on or off." ;; esac ;;
      consult) [ -n "$rest" ] || die "team.conf line $line_no: 'consult' needs a command, e.g. consult codex --search exec -m gpt-6.1-sol"
               CONSULT_CMD=$rest ;;
      session) [[ "$rest" =~ ^[A-Za-z0-9._-]+$ ]] || die "team.conf line $line_no: 'session' is a herdr session name (letters, digits, . _ -)."
               SESSION_NAME=$rest ;;
      seat)
        read -r name kind role reviews rest <<<"$rest" || true
        [ -n "${role:-}" ] || die "team.conf line $line_no: expected 'seat <name> <agent> <role> <reviews> [args]'."
        [[ "$name" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "team.conf line $line_no: seat name '$name' must be lowercase letters, digits, - or _."
        case "$role" in lead|dev|reviewer|tester|observer|planner|critic) ;; *) die "team.conf line $line_no: role '$role' must be lead, dev, reviewer, tester, observer, planner or critic." ;; esac
        local i
        for ((i = 0; i < n; i++)); do
          [ "${S_NAME[$i]}" != "$name" ] || die "team.conf line $line_no: seat '$name' is defined twice."
        done
        S_NAME[$n]=$name; S_KIND[$n]=$kind; S_ROLE[$n]=$role
        S_REVIEWS[$n]=${reviews:--}; S_ARGS[$n]=${rest:-}
        n=$((n + 1)) ;;
      *) die "team.conf line $line_no: unknown keyword '$kw'." ;;
    esac
  done <"$conf"

  local leads=0 i
  for ((i = 0; i < n; i++)); do
    if [ "${S_ROLE[$i]}" = lead ]; then leads=$((leads + 1)); LEAD=${S_NAME[$i]}; fi
  done
  [ "$leads" = 1 ] || die "team.conf must define exactly one seat with the role 'lead' (found $leads)."
  [ -n "$SESSION_NAME" ] || SESSION_NAME=$(basename "$REPO" | tr -c 'A-Za-z0-9._\n-' '-')

  # Every name a reviewer points at must be a dev.
  local r target found j
  for ((i = 0; i < n; i++)); do
    [ "${S_ROLE[$i]}" = reviewer ] || continue
    r=${S_REVIEWS[$i]}
    [ "$r" != "-" ] || die "team.conf: reviewer '${S_NAME[$i]}' must name the dev(s) it reviews."
    IFS=, read -r -a _targets <<<"$r"
    for target in "${_targets[@]}"; do
      found=0
      for ((j = 0; j < n; j++)); do
        if [ "${S_NAME[$j]}" = "$target" ] && [ "${S_ROLE[$j]}" = dev ]; then found=1; fi
      done
      [ "$found" = 1 ] || die "team.conf: reviewer '${S_NAME[$i]}' reviews '$target', which is not a dev seat."
    done
  done
}

seat_count() { echo "${#S_NAME[@]}"; }

role_file() { # role -> path
  case "$1" in
    lead) echo "$TEAM_DIR/roles/lead.md" ;;
    dev) echo "$TEAM_DIR/roles/dev.md" ;;
    reviewer) echo "$TEAM_DIR/roles/reviewer.md" ;;
    tester) echo "$TEAM_DIR/roles/tester.md" ;;
    observer) echo "$TEAM_DIR/roles/observer.md" ;;
    planner) echo "$TEAM_DIR/roles/planner.md" ;;
    critic) echo "$TEAM_DIR/roles/critic.md" ;;
  esac
}

first_role() { local i n; n=$(seat_count); for ((i = 0; i < n; i++)); do [ "${S_ROLE[$i]}" = "$1" ] && { echo "${S_NAME[$i]}"; return 0; }; done; return 0; }   # <role> -> its first seat, or nothing

seat_index() { # name -> index, or fail
  local i n; n=$(seat_count)
  for ((i = 0; i < n; i++)); do [ "${S_NAME[$i]}" = "$1" ] && { echo "$i"; return 0; }; done
  return 1
}

seat_cwd() { # index -> working directory
  case "${S_ROLE[$1]}" in
    lead|reviewer|observer|planner|critic) echo "$WT_ROOT/integration" ;;
    *) echo "$WT_ROOT/${S_NAME[$1]}" ;;
  esac
}

clear_cmd() { # agent kind -> command that resets its conversation
  case "$1" in
    claude) echo "/clear" ;;
    codex|opencode) echo "/new" ;;
    *) echo "-" ;;
  esac
}

write_roster() {
  local i n; n=$(seat_count)
  {
    echo "# Roster"
    echo
    echo "Generated by squad from team.conf on every start. Do not edit; change team.conf instead."
    echo
    echo "| Seat | Role | Agent | Arguments | Reviews | Clear |"
    echo "|---|---|---|---|---|---|"
    for ((i = 0; i < n; i++)); do
      printf '| `%s` | %s | %s | %s | %s | `%s` |\n' \
        "${S_NAME[$i]}" "${S_ROLE[$i]}" "${S_KIND[$i]}" "${S_ARGS[$i]:--}" \
        "${S_REVIEWS[$i]}" "$(clear_cmd "${S_KIND[$i]}")"
    done
    echo
    echo "\"Reviews\" is the dev whose tasks that reviewer checks. \"Clear\" is the command"
    echo "to send a seat, as a prompt of its own, to reset its context between tasks"
    echo "(\"-\" means none is known for that agent; leave its context alone)."
  } >"$TEAM_DIR/ROSTER.md"
}

# ---- init / new / config -----------------------------------------------------

preset_path() {
  [ -f "$PRESETS/$1.conf" ] || die "no preset named '$1'. Run 'squad presets' to list them."
  echo "$PRESETS/$1.conf"
}

parse_preset_flag() { # sets PRESET from "--preset NAME" in "$@"
  PRESET=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --preset) [ $# -ge 2 ] || die "--preset needs a name."; PRESET=$2; shift 2 ;;
      --preset=*) PRESET=${1#--preset=}; shift ;;
      *) die "unknown option '$1'." ;;
    esac
  done
}

copy_if_missing() { # src dst
  if [ -e "$2" ]; then say "  kept     ${2#"$REPO"/}"; else cp "$1" "$2"; say "  created  ${2#"$REPO"/}"; fi
}

# Agents can't rely on their environment: Codex runs commands through a shared
# daemon that keeps the environment of whichever pane started it first (seen:
# another herdr server's socket and pane). So squad writes the real values into
# the files agents read, and gives them a herdr wrapper bound to this team's
# session.
# Literal replacement with awk (values through the environment, so no escape
# processing): bash 3.2's ${text//…} takes minutes on the larger templates.
subst() { # <file> NAME=VALUE... : print <file> with each {{NAME}}-style key replaced; keys and values in SUBST_* env
  awk '
    function rep(s, from, to,   out, i) { out = ""; while ((i = index(s, from)) > 0) { out = out substr(s, 1, i - 1) to; s = substr(s, i + length(from)) } return out s }
    BEGIN { n = ENVIRON["SUBST_N"] + 0; for (k = 1; k <= n; k++) { from[k] = ENVIRON["SUBST_F" k]; to[k] = ENVIRON["SUBST_T" k] } }
    { l = $0; for (k = 1; k <= n; k++) l = rep(l, from[k], to[k]); print l }' "$1"
}

owner_filter() { # keep the <!-- owner:MODE --> sections of this team's owner mode, drop the others and the markers;
  # sections do not nest, and every one is closed by its own marker: anything else is a template error
  awk -v m="$OWNER_MODE" '
    function bad(msg) { printf "squad: template error, line %d: %s\n", NR, msg > "/dev/stderr"; err = 1; exit 1 }
    /^<!-- owner:[a-z]+ -->$/ { if (sec != "") bad("an owner section opens inside another"); sec = $0; sub(/^<!-- owner:/, "", sec); sub(/ -->$/, "", sec); next }
    /^<!-- \/owner:[a-z]+ -->$/ { c = $0; sub(/^<!-- \/owner:/, "", c); sub(/ -->$/, "", c); if (c != sec) bad("closes owner:" c " but owner:" sec " is open"); sec = ""; next }
    /<!-- \/?owner:/ { bad("an owner marker must be alone on its line") }
    sec == "" || sec == m { print }
    END { if (!err && sec != "") bad("owner:" sec " is never closed") }'
}

render() { # <template> <dest>
  local sq="$SQUAD_HOME/bin/squad" k=0 sub
  local -a pairs=(
    "\$TEAM_DIR" "$TEAM_DIR"  "\$TEAM_BASE" "$TEAM_BASE"  "\$REVIEW_ROUNDS" "$REVIEW_ROUNDS"
    "\$HEAVY_TIMEOUT" "$HEAVY_TIMEOUT"  "\$STALL_MINUTES" "$STALL_MINUTES"  "\$OWNER" "$OWNER_NAME"
    "herdr agent " "$sq herdr agent ")
  # every squad command an agent runs: the absolute path, so one permission rule covers it
  for sub in "done" heavy dispatch merge consult notify decisions report wait-owner seen; do pairs+=("squad $sub " "$sq $sub "); done
  for sub in switch add commit merge rebase restore stash; do pairs+=("git $sub " "$sq git $sub "); done
  (
    while [ "$k" -lt "${#pairs[@]}" ]; do
      export "SUBST_F$((k / 2 + 1))=${pairs[$k]}" "SUBST_T$((k / 2 + 1))=${pairs[$((k + 1))]}"
      k=$((k + 2))
    done
    export SUBST_N=$((k / 2))
    subst "$1" | owner_filter >"$2"
  )
}

render_team_files() {
  local f
  mkdir -p "$TEAM_DIR/roles" "$TEAM_DIR/tasks"
  render "$TEMPLATES/PROTOCOL.md" "$TEAM_DIR/PROTOCOL.md"
  render "$TEMPLATES/TASK.md" "$TEAM_DIR/tasks/_TEMPLATE.md"
  for f in "$TEMPLATES"/roles/*.md; do render "$f" "$TEAM_DIR/roles/$(basename "$f")"; done
}

write_herdr_socket() { # remember the herdr session squad runs in, for 'squad herdr'
  printf '%s\n' "${HERDR_SOCKET_PATH:-}" >"$TEAM_DIR/herdr.sock"
}

# ---- the ledger ----------------------------------------------------------------
# .team/events.log: one line per event, read by the lead after a restart, by the
# observer and by 'squad report'. Format:
#   YYYY-MM-DD HH:MM:SS <seat> <task or -> <EVENT> [detail...]
# Older teams wrote "HH:MM:SS <seat> <task> <status>"; the readers accept both.
valid_task() { # task ids reach file names, git branches and the report
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "task id '$1' must be letters, digits, '.', '_' or '-' (for example T-001)."
}

log_event() { # <seat> <task> <EVENT> [detail...]
  local seat=$1 task=$2 ev=$3; shift 3
  mkdir -p "$TEAM_DIR"
  local d="$*"; d=${d//$'\n'/ }; d=${d//$'\r'/ }   # one event is one line: a text cannot add a forged event
  printf '%s %s %s %s%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$seat" "${task:--}" "$ev" "${d:+ $d}" >>"$TEAM_DIR/events.log"
}

usage_tag() { # "u=<Claude 5h %>/<7d %> c=<Codex 5h %>/<7d %>" for cost lines (each only when known)
  local json out=""
  json=$(usage_claude)
  [ -z "$json" ] || out=$(jq -r '"u=\(.p5 // "?" | tostring | split(".")[0])/\(.p7 // "?" | tostring | split(".")[0])"' <<<"$json" 2>/dev/null || true)
  json=$(usage_codex)
  [ -z "$json" ] || out="$out${out:+ }$(jq -r '"c=\(.p5 // "?" | tostring | split(".")[0])/\(.p7 // "?" | tostring | split(".")[0])"' <<<"$json" 2>/dev/null || true)"
  printf '%s' "$out"
}

seat_state() { # <agents json> <name> -> herdr agent_status, or "off"
  jq -r --arg n "$2" '[.result.agents[] | select(.name == $n) | .agent_status][0] // "off"' <<<"$1"
}

# ---- squad heavy: one heavy run at a time on this machine --------------------
# squad heavy <seat> [<task>] -- <command...>
# First come, first served (a queue file per waiter, sorted by arrival); the lock
# names its owner; a run over heavy_timeout minutes is stopped; a lock or queue
# entry whose process is gone is cleared by the next caller.
HEAVY_POLL=${SQUAD_HEAVY_POLL:-5}
# One lock for the whole machine: every team on this computer shares it (two teams' full
# suites at once make both slow and turn slow tests into false failures).
HEAVY_DIR=${SQUAD_HEAVY_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/squad/heavy}

kill_tree() { # <pid> [signal]: the process and everything it started
  local c sig=${2:-TERM}
  for c in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$c" "$sig"; done
  kill "-$sig" "$1" 2>/dev/null || true
}

proc_start() { [ -n "${1:-}" ] || return 0; { ps -o lstart= -p "$1" 2>/dev/null || true; } | tr -s ' ' | sed 's/^ //; s/ $//'; }

group_alive() { pgrep -g "$1" >/dev/null 2>&1; }

stop_tree() { # <pid>: the run's process group (and any child that left it): TERM, up to 10 s, then KILL
  local k=0
  kill -TERM -- "-$1" 2>/dev/null || true
  kill_tree "$1" TERM
  while { kill -0 "$1" 2>/dev/null || group_alive "$1"; } && [ "$k" -lt "${SQUAD_STOP_GRACE:-10}" ]; do sleep 1; k=$((k + 1)); done
  if kill -0 "$1" 2>/dev/null || group_alive "$1"; then kill -KILL -- "-$1" 2>/dev/null || true; kill_tree "$1" KILL; fi
  wait "$1" 2>/dev/null || true
}

# run_in_group <dir> <command...> &: the command in its own process group (pgid = its pid),
# so a stop reaches every process it started (Bazel: the runner owns the group).
# macOS has no setsid; perl ships with it. Without perl: no group, the tree stop still works.
run_in_group() {
  local dir=$1; shift
  cd "$dir" || exit 1
  if command -v perl >/dev/null 2>&1; then
    exec perl -e 'setpgrp(0, 0) or die "setpgrp: $!\n"; exec { $ARGV[0] } @ARGV or die "squad heavy: cannot run $ARGV[0]: $!\n"' -- "$@"
  fi
  exec "$@"
}

# The lock is a symbolic link whose target is "<seat>:<pid>:<epoch>": ln -s
# creates it and names its owner in one atomic step, and fails if it exists.
mutex() { # <dir>: a short critical section; a mutex older than a minute is left over from a crash
  # bounded (about 2 min, past the 1-min stale rule): a folder that cannot be written fails, never hangs
  local m=$1 tries=0 max=${SQUAD_MUTEX_TRIES:-600}
  until mkdir "$m" 2>/dev/null; do
    [ -z "$(find "$m" -maxdepth 0 -mmin +1 2>/dev/null)" ] || rmdir "$m" 2>/dev/null || true
    tries=$((tries + 1))
    [ "$tries" -lt "$max" ] || die "cannot create the lock $m (is its folder writable?)."
    sleep 0.2
  done
}

heavy_owner() { readlink "$HEAVY_DIR/lock" 2>/dev/null || true; }

# A seat is busy, whatever state herdr shows (ticket 024): its own heavy run is alive (a fresh
# heartbeat, or it owns the lock), it waits in the heavy queue, or its last turn ended with
# background work still running (the Stop hook: squad seat-hook Stop). A busy seat gets no dispatch
# and no STALLED or IDLE alarm.
BUSY_HOOK_MINUTES=60   # the hook's reading counts this long: a seat that ends no further turn is not busy for ever
seat_busy() { # <seat>
  local name=$1 me now hb ow f p bg at
  me="$name@$(basename "$REPO")"; now=$(date +%s)
  hb=$(cat "$TEAM_DIR/seats/$name.heartbeat" 2>/dev/null || echo 0)
  [ $((now - ${hb:-0})) -lt 180 ] && return 0
  ow=$(heavy_owner)
  case "$ow" in "$me:"*) p=$(printf '%s' "$ow" | cut -d: -f2); kill -0 "$p" 2>/dev/null && return 0 ;; esac
  for f in "$HEAVY_DIR"/queue/*; do   # <arrival>-<pid>-<seat>@<repo>, written by squad heavy while it waits
    [ -f "$f" ] && [ "$(basename "$f" | cut -d- -f3-)" = "$me" ] || continue
    p=$(basename "$f" | cut -d- -f2); kill -0 "$p" 2>/dev/null && return 0
  done
  [ -f "$TEAM_DIR/seats/$name.background" ] || return 1
  read -r bg at <"$TEAM_DIR/seats/$name.background" || true
  [[ "${bg:-}" =~ ^[1-9][0-9]*$ ]] && [[ "${at:-}" =~ ^[0-9]+$ ]] && [ $((now - at)) -lt $((BUSY_HOOK_MINUTES * 60)) ] || return 1
  # only while its task is open: a process the seat keeps alive after its report (a dev server) does not hold its next dispatch
  [ -n "$(open_tasks | awk -v s="$name" '$1 == s')" ]
}

heavy_clear_stale() {
  local q="$HEAVY_DIR/queue" f pid val seat since
  for f in "$q"/*; do
    [ -f "$f" ] || continue
    pid=$(basename "$f" | cut -d- -f2)
    kill -0 "$pid" 2>/dev/null || rm -f "$f"
  done
  val=$(heavy_owner)
  [ -n "$val" ] || return 0
  local lim
  IFS=: read -r seat pid since lim <<<"$val"
  [ -n "$lim" ] || lim=$((HEAVY_TIMEOUT * 60))
  if ! kill -0 "$pid" 2>/dev/null || [ $(( $(date +%s) - ${since:-0} )) -gt $(( lim + 300 )) ]; then
    mutex "$HEAVY_DIR/clean"
    # still the same stale owner? (another caller may have cleared it and a new run taken the lock)
    if [ "$(heavy_owner)" = "$val" ]; then
      # the owner is gone, its run may not be: end the run's group before the lock is free
      # the group, only if its leader is the same process (a pid can be reused after a reboot or a long time)
      local pg="" pgstart=""
      read -r pg pgstart <"$HEAVY_DIR/lock.pgid" 2>/dev/null || true
      # a leader that is gone leaves its group id reserved while members live; a living leader
      # with another start time is a reused pid
      local st; st=$(proc_start "$pg")
      [ -z "$pg" ] || [ -z "$st" ] || [ "$st" = "$pgstart" ] || pg=""
      # an owner that is still alive learns that its run was stopped: it never reports a pass
      : >"$HEAVY_DIR/stopped.$pid"
      if [ -n "$pg" ] && group_alive "$pg"; then stop_group "$pg"; fi
      rm -f "$HEAVY_DIR/lock" "$HEAVY_DIR/lock.cmd" "$HEAVY_DIR/lock.pgid"
      log_event "$seat" - HEAVY_STALE "lock cleared: owner process gone or over time"
    fi
    rmdir "$HEAVY_DIR/clean" 2>/dev/null || true
  fi
}

fmt_hm() { date -r "$1" '+%H:%M' 2>/dev/null || date -d "@$1" '+%H:%M' 2>/dev/null || echo "?"; }

heavy_status() {
  local val seat pid since f names=""
  val=$(heavy_owner)
  if [ -n "$val" ]; then
    IFS=: read -r seat pid since _ <<<"$val"
    echo "lock: $seat since $(fmt_hm "$since"): $(cat "$HEAVY_DIR/lock.cmd" 2>/dev/null || true)"
  else
    echo "lock: free"
  fi
  for f in "$HEAVY_DIR"/queue/*; do [ -f "$f" ] && names="$names $(basename "$f" | cut -d- -f3-)"; done
  [ -z "$names" ] || echo "queue:$names"
}

heavy_ticket() { # -> the next arrival number (a counter under a mutex: callers in the same second keep their order)
  local n
  mutex "$HEAVY_DIR/seq.lock"
  n=$(( $(cat "$HEAVY_DIR/seq" 2>/dev/null || echo 0) + 1 ))
  echo "$n" >"$HEAVY_DIR/seq"
  rmdir "$HEAVY_DIR/seq.lock"
  printf '%012d' "$n"
}

cmd_heavy() {
  find_repo; load_conf
  [ "${1:-}" = --status ] && { heavy_status; return 0; }
  local usage="usage: squad heavy <seat> [<task>] [--sample] [--limit <minutes>] [--batch <file>] -- <command...>"
  local seat=${1:-} task=- sample=0 limit_opt="" batch=""; [ $# -gt 0 ] && shift
  [ -n "$seat" ] && [ "$seat" != -- ] || die "$usage"
  while [ $# -gt 0 ] && [ "$1" != -- ]; do
    case "$1" in
      --sample) sample=1 ;;
      --limit) shift; [[ "${1:-}" =~ ^[1-9][0-9]?$ ]] || die "--limit takes minutes (1 to 99)."; limit_opt=$1 ;;
      --batch) shift; [ -f "${1:-}" ] || die "--batch takes a file of commands, one a line."; batch=$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1") ;;
      -*) die "$usage" ;;
      *) [ "$task" = - ] || die "$usage"; valid_task "$1"; task=$1 ;;
    esac
    shift
  done
  # a batch: the commands of one candidate under one lock, one after the other (observer S-44)
  local -a batchv=(); local bsnap=""
  if [ -n "$batch" ]; then
    bsnap="$TEAM_DIR/heavy/checks.$$"; mkdir -p "$TEAM_DIR/heavy"; cp "$batch" "$bsnap" || die "cannot read $batch."   # one snapshot: what runs is what is hashed
    local bl; while IFS= read -r bl; do batchv+=("$bl"); done < <(check_lines "$bsnap")
    [ "${#batchv[@]}" -gt 0 ] || die "--batch: $batch has no command."
    [ "$sample" = 0 ] || die "--sample and --batch do not go together: a candidate runs everything."
    [ "${1:-}" != -- ] || die "--batch takes its commands from the file, not after --."
    set -- bash -c "${batchv[0]}"
  else
    [ "${1:-}" = -- ] || die "$usage"
    shift; [ $# -gt 0 ] || die "squad heavy: no command after --"
  fi
  local si wt sha dirty minutes run_dir="" shard="" a
  local -a cmdv=()
  si=$(seat_index "$seat") || die "no seat named '$seat' in this team."
  minutes=$HEAVY_TIMEOUT
  wt=$(seat_cwd "$si")
  if [ "${S_ROLE[$si]}" = dev ]; then
    [ -z "$HEAVY_TIMEOUT_DEV" ] || minutes=$HEAVY_TIMEOUT_DEV
    [ -z "$limit_opt" ] || die "--limit is for the tester's candidate runs; a dev's run keeps heavy_timeout_dev."
    # a run proves a commit: nothing uncommitted (a killed run must not leave an edit behind)
    git -C "$wt" rev-parse --verify -q HEAD >/dev/null 2>&1 || die "$seat's worktree ($wt) is missing or has no commit: run 'squad up' first."
    dirty=$(git -C "$wt" status --porcelain | grep -v ' \.agents-verify-off$' || true)
    if [ -n "$dirty" ]; then
      printf '%s\n' "$dirty" | head -10 >&2
      die "commit first: $seat's worktree has uncommitted changes (above). A WIP commit is fine; a diagnostic variant is a commit or a separate test file, never an edit inside the run."
    fi
  fi
  local crec="" full
  if [ "${S_ROLE[$si]}" = tester ]; then
    case "$task" in CANDIDATE-*) [ -f "$TEAM_DIR/candidates/$task" ] && crec="$TEAM_DIR/candidates/$task" ;; esac
  fi
  local cbuild="" cchecks="" csha=""
  if [ -n "$crec" ]; then   # a built candidate: its own commit and check list, as recorded now (checked out under the lock)
    cbuild=$(plan_hash "$crec"); csha=$(sed -n 's/^sha=//p' "$crec"); cchecks=$(plan_hash "$bsnap" 2>/dev/null || true)
    [ -n "$batch" ] && [ "$cchecks" = "$(sed -n 's/^checks=//p' "$crec")" ] \
      || die "$task runs its check list: --batch $TEAM_DIR/tasks/$task.checks (unchanged since 'squad candidate')."
    run_dir=$(cd "$wt" && pwd -P)
  fi
  full=$(git -C "$wt" rev-parse HEAD 2>/dev/null || echo "?"); sha=${full:0:7}   # one lookup: the snapshot and the event name the same commit

  # --sample: one deterministic share of the tests (Anthropic's --fast: "deterministic per-agent");
  # {shard} goes where the runner takes it, e.g. vitest run --shard={shard}
  if [ "$sample" = 1 ]; then
    # ceiling: one shard is never more than sample_percent of the tests
    local n=$(( (100 + SAMPLE_PERCENT - 1) / SAMPLE_PERCENT )) k
    [ "$n" -ge 1 ] || n=1
    k=$(( $(printf '%s:%s' "$seat" "$task" | cksum | cut -d' ' -f1) % n + 1 ))
    shard="$k/$n"
  fi
  for a in "$@"; do
    case "$a" in *"{shard}"*) [ -n "$shard" ] || die "{shard} is only for --sample runs."; a=${a//"{shard}"/$shard} ;; esac
    cmdv+=("$a")
  done
  if [ -n "$shard" ] && [ "${cmdv[*]}" = "$*" ]; then
    die "--sample needs {shard} where the test runner takes its shard, e.g. -- npx vitest run --shard={shard} (vitest, jest and playwright take --shard=k/n)."
  fi

  [ -z "$limit_opt" ] || minutes=$limit_opt   # a longer step of a candidate (observer S-31)
  [ -n "$crec" ] || run_dir=$(pwd -P)
  # the log names the commit the command really sees: the folder it runs in (a dev's snapshot is made from its own worktree)

  local snap_name="" limit=${SQUAD_HEAVY_LIMIT_SECONDS:-$((minutes * 60))}  # seconds override: tests
  local nsteps=1; [ -z "$batch" ] || nsteps=${#batchv[@]}

  local q="$HEAVY_DIR/queue" waited=0 start rc
  mkdir -p "$q" "$TEAM_DIR/heavy"
  HV_LOCK="$HEAVY_DIR/lock"
  # arrival order; the pid in the name lets the next caller clear a dead waiter
  HV_ME="$q/$(heavy_ticket)-$$-$seat@$(basename "$REPO")"
  : >"$HV_ME"
  trap 'heavy_release' EXIT
  trap 'heavy_release; exit 130' INT TERM HUP
  HV_VAL="$seat@$(basename "$REPO"):$$:$(date +%s):$((limit * nsteps))"
  while :; do
    heavy_clear_stale
    # a waiter whose queue entry is gone would wait forever (hive observer, pass 64): stop and say so
    [ -e "$HV_ME" ] || { HV_ME=""; die "your place in the heavy queue was removed (by a stale-lock cleanup or by hand); nothing ran. Run the command again."; }
    if [ "$(ls "$q" | head -1)" = "$(basename "$HV_ME")" ] && ln -s "$HV_VAL" "$HV_LOCK" 2>/dev/null; then break; fi
    [ "$waited" = 1 ] || { say "squad heavy: waiting ($(heavy_status | tr '\n' ' '))"; waited=1; }
    sleep "$HEAVY_POLL"
    HV_VAL="$seat@$(basename "$REPO"):$$:$(date +%s):$((limit * nsteps))"
  done
  rm -f "$HV_ME"; HV_ME=""
  if [ "${S_ROLE[$si]}" != dev ] && [ -z "$crec" ]; then   # the commit the command really sees, read after the wait
    full=$(git -C "$run_dir" rev-parse HEAD 2>/dev/null || echo "?"); sha=${full:0:7}
  fi
  if [ -n "$crec" ]; then   # under the lock: a second candidate run cannot change these files mid-run
    dirty=$(wt_changes "$wt")
    [ -z "$dirty" ] || { printf '%s\n' "$dirty" | head -10 >&2; die "the tester's worktree ($wt) has uncommitted changes (above): commit or clean it before a candidate run."; }
    git -C "$wt" checkout -q --detach "$csha" || die "git could not check out $task in $wt."
    sha=$(git -C "$wt" rev-parse --short HEAD); full=$(git -C "$wt" rev-parse HEAD)
  fi
  # a dev's run happens in a snapshot of the commit, so the dev can keep working while it runs;
  # prepared under the lock, so a second run of the same seat cannot reset it mid-run
  if [ "${S_ROLE[$si]}" = dev ]; then
    local snap rel
    snap=$(HV_LIMIT=$limit prepare_snapshot "$seat" "$sha") || die "could not prepare the snapshot of $sha for $seat (log: .team/heavy/$seat.setup.log)."
    # a setup that took the whole limit may have lost the lock to the stale cleanup: never run without it
    [ "$(heavy_owner)" = "$HV_VAL" ] || die "the heavy lock was taken from this run during the snapshot setup; nothing ran."
    rel=""
    case "$run_dir/" in "$(cd "$wt" && pwd -P)"/*) rel=${run_dir#"$(cd "$wt" && pwd -P)"} ;; esac
    run_dir="$snap$rel"
    [ -d "$run_dir" ] || run_dir=$snap
    snap_name=${snap#"$WT_ROOT"/}
  fi
  local step=0 worst=0 rcs="" changed=0
  while :; do
    printf '@%s (%s min): %s\n' "$sha" "$minutes" "${cmdv[*]}" >"$HEAVY_DIR/lock.cmd"
    start=$(date +%s)
    log_event "$seat" "$task" HEAVY_START "sha=$full limit=${minutes}m${shard:+ sample=$shard}${snap_name:+ in=$snap_name}${batch:+ step=$((step + 1))/$nsteps} ${cmdv[*]}"
    rm -f "$HEAVY_DIR/stopped.$$"
    HV_LOG="$HEAVY_DIR/run.$$.log"; : >"$HV_LOG"; HV_POS=0
    ( export SQUAD_SHARD="$shard"; run_in_group "$run_dir" "${cmdv[@]}" ) >"$HV_LOG" 2>&1 & HV_CPID=$!
    HV_PGID=$HV_CPID
    printf '%s %s\n' "$HV_CPID" "$(proc_start "$HV_CPID")" >"$HEAVY_DIR/lock.pgid"
    ( sleep "$limit"; : >"$HEAVY_DIR/stopped.$$"
      echo "squad heavy: stopped after $minutes min (heavy_timeout${HEAVY_TIMEOUT_DEV:+ / heavy_timeout_dev} in team.conf, or --limit)" >&2
      stop_tree "$HV_CPID" ) &
    HV_WPID=$!
    disown "$HV_WPID" 2>/dev/null || true   # no "Killed" job notice in the caller's output when it is stopped
    heavy_watch "$seat" "$task" "$HV_LOG"
    rc=0; wait "$HV_CPID" || rc=$?
    HV_CPID=""
    kill_tree "$HV_WPID" KILL; HV_WPID=""   # this step's limit timer ends with it (its sleep too: it holds the output open)
    # the leader ended; anything left in its group (a child that ignored TERM, a stray background job)
    # ends too, and only then the last output is read, so nothing it writes on the way out is lost
    if group_alive "$HV_PGID"; then stop_group "$HV_PGID"; fi
    heavy_stream "$HV_LOG" || true; rm -f "$HV_LOG"
    # a run that was stopped never counts as passed, whatever its exit code
    if [ -f "$HEAVY_DIR/stopped.$$" ] || [ $(( $(date +%s) - start )) -ge "$limit" ]; then rc=124; fi
    rm -f "$HEAVY_DIR/stopped.$$"
    log_event "$seat" "$task" HEAVY_END "rc=$rc $(( ($(date +%s) - start + 30) / 60 ))m${batch:+ step=$((step + 1))/$nsteps}"
    [ "$rc" = 0 ] || [ "$worst" != 0 ] || worst=$rc
    step=$((step + 1)); rcs="$rcs step$step=$rc"
    # a candidate step leaves its commit as it found it: a check that edits a tracked file proves nothing
    if [ -n "$crec" ] && { [ "$(git -C "$wt" rev-parse HEAD)" != "$full" ] || [ -n "$(wt_changes "$wt")" ]; }; then changed=1; fi
    [ -n "$batch" ] && [ "$step" -lt "$nsteps" ] || break
    [ "$rc" != 124 ] || break   # a hung or timed-out step ends the batch: the lock goes to the next in line
    cmdv=(bash -c "${batchv[$step]}")
  done
  if [ -n "$crec" ]; then   # the runner's receipt: written by this run, never by the seat that reports PASS
    if [ "$changed" = 0 ] && [ "$(git -C "$wt" rev-parse HEAD)" = "$full" ] && [ -z "$(wt_changes "$wt")" ] && [ "$(plan_hash "$crec" 2>/dev/null)" = "$cbuild" ]; then
      mkdir -p "$TEAM_DIR/receipts"
      { echo "build=$cbuild"; echo "sha=$full"; echo "checks=$cchecks"; echo "steps=$step"; printf '%s\n' $rcs; } >"$TEAM_DIR/receipts/$task.tmp" \
        && mv "$TEAM_DIR/receipts/$task.tmp" "$TEAM_DIR/receipts/$task"
    else
      say "squad heavy: the tester's worktree or $task's build changed during the run; no receipt for $task." >&2; [ "$worst" != 0 ] || worst=1
    fi
  fi
  rm -f "$bsnap"
  heavy_release
  return "$worst"
}

HV_ME="" HV_LOCK="" HV_VAL="" HV_CPID="" HV_WPID="" HV_PGID="" HV_LOG="" HV_POS=0

heavy_stream() { # <log>: print what the run wrote since the last call
  local size
  size=$(wc -c <"$1" 2>/dev/null | tr -d ' ') || return 0
  if [ "${size:-0}" -gt "$HV_POS" ]; then tail -c +$((HV_POS + 1)) "$1" | head -c $((size - HV_POS)); HV_POS=$size; return 0; fi
  return 1
}

tree_cpu() { # <pgid> <root pid> -> summed CPU seconds of the group and of every descendant of the root,
  # also those that moved to their own process group (a runner's workers): a quiet suite that computes is not hung
  local p
  p=$( { pgrep -g "$1" 2>/dev/null || true
         ps -A -o pid= -o ppid= 2>/dev/null | awk -v r="$2" '{ par[$1] = $2 } END { for (q in par) { x = q; d = 0; while (x in par && d < 64) { if (par[x] == r) { print q; break } x = par[x]; d++ } } }'
       } | sort -u | tr '\n' ',' | sed 's/,$//')
  [ -n "$p" ] || { echo 0; return 0; }
  { ps -o time= -p "$p" 2>/dev/null || true; } | awk '{ n = split($1, t, /[:-]/); s = 0; for (i = 1; i <= n; i++) s = s * 60 + t[i]; sum += s } END { printf "%.2f\n", sum }'
}

group_cpu() { # <pgid> -> summed CPU seconds of the group's processes
  local p; p=$(pgrep -g "$1" 2>/dev/null | tr '\n' ',' | sed 's/,$//')
  [ -n "$p" ] || { echo 0; return 0; }
  { ps -o time= -p "$p" 2>/dev/null || true; } | awk '{ n = split($1, t, /[:-]/); s = 0; for (i = 1; i <= n; i++) s = s * 60 + t[i]; sum += s } END { printf "%.2f\n", sum }'
}

# While the run lives: stream its output, refresh the seat's heartbeat (a seat with a live run is
# busy, not stalled: Gas Town's Witness), and stop a run with no new output and no CPU time for
# heavy_silent_minutes as hung (CircleCI no_output_timeout, Travis: 10 min without output).
heavy_watch() { # <seat> <task> <log>
  local seat=$1 task=$2 log=$3 last tick=0 cpu prev="" silent
  silent=${SQUAD_SILENT_SECONDS:-$((HEAVY_SILENT_MINUTES * 60))}
  last=$(date +%s)
  mkdir -p "$TEAM_DIR/seats"
  while kill -0 "$HV_CPID" 2>/dev/null; do
    sleep "${SQUAD_WATCH_TICK:-1}"
    heavy_stream "$log" && last=$(date +%s)
    tick=$((tick + 1))
    if [ $((tick % 10)) = 1 ]; then
      date +%s >"$TEAM_DIR/seats/$seat.heartbeat"
      cpu=$(tree_cpu "$HV_PGID" "$HV_CPID" || echo "?")
      [ "$cpu" = "$prev" ] || { prev=$cpu; last=$(date +%s); }
    fi
    if [ "$silent" -gt 0 ] && [ $(( $(date +%s) - last )) -ge "$silent" ]; then
      echo "squad heavy: no output and no CPU time for $(( silent / 60 )) min $(( silent % 60 )) s: stopped as hung (heavy_silent_minutes)." >&2
      : >"$HEAVY_DIR/stopped.$$"
      log_event "$seat" "$task" HUNG "no output and no CPU for ${silent}s"
      stop_group "$HV_PGID"; stop_tree "$HV_CPID"
      break
    fi
  done
  rm -f "$TEAM_DIR/seats/$seat.heartbeat"
}

run_limited() { # <seconds> <dir> <command...>: in its own group, recorded for the stale cleanup, stopped at the limit
  local secs=$1 dir=$2 p k=0; shift 2
  ( run_in_group "$dir" "$@" ) & p=$!
  printf '%s %s\n' "$p" "$(proc_start "$p")" >"$HEAVY_DIR/lock.pgid"
  while kill -0 "$p" 2>/dev/null; do
    if [ "$k" -ge "$secs" ]; then stop_group "$p"; stop_tree "$p"; return 124; fi
    sleep 1; k=$((k + 1))
  done
  wait "$p"
}

stop_group() { # <pgid>: TERM, up to the grace, then KILL; returns once the group is empty
  local k=0
  kill -TERM -- "-$1" 2>/dev/null || true
  while group_alive "$1" && [ "$k" -lt "${SQUAD_STOP_GRACE:-10}" ]; do sleep 1; k=$((k + 1)); done
  group_alive "$1" && kill -KILL -- "-$1" 2>/dev/null
  return 0
}

# A dev's snapshot: <repo>-team/.runs/<seat>, a detached worktree moved to the commit under test
# (a dot folder: no seat name can collide with it).
# Ignored files (node_modules, caches) stay; the setup runs again only when a lockfile changed.
prepare_snapshot() { # <seat> <sha> -> path
  local seat=$1 sha=$2 snap="$WT_ROOT/.runs/$1" h old
  mkdir -p "$TEAM_DIR/heavy"
  if [ ! -d "$snap" ]; then
    mkdir -p "$WT_ROOT/.runs"
    git -C "$REPO" worktree add -q --detach "$snap" "$sha" >&2 || return 1
    rm -f "$TEAM_DIR/heavy/$seat.setup"   # a new snapshot has no dependencies yet
  else
    git -C "$snap" checkout -q --detach -f "$sha" >&2 && git -C "$snap" clean -qfd >&2 || return 1
  fi
  [ "$VERIFY_HOOK" = off ] && : >"$snap/.agents-verify-off"
  if [ -n "$SETUP_CMD" ]; then
    h=$( (cd "$snap" && cat package-lock.json pnpm-lock.yaml yarn.lock bun.lock bun.lockb uv.lock poetry.lock Gemfile.lock 2>/dev/null || true) | cksum)
    old=$(cat "$TEAM_DIR/heavy/$seat.setup" 2>/dev/null || true)
    if [ "$h" != "$old" ]; then
      say "squad heavy: running setup in ${snap#"$WT_ROOT"/} (log: .team/heavy/$seat.setup.log)" >&2
      run_limited "${HV_LIMIT:-1200}" "$snap" bash -c "$SETUP_CMD" >"$TEAM_DIR/heavy/$seat.setup.log" 2>&1 || return 1
      echo "$h" >"$TEAM_DIR/heavy/$seat.setup"
    fi
  fi
  echo "$snap"
}
heavy_release() { # globals: the trap runs after cmd_heavy's locals are gone
  [ -z "$HV_ME" ] || rm -f "$HV_ME"
  # stop the command and its children first: the lock is free only once nothing of the run is left
  [ -z "$HV_CPID" ] || stop_tree "$HV_CPID"
  [ -z "$HV_PGID" ] || ! group_alive "$HV_PGID" || stop_group "$HV_PGID"
  [ -z "$HV_WPID" ] || kill_tree "$HV_WPID" KILL
  if [ -n "$HV_LOCK" ] && [ "$(heavy_owner)" = "$HV_VAL" ]; then rm -f "$HV_LOCK" "$HEAVY_DIR/lock.cmd" "$HEAVY_DIR/lock.pgid"; fi
  HV_CPID="" HV_WPID="" HV_ME="" HV_PGID=""
  [ -z "$HV_LOG" ] || rm -f "$HV_LOG"
}

# ---- squad dispatch: clear a seat, give it a task, confirm it started ---------
# squad dispatch <seat> <task> [--escalate] [text...]
# The lead's one command for every hand-out. Replaces "send the clear, sleep,
# send the task, read the pane": a seat that got "/clearTask …" never started.
DISPATCH_WAIT=${SQUAD_DISPATCH_WAIT:-60}

wait_for_state() { # <seat> <seconds> <state...>: true once herdr shows one of them
  local seat=$1 secs=$2 end s; shift 2
  end=$(( $(date +%s) + secs ))
  while :; do
    s=$(seat_state "$(herdr_team agent list 2>/dev/null || echo '{"result":{"agents":[]}}')" "$seat")
    case " $* " in *" $s "*) return 0 ;; esac
    [ "$(date +%s)" -lt "$end" ] || return 1
    sleep 1
  done
}

pane_tail() { herdr_team agent read "$1" --source visible 2>/dev/null | tail -"${2:-15}" || true; }

MENU_RE='enter to submit|esc to cancel|press enter to confirm|Do you want to|\[y/n\]|Allow the |trust this folder|Update available'

# the agent's input line: the last prompt-marked line, only among the last lines of the pane
input_line() { printf '%s\n' "$1" | tail -6 | grep -E '^[[:space:]│]*(❯|›)' | tail -1 || true; }

has_menu() { # a dialog, or a picker whose selected row is numbered ("❯ 1. Default")
  printf '%s\n' "$1" | grep -qiE "$MENU_RE" || printf '%s\n' "$1" | grep -qE '^[[:space:]│]*(❯|›)[[:space:]]*[0-9]+\.'
}

# squad never answers a seat's question or permission prompt, so it types nothing into a seat that shows a
# dialog. herdr reads its state from the screen and can be wrong: the pane is read too.
seat_dialog() { # <seat>: herdr shows it blocked, or its pane shows a menu
  [ "$(seat_state "$(herdr_team agent list 2>/dev/null || echo '{"result":{"agents":[]}}')" "$1")" = blocked ] || has_menu "$(pane_tail "$1" 12)"
}
tell_lead() { # <text>: squad's own message to the lead. False: not sent (the lead shows a dialog, or is not reachable); the caller sends it at a later tick
  ! seat_dialog "$LEAD" && herdr_team agent prompt "$LEAD" "$1" >/dev/null 2>&1
}

wait_ready() { # <seat> <kind> <seconds>: the pane shows the agent's ready prompt and no menu
  local seat=$1 kind=$2 end text mark
  case "$kind" in claude) mark='❯' ;; codex) mark='›' ;; *) return 0 ;; esac
  end=$(( $(date +%s) + $3 ))
  while :; do
    text=$(pane_tail "$seat" 12)
    # ready: the input line is empty, or holds only the agent's grey hint text; never a leftover "/clear"
    local cur; cur=$(input_line "$text")
    if ! has_menu "$text" && printf '%s' "$cur" | grep -qE "^[[:space:]│]*$mark" \
       && ! printf '%s' "$cur" | grep -qE "^[[:space:]│]*${mark}[[:space:]]*/"; then return 0; fi
    [ "$(date +%s)" -lt "$end" ] || return 1
    sleep 1
  done
}

wait_started() { # <seat> <task text> <seconds>
  local seat=$1 key end text half nudged=0
  key=$(printf '%s\n' "$2" | grep -m1 '[^[:space:]]' | cut -c1-40 || true)
  [ -n "$key" ] || key="(empty)"
  end=$(( $(date +%s) + $3 )); half=$(( $(date +%s) + $3 / 2 ))
  while :; do
    text=$(pane_tail "$seat" 15)
    printf '%s\n' "$text" | grep -qi 'esc to interrupt' && return 0
    has_menu "$text" && return 0   # it started and now asks: the watcher reports it as blocked; never press Enter on a menu
    local cur; cur=$(input_line "$text")
    # submitted: the task text is in the transcript, not in the input line (also a turn that already ended)
    if ! printf '%s' "$cur" | grep -qF -- "$key" && printf '%s\n' "$text" | grep -qF -- "$key"; then return 0; fi
    if [ "$(seat_state "$(herdr_team agent list 2>/dev/null || echo '{"result":{"agents":[]}}')" "$seat")" = working ] \
       && ! printf '%s' "$cur" | grep -qF -- "$key"; then return 0; fi
    # still in the input line halfway: press Enter once (Gas Town re-submits a stranded prompt)
    if [ "$nudged" = 0 ] && [ "$(date +%s)" -ge "$half" ] && printf '%s' "$cur" | grep -qF -- "$key"; then
      herdr_team agent send-keys "$seat" enter >/dev/null 2>&1 || true; nudged=1
    fi
    [ "$(date +%s)" -lt "$end" ] || return 1
    sleep 1
  done
}

default_task_line() { # <role> <task> <round>
  case "$1" in
    dev) if [ "$3" -gt 1 ] || [ -f "$TEAM_DIR/reports/$2-test.md" ]; then echo "$2 needs changes. Read the newest review in $TEAM_DIR/reports/$2-review-*.md (and $TEAM_DIR/reports/$2-test.md if it failed), fix every finding, update your report."
         else echo "Task $2 is yours. Read $TEAM_DIR/tasks/$2.md and follow your role file."; fi ;;
    tester) echo "Test task $2. Read $TEAM_DIR/tasks/$2.md and follow your role file." ;;
    reviewer) echo "Review task $2, round $3. Read $TEAM_DIR/tasks/$2.md and follow your role file." ;;
    *) echo "Task $2: read $TEAM_DIR/tasks/$2.md." ;;
  esac
}

review_round() { # <task> -> the round the next review gets (1 + review files so far)
  local n=0 f
  for f in "$TEAM_DIR/reports/$1"-review-*.md; do [ -f "$f" ] && n=$((n + 1)); done
  echo $((n + 1))
}

seat_model_arg() { # <index> -> the --model / -m value in the seat's arguments, or nothing
  awk '{ for (i = 1; i <= NF; i++) { if (($i == "--model" || $i == "-m") && i < NF) { print $(i + 1); exit }
                                     if ($i ~ /^--model=/) { print substr($i, 9); exit } } }' <<<"${S_ARGS[$1]}"
}

cmd_dispatch() {
  find_repo; load_conf
  local seat=${1:-} task=${2:-} escalate=0 started=0 i role kind clear text round deferred=0
  local -a orig=("$@")
  [ -n "$seat" ] && [ -n "$task" ] || die "usage: squad dispatch <seat> <task> [--escalate] [text...]"
  valid_task "$task"
  shift 2
  [ "${1:-}" = --escalate ] && { escalate=1; shift; }
  i=$(seat_index "$seat") || die "no seat named '$seat' in this team."
  role=${S_ROLE[$i]}; kind=${S_KIND[$i]}
  [ "$seat" != "$LEAD" ] || die "the lead does not dispatch to itself."
  # the gate holds a task's first start; a task already under way (its test, review, a fix) goes on
  # (started = real work on it: a run, a report, a verdict; a dispatch that failed does not count)
  awk -v t="$task" '{ id = ($1 ~ /^[0-9][0-9][0-9][0-9]-/) ? $4 : $3; e = ($1 ~ /^[0-9][0-9][0-9][0-9]-/) ? $5 : $4 }
    id == t && e ~ /^(DONE|PASS|FAIL|APPROVE|CHANGES|HEAVY_START|HEAVY_END|BLOCKED|CONTRACT|DONE-FOR-SWITCH)$/ { f = 1 } END { exit !f }' "$TEAM_DIR/events.log" 2>/dev/null && started=1
  [ "$started" = 1 ] || plan_gate "$task"
  round=$(review_round "$task")
  # the contract comes first: a dev starts only on a table the tester agreed
  # (only a task's first hand-out: a task already under way, for example from an older squad, goes on)
  if [ "$role" = dev ] && has_role tester && [ ! -f "$TEAM_DIR/reports/$task-contract.md" ] \
     && ! awk -v t="$task" -v devs=" $(dev_seats) " '
          { if ($1 ~ /^[0-9][0-9][0-9][0-9]-/) { s = $3; id = $4; e = $5 } else { s = $2; id = $3; e = $4 } }
          (id "") == (t "") && index(devs, " " s " ") && e !~ /^(DISPATCH_FAILED|DISPATCH_QUEUED|DISPATCH_DROPPED|DISPATCH_NOT_STARTED|CONTRACT_DEFERRED)$/ { f = 1 }
          END { exit !f }' "$TEAM_DIR/events.log" 2>/dev/null; then
    # the tester busy in a run (a candidate takes 45 min): the dev starts on the brief, the contract follows (observer S-47)
    local tst; tst=$(first_role tester)
    if [ "${SQUAD_CONTRACT_DEFERRED:-0}" = 1 ] || [ "$(seat_state "$(herdr_team agent list 2>/dev/null || echo '{"result":{"agents":[]}}')" "$tst")" = working ]; then
      deferred=1
    else
      die "no contract for $task yet: send the tester 'squad dispatch <tester> $task --contract' first ($TEAM_DIR/reports/$task-contract.md)."
    fi
  fi
  if [ "${1:-}" = --contract ]; then
    [ "$role" = tester ] || die "--contract goes to the tester."
    shift; text="Contract for task $task: read $TEAM_DIR/tasks/$task.md and follow 'The contract' in your role file."; CONTRACT_TEXT=1
  else
    text=${*:-$(default_task_line "$role" "$task" "$round")}
  fi
  [ "$deferred" = 0 ] || text="$text The contract is not written yet: the tester is in a run. Start on the brief; the tester's contract notes come to you as a RULE line."
  # a busy seat: the task waits for it and is sent when it is free (observer S-39); the call returns at once
  if [ "${SQUAD_DISPATCH_QUEUED:-0}" != 1 ] && { [ "$(seat_state "$(herdr_team agent list 2>/dev/null || echo '{"result":{"agents":[]}}')" "$seat")" = working ] || seat_busy "$seat" || queue_lock_held "$seat" || queue_pending "$seat"; }; then
    SQUAD_CONTRACT_DEFERRED=$deferred dispatch_queue "$seat" "$task" "${orig[@]}"
    return 0
  fi
  clear=$(clear_cmd "$kind")
  if [ "$clear" != "-" ]; then
    herdr_team agent prompt "$seat" "$clear" >/dev/null || die "could not reach $seat."
    sleep 2
    wait_for_state "$seat" "$DISPATCH_WAIT" idle "done" || die "$seat did not come back to idle after $clear (see its pane)."
  fi
  # model: a fix round from round 4 on runs one tier higher; every other task runs the seat's own model
  local model="" mark="$TEAM_DIR/seats/$seat.escalated"
  if [ "$kind" = claude ]; then
    # the seat's own model is known only from its arguments: without one, no escalation (it could not be undone)
    if [ "$escalate" = 1 ] && [ -n "$ESCALATE_MODEL" ] && [ -n "$(seat_model_arg "$i")" ]; then model=$ESCALATE_MODEL; mkdir -p "$TEAM_DIR/seats"; : >"$mark"
    elif [ "$escalate" = 1 ]; then say "squad dispatch: no --escalate for $seat (no escalate_model, or no --model in its seat line)."
    elif [ -f "$mark" ]; then model=$(seat_model_arg "$i"); rm -f "$mark"; fi
    if [ -n "$model" ]; then
      herdr_team agent prompt "$seat" "/model $model" >/dev/null || true
      sleep 2; wait_for_state "$seat" "$DISPATCH_WAIT" idle "done" || true
    fi
  fi
  # the seat must be at its own prompt, with no menu open (Gas Town: WaitForRuntimeReady)
  local ready=1; wait_ready "$seat" "$kind" "$DISPATCH_WAIT" || ready=0
  if [ "${SQUAD_DISPATCH_QUEUED:-0}" != 1 ] && [ "$(seat_state "$(herdr_team agent list 2>/dev/null || echo '{"result":{"agents":[]}}')" "$seat")" = working ]; then
    SQUAD_CONTRACT_DEFERRED=$deferred dispatch_queue "$seat" "$task" "${orig[@]}"; return 0
  fi
  [ "$ready" = 1 ] || wait_ready "$seat" "$kind" 5 || { log_event "$seat" "$task" DISPATCH_FAILED "not at its prompt"; die "$seat is not at its prompt (a menu, a dialog or its start screen). Read its pane: squad herdr agent read $seat --source visible"; }
  # logged before the task is sent: a fast seat's report can never come before its dispatch
  [ "$started" = 1 ] || plan_gate "$task"   # again: the plan may have changed during the waits above
  log_event "$seat" "$task" DISPATCH "$([ "${CONTRACT_TEXT:-0}" = 1 ] && printf 'contract=1 ')round=$round${model:+ model=$model} $(usage_tag)"
  herdr_team agent prompt "$seat" "$text" >/dev/null || { log_event "$seat" "$task" DISPATCH_FAILED "could not send"; die "could not send the task to $seat."; }
  # started = the pane shows a running turn, or the task left the input line (Gas Town: submit_verify.go)
  if ! wait_started "$seat" "$text" "$DISPATCH_WAIT"; then
    log_event "$seat" "$task" DISPATCH_NOT_STARTED "no running turn in ${DISPATCH_WAIT}s"
    die "$seat did not start on $task within ${DISPATCH_WAIT}s. Read its pane: squad herdr agent read $seat --source visible"
  fi
  say "$seat started on $task (round $round${model:+, $model})."
  ui_sync >/dev/null 2>&1 || true   # its sidebar entry now, not at the strip's next tick
  if [ "$deferred" = 1 ]; then   # the contract follows: queued for the tester, sent when its run ends
    log_event "$seat" "$task" CONTRACT_DEFERRED "the tester was in a run"
    local tq; tq=$(first_role tester)
    # a contract request already waiting (or the contract written): no second one
    if [ -f "$TEAM_DIR/reports/$task-contract.md" ] || awk -v s="$tq" -v t="$task" '$3 == s && $4 == t { if ($5 == "DISPATCH_QUEUED") q = 1; else if ($5 == "DISPATCH" || $5 == "DISPATCH_DROPPED" || $5 == "DISPATCH_FAILED") q = 0 } END { exit !q }' "$TEAM_DIR/events.log" 2>/dev/null; then :
    elif ! ( SQUAD_DISPATCH_QUEUED=0 SQUAD_CONTRACT_DEFERRED=0 "$SQUAD_HOME/bin/squad" dispatch "$(first_role tester)" "$task" --contract ) >/dev/null 2>&1; then
      say "squad dispatch: the contract for $task could not be sent to $(first_role tester); send it: squad dispatch $(first_role tester) $task --contract"
      herdr_team agent prompt "$LEAD" "[squad] the contract for $task was not sent to $(first_role tester): send it again (squad dispatch $(first_role tester) $task --contract)." >/dev/null 2>&1 || true
    fi
  fi
}

DISPATCH_QUEUE_WAIT=${SQUAD_DISPATCH_QUEUE_WAIT:-7200}
# A seat's queue: a pending file per waiting dispatch (first come, first served) and one delivery
# lock, a symlink to its owner's pid (made in one step, like the heavy lock).
queue_lock_held() { # <seat>: a queued dispatch is being delivered to it now (its owner is alive)
  local l="$TEAM_DIR/seats/$1.dispatching" p
  p=$(readlink "$l" 2>/dev/null) || return 1
  if kill -0 "$p" 2>/dev/null; then return 0; fi
  [ "$(readlink "$l" 2>/dev/null)" = "$p" ] && rm -f "$l"   # left over from a killed queue: cleared
  return 1
}
queue_pending() { # <seat> [<my pending file>]: another dispatch waits for this seat (ahead of mine, when given)
  local f p
  for f in "$TEAM_DIR/seats/$1.pending"/*; do
    [ -e "$f" ] || continue
    [ "$f" = "${2:-}" ] && return 1   # sorted: the files before mine are ahead of me
    p=$(cut -d- -f2 <<<"$(basename "$f")")
    if kill -0 "$p" 2>/dev/null; then return 0; fi   # a dead waiter's file stays: report_lost_requests tells the lead
  done
  return 1
}
request_kind() { # <dispatch arguments...> -> 1 for a contract request (the option after seat, task and --escalate), else 0
  shift 2; [ "${1:-}" != --escalate ] || shift
  if [ "${1:-}" = --contract ]; then echo 1; else echo 0; fi
}
dispatch_queue() { # <seat> <task> <the dispatch arguments...>: wait in the background until the seat is free, then dispatch
  local seat=$1 task=$2; shift 2
  local log="$TEAM_DIR/seats/$seat.queue.log" since contract=0 a
  contract=$(request_kind "$@")
  mkdir -p "$TEAM_DIR/seats/$seat.pending"
  since=$(wc -l <"$TEAM_DIR/events.log" | tr -d ' ')   # before the QUEUED line: a DISPATCH right after it still counts
  log_event "$seat" "$task" DISPATCH_QUEUED "$([ "$contract" = 1 ] && printf 'contract=1 ')waits for $seat to be free"
  (
    set +e
    me=$(exec sh -c 'echo "$PPID"'); mine="$TEAM_DIR/seats/$seat.pending/$(date +%s%N 2>/dev/null | tr -dc 0-9 | cut -c1-19)-$me-$task"
    printf '%s\0' squad-request "$@" >"$mine"; lockd="$TEAM_DIR/seats/$seat.dispatching"   # the request, NUL-separated: after a restart the lead is told (report_lost_requests)
    # a waiter stopped by a signal (a restart) keeps its file, so report_lost_requests can tell the lead
    keep=0; trap 'keep=1; exit 129' HUP; trap 'keep=1; exit 143' TERM; trap 'keep=1; exit 130' INT
    trap '[ "$keep" = 1 ] || rm -f "$mine"; [ "$(readlink "$lockd" 2>/dev/null)" = "$me" ] && rm -f "$lockd"' EXIT
    end=$(( $(date +%s) + DISPATCH_QUEUE_WAIT ))
    sent() { # this request is done meanwhile: sent for the same purpose (a contract, or the task), or the contract written
      # a DISPATCH that ended in DISPATCH_NOT_STARTED or DISPATCH_FAILED was never sent
      [ "$contract" = 1 ] && [ -f "$TEAM_DIR/reports/$task-contract.md" ] && return 0
      tail -n +"$((since + 1))" "$TEAM_DIR/events.log" 2>/dev/null | awk -v s="$seat" -v t="$task" -v c="$contract" '
        $3 == s && $4 == t && $5 == "DISPATCH" { k = (index($0, "contract=1") > 0) ? 1 : 0; if (k == c) ok = 1 }
        $3 == s && $4 == t && ($5 == "DISPATCH_NOT_STARTED" || $5 == "DISPATCH_FAILED") && k == c { ok = 0 }
        END { exit !ok }' 
    }
    while [ "$(date +%s)" -lt "$end" ]; do
      [ -d "$TEAM_DIR" ] || exit 0   # the team is gone (deleted, or a test's folder): nothing to send to
      if sent; then log_event "$seat" "$task" DISPATCH_DROPPED "already sent or done"; exit 0; fi
      st=$(seat_state "$(herdr_team agent list 2>/dev/null || echo '{"result":{"agents":[]}}')" "$seat" 2>/dev/null) || st=off
      ! seat_busy "$seat" || st=working   # its own heavy run, the heavy queue, or background work (ticket 024)
      case "$st" in
        idle|done)   # free, my turn (no earlier waiter), the delivery lock taken in one step
          if ! queue_pending "$seat" "$mine" && ! queue_lock_held "$seat" && ln -s "$me" "$lockd" 2>/dev/null; then
            st=$(seat_state "$(herdr_team agent list 2>/dev/null || echo '{"result":{"agents":[]}}')" "$seat" 2>/dev/null) || st=off
            ! seat_busy "$seat" || st=working
            if sent; then log_event "$seat" "$task" DISPATCH_DROPPED "already sent or done"; exit 0; fi
            case "$st" in idle|done) ;; *) rm -f "$lockd"; sleep "${SQUAD_QUEUE_POLL:-15}"; continue ;; esac
            if SQUAD_DISPATCH_QUEUED=1 "$SQUAD_HOME/bin/squad" dispatch "$@"; then exit 0; fi
            tell_lead "[squad] the queued dispatch of $task to $seat failed: $log" || keep=1   # not told: the request stays, and the watch tells the lead (report_lost_requests)
            exit 1
          fi ;;
      esac   # working, blocked (a prompt or a question), off: wait
      sleep "${SQUAD_QUEUE_POLL:-15}"
    done
    log_event "$seat" "$task" DISPATCH_FAILED "still busy after $((DISPATCH_QUEUE_WAIT / 60)) min in the queue"
    tell_lead "[squad] $task waited $((DISPATCH_QUEUE_WAIT / 60)) min for $seat and was not sent." || keep=1
  ) >>"$log" 2>&1 </dev/null &
  disown $! 2>/dev/null || true
  say "$seat is busy: $task waits and is sent when $seat is free (queued; log: ${log#"$REPO"/})."
}

report_lost_requests() { # a queued request whose waiter is gone (a restart): the lead is told, squad sends nothing itself (the owner, 18 Nov 2026)
  local f c p a args kc
  mkdir -p "$TEAM_DIR/seats/claims"
  for f in "$TEAM_DIR"/seats/*.pending/*; do
    [ -f "$f" ] || continue
    p=$(basename "$f" | cut -d- -f2)
    kill -0 "$p" 2>/dev/null && continue
    c="$TEAM_DIR/seats/claims/$(basename "$f")"; mv "$f" "$c" 2>/dev/null || continue   # one strip tells
    args=(); while IFS= read -r -d '' a; do args+=("$a"); done <"$c"
    [ "${args[0]:-}" = squad-request ] && [ "${#args[@]}" -ge 3 ] || { rm -f "$c"; continue; }   # an older file without its request
    args=("${args[@]:1}"); kc=$(request_kind "${args[@]}")
    if [ "$kc" = 1 ] && [ -f "$TEAM_DIR/reports/${args[1]}-contract.md" ]; then rm -f "$c"; continue; fi   # the contract is written meanwhile
    # delivered: its newest send for this seat, task and purpose is a DISPATCH that did not fail afterwards
    if awk -v s="${args[0]}" -v t="${args[1]}" -v c="$kc" '$1 ~ /^[0-9][0-9][0-9][0-9]-/ && $3 == s && $4 == t {
         if ($5 == "DISPATCH") { k = (index($0, "contract=1") > 0) ? 1 : 0; if (k == c) ok = 1 }
         else if ($5 == "DISPATCH_QUEUED") { if (((index($0, "contract=1") > 0) ? 1 : 0) == c) ok = 0 }   # queued again: a new request
         else if ($5 ~ /^DISPATCH_(NOT_STARTED|FAILED)$/ && k == c) ok = 0 } END { exit !ok }' "$TEAM_DIR/events.log" 2>/dev/null; then
      rm -f "$c"; continue
    fi
    if tell_lead "[squad] ${args[1]} waited for ${args[0]} and was not sent when squad checked (its waiter stopped, for example at a herdr restart). Check the seat first; if it does not have the task, send it again: squad dispatch ${args[*]:0:2}$( [ "$kc" = 1 ] && printf ' --contract' ). (Notification: first finish what you were doing.)"; then
      log_event "${args[0]}" "${args[1]}" DISPATCH_LOST "its waiter stopped (a restart); the lead was told"
      rm -f "$c"
    else
      mv "$c" "$f" 2>/dev/null || true   # the lead is not reachable yet, or shows a dialog: the next tick tells it
    fi
  done
}

dev_seats() { local i n out=""; n=$(seat_count); for ((i = 0; i < n; i++)); do [ "${S_ROLE[$i]}" = dev ] && out="$out ${S_NAME[$i]}"; done; echo "${out# }"; }

has_role() { local i n; n=$(seat_count); for ((i = 0; i < n; i++)); do [ "${S_ROLE[$i]}" = "$1" ] && return 0; done; return 1; }

# ---- squad merge: the tested candidate becomes the integration branch ----------
cmd_merge() { # squad merge CANDIDATE-<n>: the tested candidate becomes the integration branch, exactly (ticket 018)
  find_repo; load_conf
  local cand=${1:-} rec base sha line t h v why
  case "$cand" in
    CANDIDATE-[0-9]*) ;;
    "") die "usage: squad merge CANDIDATE-<n>" ;;
    *) die "a task reaches $TEAM_BASE only in a tested candidate: squad candidate CANDIDATE-<n> $cand …, the tester's PASS, then squad merge CANDIDATE-<n>." ;;
  esac
  valid_task "$cand"
  mutex "$TEAM_DIR/.candidate.lock"; trap 'rmdir "$TEAM_DIR/.candidate.lock" 2>/dev/null || true' EXIT   # builds and promotions one at a time
  why=$(candidate_check "$cand") || die "merge refused: $why"
  rec="$TEAM_DIR/candidates/$cand"
  local testers=""; for ((t = 0; t < $(seat_count); t++)); do [ "${S_ROLE[$t]}" = tester ] && testers="$testers ${S_NAME[$t]}"; done
  awk -v c="$cand" -v ts=" $testers " -v b="$(plan_hash "$rec")" '$1 ~ /^[0-9][0-9][0-9][0-9]-/ && $4 == c && index(ts, " " $3 " ") {
      if ($5 == "PASS") p = (index($0, " build=" b) > 0); else if ($5 == "FAIL") p = 0 } END { exit !p }' "$TEAM_DIR/events.log" 2>/dev/null \
    || die "merge refused: the tester has not logged PASS for this build of $cand."
  base=$(sed -n 's/^base=//p' "$rec"); sha=$(sed -n 's/^sha=//p' "$rec")
  while IFS= read -r line; do
    t=${line%%:*}; h=${line#*:}
    [ "$(git -C "$WT_ROOT/integration" rev-parse -q --verify "task/$t" 2>/dev/null)" = "$h" ] || die "merge refused: task/$t changed after $cand was built: build a new candidate."
    v=$(lead_verdict "$t"); [ "$v" = "APPROVE $h" ] || die "merge refused: the lead's newest verdict on $t does not approve the commit in $cand."
    git -C "$WT_ROOT/integration" merge-base --is-ancestor "$h" "$sha" || die "merge refused: $cand does not contain the approved commit of $t."
  done < <(sed -n 's/^task=//p' "$rec")
  local I="$WT_ROOT/integration"
  git -C "$I" merge-base --is-ancestor "$base" "$sha" || die "merge refused: $cand is not built on ${base:0:12}."
  [ "$(git -C "$I" symbolic-ref -q HEAD)" = "refs/heads/$TEAM_BASE" ] || die "merge refused: the integration worktree ($I) is not on $TEAM_BASE (switch it back first)."
  [ "$(git -C "$I" rev-parse HEAD)" = "$base" ] || die "merge refused: $TEAM_BASE moved since $cand was built (it is not at ${base:0:12} any more): build a new candidate."
  git -C "$I" read-tree -n -m -u "$base" "$sha" || die "merge refused: the integration worktree ($I) has changes in the way (above); nothing moved."
  # compare and swap: the branch moves only if it is still at the base the candidate was built on
  # one transaction: the branch moves only if it is still at the base and every task is still at its approved commit
  { printf 'start\n'; sed -n 's/^task=\([^:]*\):\(.*\)/verify refs\/heads\/task\/\1 \2/p' "$rec"
    printf 'update refs/heads/%s %s %s\nprepare\ncommit\n' "$TEAM_BASE" "$sha" "$base"; } | git -C "$I" update-ref --stdin 2>/dev/null \
    || die "merge refused: $TEAM_BASE or a task branch moved since $cand was built: build a new candidate."
  git -C "$I" read-tree -m -u "$base" "$sha" || die "$TEAM_BASE is now ${sha:0:12}, but the integration worktree files could not follow (above): fix that worktree by hand; nothing is logged as merged."
  while IFS= read -r line; do log_event "$LEAD" "${line%%:*}" MERGE "$sha"; done < <(sed -n 's/^task=//p' "$rec")
  log_event "$LEAD" "$cand" CANDIDATE_MERGED "$sha"
  say "$TEAM_BASE is now $cand (${sha:0:12}), the commit the tester passed."
}

lead_verdict() { # <task> -> "APPROVE <head>" or "CHANGES <head>": the lead's newest verdict and the commit it covers
  awk -v l="$LEAD" -v t="$1" '$1 ~ /^[0-9][0-9][0-9][0-9]-/ && $3 == l && $4 == t && ($5 == "APPROVE" || $5 == "CHANGES") {
      e = $5; h = ""; for (i = 6; i <= NF; i++) if ($i ~ /^head=/) h = substr($i, 6) } END { if (e != "") print e " " h }' "$TEAM_DIR/events.log" 2>/dev/null || true
}

candidate_check() { # <CANDIDATE-n>: its record, the runner's receipt and today's brief and check list agree; prints why not
  local c=$1 rec="$TEAM_DIR/candidates/$1" rcp="$TEAM_DIR/receipts/$1" n k r want
  [ -f "$rec" ] || { echo "$c was not built with 'squad candidate' (no record)."; return 1; }
  [ -f "$rcp" ] || { echo "no receipt for $c: the tester's 'squad heavy <tester> $c --batch .team/tasks/$c.checks' writes it."; return 1; }
  kv() { sed -n "s/^$1=//p" "$2" | head -1; }
  [ "$(kv build "$rcp")" = "$(plan_hash "$rec")" ] || { echo "the receipt is from another build of $c: run it again."; return 1; }
  [ "$(kv sha "$rcp")" = "$(kv sha "$rec")" ] || { echo "the receipt is for another commit than $c."; return 1; }
  [ -f "$TEAM_DIR/tasks/$c.checks" ] && [ "$(kv checks "$rec")" = "$(plan_hash "$TEAM_DIR/tasks/$c.checks")" ] && [ "$(kv checks "$rcp")" = "$(kv checks "$rec")" ] \
    || { echo "the check list of $c changed after it was built or run: build and run it again."; return 1; }
  [ -f "$TEAM_DIR/tasks/$c.md" ] && [ "$(kv brief "$rec")" = "$(plan_hash "$TEAM_DIR/tasks/$c.md")" ] \
    || { echo "the brief of $c changed after it was built: build and run it again."; return 1; }
  want=$(check_lines "$TEAM_DIR/tasks/$c.checks" | wc -l | tr -d ' ')
  n=$(kv steps "$rcp"); [ "${n:-0}" = "$want" ] || { echo "the receipt has ${n:-0} of $want checks: the run did not finish."; return 1; }
  for ((k = 1; k <= n; k++)); do r=$(kv "step$k" "$rcp"); [ "$r" = 0 ] || { echo "check $k of $c failed (exit ${r:-?})."; return 1; }; done
  return 0
}

cmd_candidate() { # squad candidate CANDIDATE-<n> <task...>: one commit from the base and the lead's approved task commits
  find_repo; load_conf
  local cand=${1:-} t h v tmp base sha brief checks I="$WT_ROOT/integration"
  [[ "$cand" =~ ^CANDIDATE-[0-9]+$ ]] && [ $# -ge 2 ] || die "usage: squad candidate CANDIDATE-<n> <task> [<task>...]"
  shift
  mutex "$TEAM_DIR/.candidate.lock"; trap 'rmdir "$TEAM_DIR/.candidate.lock" 2>/dev/null || true' EXIT   # builds and promotions one at a time
  brief="$TEAM_DIR/tasks/$cand.md"; checks="$TEAM_DIR/tasks/$cand.checks"
  [ -n "$(acceptance_rows "$brief" 2>/dev/null)" ] || die "write the candidate's brief first, with its acceptance rows: $brief"
  grep -qvE '^[[:space:]]*(#|$)' "$checks" 2>/dev/null || die "write the candidate's check list first: $checks (one command a line)."
  base=$(git -C "$I" rev-parse "$TEAM_BASE") || die "no branch $TEAM_BASE."
  local -a heads=()
  for t in "$@"; do
    valid_task "$t"
    h=$(git -C "$I" rev-parse -q --verify "task/$t") || die "no branch task/$t."
    v=$(lead_verdict "$t")
    [ "${v%% *}" = APPROVE ] || die "$t is not approved by the lead (newest verdict: ${v%% *}${v:-none})."
    [ "${v#* }" = "$h" ] || die "$t changed after the lead approved it: review the new commit first."
    heads+=("$t:$h")
  done
  tmp="$WT_ROOT/.build-$cand"; git -C "$REPO" worktree remove --force "$tmp" >/dev/null 2>&1 || true; rm -rf "$tmp"
  git -C "$REPO" worktree add -q --detach "$tmp" "$base" || die "git could not prepare $tmp."
  for h in "${heads[@]}"; do   # the approved commits themselves: a branch that moves meanwhile changes nothing
    t=${h%%:*}
    if ! git -C "$tmp" merge -q --no-ff "${h#*:}" -m "Merge $t into $cand" >/dev/null 2>&1; then
      git -C "$REPO" worktree remove --force "$tmp" >/dev/null 2>&1 || true
      die "$t does not merge cleanly into $cand: send it back to its dev to bring $TEAM_BASE in."
    fi
  done
  sha=$(git -C "$tmp" rev-parse HEAD); git -C "$REPO" worktree remove --force "$tmp" >/dev/null 2>&1 || true
  git -C "$REPO" branch -f "candidate/$cand" "$sha" >/dev/null
  mkdir -p "$TEAM_DIR/candidates"; rm -f "$TEAM_DIR/receipts/$cand"   # a receipt of an older build does not count
  { echo "base=$base"; echo "sha=$sha"; echo "brief=$(plan_hash "$brief")"; echo "checks=$(plan_hash "$checks")"; printf 'task=%s\n' "${heads[@]}"; } >"$TEAM_DIR/candidates/$cand"
  log_event "$LEAD" "$cand" CANDIDATE "sha=$sha base=$base tasks=$*"
  say "$cand is ${sha:0:12} (candidate/$cand). The tester runs: squad heavy <tester> $cand --batch .team/tasks/$cand.checks"
}

# ---- squad notify: tell the seats at work that a rule changed ---------------
# squad notify "<file and section>" "<the new rule in one sentence>"
open_tasks() { # -> "seat task" for each seat whose last dispatch has no answer yet
  awk '{ if ($1 ~ /^[0-9][0-9][0-9][0-9]-/) { s = $3; t = $4; e = $5 } else { s = $2; t = $3; e = $4 }
         if (e == "DISPATCH") open[s] = t
         else if (e ~ /^(DONE|BLOCKED|PASS|FAIL|APPROVE|CHANGES|CONTRACT|DISPATCH_FAILED|DISPATCH_NOT_STARTED)$/ && open[s] == t) delete open[s] }
       END { for (s in open) print s, open[s] }' "$TEAM_DIR/events.log" 2>/dev/null || true
}

cmd_notify() {
  find_repo; load_conf
  [ $# -ge 2 ] || die "usage: squad notify \"<file and section>\" \"<the new rule in one sentence>\""
  local where=$1 rule=$2 seat task n=0 skipped=""
  while read -r seat task; do
    [ -n "$seat" ] || continue
    if seat_dialog "$seat"; then skipped="$skipped $seat"; continue; fi   # nothing is typed into a seat that shows a dialog
    herdr_team agent prompt "$seat" "[squad] Rule changed at $(date +%H:%M) in $where: $rule (Finish your current step, then follow it.)" >/dev/null && n=$((n + 1))
  done < <(open_tasks)
  log_event "$LEAD" - RULE "$where: $rule"
  say "told $n seat(s) at work."
  [ -z "$skipped" ] || say "not told (a dialog or a question in the pane):$skipped. Send the rule again when they are free: squad notify."
}

# ---- squad consult: a second, independent brain for a real issue ---------------
# squad consult [--wait] "<question>" [file...]
# Runs the consult model (default: GPT Sol, medium effort, with web search) read-only
# in the integration worktree. It brainstorms from official sources and writes
# .team/consult/<n>.md. Without --wait it runs in the background and tells the
# lead when the file is there.
cmd_consult() {
  find_repo; load_conf
  local wait=0; [ "${1:-}" = --wait ] && { wait=1; shift; }
  [ $# -ge 1 ] && [ -n "$1" ] || die "usage: squad consult [--wait] \"<question>\" [file...]"
  local question=$1; shift
  local dir="$TEAM_DIR/consult" n out log prompt f files=""
  local -a cmdv
  read -r -a cmdv <<<"$CONSULT_CMD"
  [ "${cmdv[0]}" = codex ] || die "consult runs Codex ('consult codex …' in team.conf); '${cmdv[0]}' is not supported yet."
  command -v codex >/dev/null 2>&1 || die "codex is not installed: squad consult needs it (or remove the consult step from the lead role)."
  mkdir -p "$dir"
  # reserve the number: an exclusive create, so two consults started together never share one
  n=$(( $(ls "$dir" 2>/dev/null | sed -n 's/^\([0-9][0-9]*\)\.md$/\1/p' | sort -n | tail -1 || true) + 1 ))
  until ( set -C; printf '# Consult %s (running)\n' "$n" >"$dir/$n.md" ) 2>/dev/null; do n=$((n + 1)); done
  out="$dir/$n.md"; log="$dir/$n.log"
  for f in "$@"; do files="$files
- $f"; done
  prompt=$(SUBST_N=4 SUBST_F1="{{QUESTION}}" SUBST_T1="$question" \
    SUBST_F2="{{FILES}}" SUBST_T2="${files:-"- (none named; read what you need in the repository)"}" \
    SUBST_F3="{{TEAM_DIR}}" SUBST_T3="$TEAM_DIR" SUBST_F4="{{REPO}}" SUBST_T4="$WT_ROOT/integration" \
    subst "$TEMPLATES/${CONSULT_TEMPLATE:-consult-prompt.md}")
  local cwd="$WT_ROOT/integration"; [ -d "$cwd" ] || cwd=$REPO
  log_event "$LEAD" - CONSULT "n=$n $question"
  run_consult() {
    local rc=0
    ( cd "$cwd" && "${cmdv[@]}" -s read-only --skip-git-repo-check -o "$out.tmp" "$prompt" ) >"$log" 2>&1 || rc=$?
    if [ "$rc" = 0 ] && [ -s "$out.tmp" ]; then
      { printf '# Consult %s\n\n- Question: %s\n- Asked: %s\n- Model: %s\n\n' "$n" "$question" "$(date '+%Y-%m-%d %H:%M')" "$CONSULT_CMD"; cat "$out.tmp"; } >"$out"
      rm -f "$out.tmp"
      log_event "$LEAD" - CONSULT_READY "n=$n"
      [ "$wait" = 1 ] || herdr_team agent prompt "$LEAD" "[squad] consult $n is ready: $out. Compare it with your own options, then decide and write the decision block. (Notification: first finish what you were doing.)" >/dev/null 2>&1 || true
    else
      log_event "$LEAD" - CONSULT_FAILED "n=$n rc=$rc"
      [ "$wait" = 1 ] || herdr_team agent prompt "$LEAD" "[squad] consult $n failed (exit $rc): $log. Decide without it and write 'GPT: consult failed' in the decision." >/dev/null 2>&1 || true
      return 1
    fi
  }
  if [ "$wait" = 1 ]; then
    run_consult || die "consult $n failed; see $log"
    say "$out"
  else
    run_consult </dev/null >/dev/null 2>&1 &
    say "consult $n started in the background; you get a line when $out is written. Work on other steps meanwhile."
  fi
}

# ---- plan (ticket 012): research and proof before any work ------------------------
# .team/PLAN.md (the project) and .team/plan/F-<n>.md (a feature). A plan passes the check only when
# every claim has an official source and a proof file, no claim is unproven, and every critique item
# has an answer. squad dispatch starts no task before the owner approves its plan.
plan_file() { # [F-<n>] -> the plan's path
  if [ -n "${1:-}" ]; then echo "$TEAM_DIR/plan/$1.md"; else echo "$TEAM_DIR/PLAN.md"; fi
}
plan_critique_file() { if [ -n "${1:-}" ]; then echo "$TEAM_DIR/plan/critique-$1.md"; else echo "$TEAM_DIR/plan/critique.md"; fi; }

plan_rows() { # <plan> -> "id<TAB>claim<TAB>source<TAB>proof<TAB>result" per row of its Feasibility table
  awk '
    /^## Feasibility/ { on = 1; next } /^## / { on = 0 }
    on && /^\|/ {
      line = $0; gsub(/\\\|/, "\001", line)   # an escaped pipe inside a cell is text
      n = split(line, c, "|"); sep = 1
      for (k = 2; k < n; k++) { gsub(/^[ \t]+|[ \t]+$/, "", c[k]); gsub(/\001/, "|", c[k]); if (c[k] !~ /^:?-+:?$/) sep = 0 }
      if (sep || c[2] == "#") next
      if (c[2] == "") c[2] = "(a row without an id)"
      printf "%s\t%s\t%s\t%s\t%s\n", c[2], c[3], c[4], c[5], c[6]
    }' "$1"
}

plan_check() { # <plan file> <critique file> -> the problems, one a line; empty when the plan is complete
  local plan=$1 crit=$2 term=0 id src proof res f rows=0 lres
  [ -f "$plan" ] || { echo "no plan: $plan"; return 0; }
  # a terminal platform: its mockups are captures of a real program, never HTML
  [ -z "$(awk '/^## Platform and versions/ { on = 1; next } /^## / { on = 0 } on' "$plan" | grep -iwE 'terminal|tui|herdr|tmux|cli' || true)" ] || term=1
  while IFS=$'\t' read -r id _ src proof res; do
    [ -n "$id" ] || continue
    rows=$((rows + 1))
    case "$src" in *http://*|*https://*) ;; *) echo "$id: no official source URL" ;; esac
    proof=${proof//\`/}
    if [ -z "$proof" ] || [ "$proof" = "-" ]; then echo "$id: no proof file"
    else
      case "$proof" in /*|*..*) echo "$id: the proof must be a file in .team/plan/proofs/ (no absolute path, no ..): $proof" ;;
        *) f="$TEAM_DIR/plan/proofs/$proof"
           { [ -f "$f" ] && [ -s "$f" ]; } || echo "$id: proof file missing or empty: $proof" ;; esac
      [ "$term" = 0 ] || case "$proof" in *.html|*.htm|*.HTML|*.HTM) echo "$id: a mockup for a terminal must be a capture of a real program, not an HTML page" ;; esac
    fi
    lres=$(printf '%s' "$res" | tr '[:upper:]' '[:lower:]')
    case "$lres" in proven|"proven "*|"proven:"*) ;; *) echo "$id: not proven (${res:-no result})" ;; esac
    [ "$id" != "(a row without an id)" ] || echo "a feasibility row has no id: every claim needs one (F-<n>)"
  done <<<"$(plan_rows "$plan")"
  [ "$rows" -gt 0 ] || echo "the feasibility table has no claim"
  if [ ! -f "$crit" ]; then echo "no critique yet: run squad plan --critique"
  else
    local ci cn; ci=$(grep -E '^ITEMS: *[0-9]+ *$' "$crit" | tail -1 | grep -oE '[0-9]+' || true)
    cn=$(grep -cE '^[[:space:]]*- \[[ x]\]' "$crit" || true)
    if [ -z "$ci" ]; then echo "the critique has no 'ITEMS: <n>' line: it is not complete"
    elif [ "$ci" != "$cn" ]; then echo "the critique says ITEMS: $ci but has $cn item lines"; fi
    grep -nE '^[[:space:]]*- \[x\]' "$crit" | grep -v 'no item: GPT verified' | grep -viE 'answer: *[^ ]' | sed 's/^\([0-9]*\):.*/critique line \1 is marked done but has no "Answer:"/' || true
    grep -nE '^[[:space:]]*- \[ \]' "$crit" | sed 's/^\([0-9]*\):[[:space:]]*- \[ \] */critique line \1 has no answer: /' | cut -c1-160 || true; fi
  return 0
}

# the owner's approval: the plan's sha256, kept outside the team folder (agents write there); any later edit voids it
plan_seal() { echo "$HOME/.config/squad/approvals/$SESSION_NAME-$(basename "$1").sha256"; }   # fixed: not under the team folder, not chosen by a variable
wt_changes() { # <worktree>: its staged, unstaged and untracked changes; a status git cannot read counts as a change
  local o; o=$(git -C "$1" status --porcelain --untracked-files=all 2>/dev/null) || { echo "(git status failed)"; return 0; }
  printf '%s\n' "$o" | grep -v ' \.agents-verify-off$' | grep . || true
}

check_lines() { grep -vE '^[[:space:]]*(#|$)' "$1" 2>/dev/null || true; }   # <file>: its commands, one a line (a check list)

plan_hash() { { shasum -a 256 "$1" 2>/dev/null || sha256sum "$1"; } | cut -d' ' -f1; }
plan_approved() { local s; s=$(plan_seal "$1"); [ -f "$1" ] && [ -f "$s" ] && [ "$(cat "$s")" = "$(plan_hash "$1")" ]; }

cmd_start_seat() { # <seat>: start one seat in the running team (a seat added to team.conf later); the planner gets its plan tab
  find_repo; load_conf
  local seat=${1:-} i ws pane
  [ -n "$seat" ] || die "usage: squad start-seat <seat>"
  i=$(seat_index "$seat") || die "no seat named '$seat' in team.conf (run 'squad update-conf' to add the preset's new seats)."
  [ -z "$(herdr_team agent list 2>/dev/null | jq -r --arg n "$seat" '.result.agents[] | select(.name == $n) | .name' | head -1)" ] || die "$seat runs already."
  ws=$(herdr_team workspace list | jq -r --arg l "$(basename "$REPO") team" '.result.workspaces[] | select(.label == $l) | .workspace_id' | head -1)
  [ -n "$ws" ] || die "no running team workspace: start the team with 'squad up'."
  export HERDR_SOCKET_PATH; HERDR_SOCKET_PATH=$(cat "$TEAM_DIR/herdr.sock" 2>/dev/null || true)
  [ -n "$HERDR_SOCKET_PATH" ] || unset HERDR_SOCKET_PATH
  render_team_files
  case "${S_ROLE[$i]}" in
    planner) pane=$(plan_tab "$ws" "$i") ;;
    observer) pane=$(observer_tab "$ws" "$i") ;;
    critic) # beside the planner, in the plan tab
      local pp; pp=$(herdr_team pane list --workspace "$ws" | jq -r --arg l "$(first_role planner)" '.result.panes[] | select(.label == $l) | .pane_id' | head -1)
      [ -n "$pp" ] || die "no planner pane: start the planner first (squad start-seat $(first_role planner))."
      pane=$(split "$pp" right "$WT_ROOT/integration" 0.5) ;;
    *) die "start-seat starts a planner (and its critic), a critic or an observer; for other seats run 'squad up'." ;;
  esac
  START_FAILED=0; start_seat "$i" "$pane"
  [ "$START_FAILED" = 0 ] || die "$seat did not start: see its pane in the plan tab."
  say "$seat started in its tab."
  local c ci; c=$(first_role critic)
  if [ "${S_ROLE[$i]}" = planner ] && [ -n "$c" ] && [ -z "$(herdr_team agent list 2>/dev/null | jq -r --arg n "$c" '.result.agents[] | select(.name == $n) | .name' | head -1)" ]; then
    ci=$(seat_index "$c"); START_FAILED=0; start_seat "$ci" "$(split "$pane" right "$WT_ROOT/integration" 0.5)"
    [ "$START_FAILED" = 0 ] || die "$c did not start beside it: close its pane and run squad start-seat $c."
    say "$c started beside it."
  fi
}

cmd_plan() {
  find_repo; load_conf
  local mode=start feature="" goal="" a
  for a in "$@"; do
    case "$a" in
      --check) mode=check ;; --approve) mode=approve ;; --critique) mode=critique ;; --feature) feature=new ;;
      -*) die "squad plan: unknown option '$a' (a goal does not start with '-'; squad plan --help)." ;;
      *) if [[ "$a" =~ ^F-[0-9]+$ ]]; then feature=$a; else goal=${goal:+$goal }$a; fi ;;
    esac
  done
  [ "$feature" = new ] && [ "$mode" != start ] && die "--feature goes with a new goal: squad plan \"<goal>\" --feature"
  mkdir -p "$TEAM_DIR/plan/proofs"
  local plan crit problems
  case "$mode" in
    check)
      plan=$(plan_file "$feature"); crit=$(plan_critique_file "$feature")
      problems=$(plan_check "$plan" "$crit")
      if [ -n "$problems" ]; then printf '%s\n' "$problems" | sed 's/^/  ✖ /' >&2; die "the plan is not complete: ${plan#"$REPO"/}"; fi
      say "PLAN OK: ${plan#"$REPO"/}" ;;
    critique)
      plan=$(plan_file "$feature"); crit=$(plan_critique_file "$feature")
      [ -f "$plan" ] || die "no plan: $plan"
      local critic; critic=$(first_role critic)
      if [ -n "$critic" ]; then
        rm -f "$crit"
        herdr_team agent prompt "$critic" "[squad] Critique the plan $plan (proofs in $TEAM_DIR/plan/proofs/). Write $crit by your role file ($(role_file critic)): one '- [ ] <id>: <problem>' line per problem, then 'ITEMS: <n>'. Then tell $(first_role planner)." >/dev/null 2>&1 \
          || die "the critic seat ($critic) did not take the prompt: is the team up?"
        log_event "$critic" "${feature:--}" PLAN_CRITIQUE "asked"
        say "$critic critiques ${plan#"$REPO"/} in the plan tab; it writes ${crit#"$REPO"/} and tells the planner."
        return 0
      fi
      local out items
      out=$(CONSULT_TEMPLATE=critique-prompt.md cmd_consult --wait "Critique this plan: list every claim you cannot verify, each source that is not official, each proof that does not show its claim." "$plan" "$TEAM_DIR/plan/proofs") || die "the critique failed; see $TEAM_DIR/consult/"
      out=$(printf '%s\n' "$out" | tail -1)
      [ -f "$out" ] || die "the critique gave no answer file: $out"
      items=$(grep -E '^ITEMS: *[0-9]+ *$' "$out" | tail -1 | grep -oE '[0-9]+' || true)
      [ -n "$items" ] || die "the critique did not end with 'ITEMS: <n>': it is not trusted; run squad plan --critique again ($out)"
      [ "$(grep -cE '^[[:space:]]*- \[ \]' "$out" || true)" = "$items" ] || die "the critique counts $items items but lists another number: not trusted ($out)"
      { printf '# Critique of %s (GPT, %s)\n\nThe planner answers each item: change "- [ ]" to "- [x]" and write what changed or why the claim holds, with a source.\n\n' "${plan##*/}" "$(date '+%Y-%m-%d %H:%M')"
        if [ "$items" != 0 ]; then grep -E '^[[:space:]]*- \[ \]' "$out"; fi; echo "ITEMS: $items"; } >"$crit"
      log_event "$(first_role planner)" "${feature:--}" PLAN_CRITIQUE "items=$items"
      say "critique written: ${crit#"$REPO"/}" ;;
    approve)
      [ -z "${TEAM_ROLE:-}" ] || die "only $OWNER_NAME approves a plan (an agent's pane cannot)."
      plan=$(plan_file "$feature"); crit=$(plan_critique_file "$feature")
      # the owner approves one snapshot: the one checked, shown and sealed; any other content gets no seal
      local snap snapc ans="" seal st new
      [ -t 0 ] || die "approve from your own terminal: it asks you to type APPROVE."
      snap=$(mktemp); snapc=$(mktemp); cp "$plan" "$snap"; [ -f "$crit" ] && cp "$crit" "$snapc"
      problems=$(plan_check "$snap" "$snapc"); rm -f "$snapc"
      [ -z "$problems" ] || { rm -f "$snap"; printf '%s\n' "$problems" | sed 's/^/  ✖ /' >&2; die "not approved: the plan does not pass the check."; }
      printf 'Approve %s? It starts the work. Type APPROVE: ' "${plan#"$REPO"/}" >&2
      IFS= read -r ans || true; ans=${ans%$'\r'}
      [ "$ans" = APPROVE ] || { rm -f "$snap"; die "not approved."; }
      [ "$(plan_hash "$plan")" = "$(plan_hash "$snap")" ] || { rm -f "$snap"; die "the plan changed while you were approving it: run squad plan --approve again."; }
      st="Status: approved by $OWNER_NAME $(date '+%Y-%m-%d %H:%M')"; new=$(mktemp)
      if grep -q '^Status:' "$snap"; then awk -v s="$st" '!d && /^Status:/ { print s; d = 1; next } { print }' "$snap" >"$new"
      else awk -v s="$st" 'NR == 1 { print; print ""; print s; next } { print }' "$snap" >"$new"; fi
      cp "$new" "$plan"; rm -f "$snap"
      [ "$(plan_hash "$plan")" = "$(plan_hash "$new")" ] || { rm -f "$new"; die "the plan changed while it was written: not approved."; }
      seal=$(plan_seal "$plan"); mkdir -p "$(dirname "$seal")"; plan_hash "$new" >"$seal"; rm -f "$new"
      log_event "$LEAD" "${feature:--}" PLAN_APPROVED "${plan##*/}"
      say "approved: ${plan#"$REPO"/}" ;;
    start)
      [ -n "$goal" ] || die "usage: squad plan \"<goal>\" [--feature] | --check [F-n] | --critique [F-n] | --approve [F-n]"
      local planner; planner=$(first_role planner)
      [ -n "$planner" ] || die "this team has no planner seat: run 'squad update-conf' (it adds one), then 'squad up'."
      if [ "$feature" = new ]; then
        local n; n=$(( $(ls "$TEAM_DIR/plan" 2>/dev/null | sed -n 's/^F-\([0-9]*\)\.md$/\1/p' | sort -n | tail -1 || true) + 1 ))
        feature="F-$n"
      fi
      plan=$(plan_file "$feature")
      if [ -f "$plan" ] && grep -q '(the goal: squad plan' "$plan" && grep -qx 'Status: draft' "$plan"; then
        SUBST_N=1 SUBST_F1="{{GOAL}}" SUBST_T1="$goal" subst "$TEMPLATES/PLAN.md" >"$plan"   # the draft from init gets its goal
      elif [ -f "$plan" ]; then say "the plan exists: ${plan#"$REPO"/} (the planner goes on with it; an edit voids an approval)"
      else SUBST_N=1 SUBST_F1="{{GOAL}}" SUBST_T1="$goal" subst "$TEMPLATES/PLAN.md" >"$plan"; fi
      log_event "$planner" "${feature:--}" PLAN_START "$goal"
      herdr_team agent prompt "$planner" "[squad] Plan this: $goal. Write $plan by your role file ($(role_file planner)): official sources, proofs in $TEAM_DIR/plan/proofs/, then 'squad plan --critique${feature:+ $feature}' and 'squad plan --check${feature:+ $feature}'." >/dev/null 2>&1 \
        || die "the planner seat did not take the prompt: is the team up? ('squad up')"
      say "the planner works on ${plan#"$REPO"/}; it tells the lead when it passes the check. Then: squad plan --approve${feature:+ $feature}" ;;
  esac
}

plan_gate() { # <task>: dies when the task's plan is not approved (only in a team with a planner)
  [ -n "$(first_role planner)" ] || return 0
  local f="$TEAM_DIR/PLAN.md" fp
  # a team that started before the planner has no PLAN.md: its work goes on, and only new features need a plan;
  # a new team gets a draft PLAN.md at init, so nothing starts there before the owner approves it
  [ ! -f "$f" ] || plan_approved "$f" || die "no task starts before $OWNER_NAME approves the plan: ${f#"$REPO"/} (the planner: squad plan \"<goal>\"; ${OWNER_NAME}: squad plan --approve)."
  fp=$(grep -m1 -E '^- Plan: F-[0-9]+' "$TEAM_DIR/tasks/$1.md" 2>/dev/null | grep -oE 'F-[0-9]+' || true)
  [ -z "$fp" ] || plan_approved "$TEAM_DIR/plan/$fp.md" || die "$1 belongs to feature plan $fp, which $OWNER_NAME has not approved yet (squad plan --approve $fp)."
  return 0
}

# ---- decisions -----------------------------------------------------------------------
# One block per decision in DECISIONS.md:
#   ## D-001 · <title>
#   - Time: / - Question: / - Options: / - Claude: / - GPT: / - Sources: /
#   - Decision: / - Why: / - Status: provisional — open decision for the owner | final
DECISION_FIELDS="Time Question Options Claude GPT Sources Decision Why Status See"   # See: optional

decisions_tsv() { # DECISIONS.md -> one line per decision: id \t title \t field=value ... (tabs)
  awk -v fields="$DECISION_FIELDS" '
    function flush() { if (id != "") { line = id "\t" title; for (k = 1; k <= nf; k++) line = line "\t" f[k] "=" v[f[k]]; print line } }
    BEGIN { nf = split(fields, f, " ") }
    /<!--/ { incomment = 1 }
    incomment { if ($0 ~ /-->/) incomment = 0; next }
    /^## D-[0-9]+/ { flush(); delete v; id = $2; title = $0; sub(/^## D-[0-9]+ *[·:-]? */, "", title); last = ""; next }
    /^## / { flush(); id = ""; next }
    id != "" && /^- [A-Za-z]+:/ { key = $2; sub(/:$/, "", key); val = $0; sub(/^- [A-Za-z]+: */, "", val); gsub(/\t/, " ", val); v[key] = val; last = key; next }
    id != "" && /^  +[^ ]/ && last != "" { t = $0; sub(/^ +/, "", t); v[last] = v[last] " " t; next }
    END { flush() }' "$TEAM_DIR/DECISIONS.md" 2>/dev/null
}

cmd_decisions() {
  find_repo; load_conf
  [ "${1:-}" = --check ] || { decisions_tsv | awk -F'\t' '{ s = ""; for (i = 3; i <= NF; i++) if ($i ~ /^Status=/) s = substr($i, 8); printf "%-6s %-14s %s\n", $1, substr(s, 1, 13), $2 }'; return 0; }
  local bad
  bad=$(decisions_tsv | awk -F'\t' '{ for (i = 3; i <= NF; i++) { split($i, kv, "="); val = substr($i, length(kv[1]) + 2)
           if (val ~ /^ *$/ && kv[1] != "See") print $1 ": no " kv[1]
           if (kv[1] == "Status" && val !~ /^(provisional|final|to test)/) print $1 ": Status must start with provisional, final or to test"
           if (kv[1] == "Status" && val ~ /^to test/) need_see = 1
           if (kv[1] == "See") see = val }
         if (need_see && see ~ /^ *$/) print $1 ": a decision to test needs a See line (where to look)"
         need_see = 0; see = "" }')
  [ -z "$bad" ] || { printf '%s\n' "$bad" >&2; die "DECISIONS.md: fill every field of each decision (fields: $DECISION_FIELDS)."; }
  # every decision, and every change of its status, goes into the ledger once
  local id st
  while IFS=$'\t' read -r id st; do
    [ -n "$id" ] || continue
    grep -qF " - DECISION $id $st" "$TEAM_DIR/events.log" 2>/dev/null || log_event "$LEAD" - DECISION "$id $st"
  done < <(decisions_tsv | awk -F'\t' '{ s = ""; for (i = 3; i <= NF; i++) if ($i ~ /^Status=/) { s = substr($i, 8); if (s ~ /^to test/) s = "to-test"; else sub(/ .*/, "", s) } print $1 "\t" s }')
  say "DECISIONS.md: $(decisions_tsv | grep -c . || true) decision(s), every field filled."
}

# ---- squad report: one page with everything the owner needs to follow the team ---------
# Built only from the team's plain files: events.log, DECISIONS.md, consult/,
# observer/, reports/, LESSONS.md, READY.md. --live: the same, in a terminal,
# refreshed every 20 s ('o' opens the HTML page). Default: write the HTML page.

# per task, from events.log: id state total dev test review wait changes fails blocked stalls cost
# (ids are escaped for HTML here: events.log is written from agents' input)
task_stats() { task_stats_raw | html_escape; }

task_stats_raw() {
  local roles="" i
  for ((i = 0; i < $(seat_count); i++)); do roles="$roles ${S_NAME[$i]}=${S_ROLE[$i]}"; done
  awk -v roles="$roles" '
    function dfc(y, m, d,   era, yoe, doy) { y -= (m <= 2); era = int((y >= 0 ? y : y - 399) / 400); yoe = y - era * 400
      doy = int((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1; return era * 146097 + yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy }
    BEGIN { n = split(roles, r, " "); for (k = 1; k <= n; k++) { split(r[k], kv, "="); role[kv[1]] = kv[2] } }
    {
      if ($1 ~ /^[0-9][0-9][0-9][0-9]-/) { split($1, d, "-"); split($2, t, ":"); day = dfc(d[1] + 0, d[2] + 0, d[3] + 0); s = $3; id = $4; ev = $5; f0 = 6 }
      else { split($1, t, ":"); if (t[1] * 3600 + t[2] * 60 + t[3] < prevsec) oldday++; day = oldday; s = $2; id = $3; ev = $4; f0 = 5 }
      prevsec = t[1] * 3600 + t[2] * 60 + t[3]
      now = day * 86400 + prevsec
      u = ""; cx = ""
      for (k = f0; k <= NF; k++) { if ($k ~ /^u=[0-9]/) { split(substr($k, 3), uu, "/"); u = uu[1] + 0 } else if ($k ~ /^u=\?/) u = "?"
                                   if ($k ~ /^c=[0-9]/) { split(substr($k, 3), uu, "/"); cx = uu[1] + 0 } else if ($k ~ /^c=\?/) cx = "?" }
      if (id == "-" || id == "") next
      if (!(id in first)) { first[id] = now; order[++nt] = id }
      last[id] = now
      key = s SUBSEP id
      if (ev == "DISPATCH") { open[key] = now; ou[key] = u; oc[key] = cx; if (role[s] == "dev") disp[id]++ }
      else if (ev ~ /^(DONE|BLOCKED|PASS|FAIL|APPROVE|CHANGES|CONTRACT)$/ && (key in open)) {
        dur = now - open[key]; st = role[s]
        if (st == "dev") dev[id] += dur; else if (st == "tester") tst[id] += dur; else rev[id] += dur
        # a reading that was unknown ("?") or that crossed a quota reset makes the cost of the task unknown, never 0
        if (u == "?" || ou[key] == "?" || (u == "") != (ou[key] == "")) unk[id] = 1; else if (u != "" && ou[key] != "") { if (u >= ou[key]) { cost[id] += u - ou[key]; meas[id] = 1 } else unk[id] = 1 }
        if (cx == "?" || oc[key] == "?" || (cx == "") != (oc[key] == "")) cunk[id] = 1; else if (cx != "" && oc[key] != "") { if (cx >= oc[key]) { ccost[id] += cx - oc[key]; cmeas[id] = 1 } else cunk[id] = 1 }
        delete open[key]
      }
      if (ev == "FAIL") fails[id]++
      if (ev == "BLOCKED") blk[id]++
      if (ev == "CHANGES") chg[id]++
      if (ev ~ /^(SEAT_)?(STALLED|DEAD|LOGIN)$/ || ev == "SEAT_BLOCKED") stl[id]++   # found by the watch (older logs: without SEAT_)
      if (ev == "MERGE" || ev == "CANDIDATE_MERGED") merged[id] = now
    }
    END { for (k = 1; k <= nt; k++) { id = order[k]; end = (id in merged) ? merged[id] : last[id]; tot = end - first[id]
            w = tot - dev[id] - tst[id] - rev[id]; if (w < 0) w = 0
            printf "%s\t%s\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%s\t%s\n", id, (id in merged) ? "merged" : "open", tot / 60, dev[id] / 60, tst[id] / 60, rev[id] / 60, w / 60, chg[id] + 0, fails[id] + 0, blk[id] + 0, stl[id] + 0, ((id in unk) || !(id in meas) ? "?" : cost[id] + 0), ((id in cunk) || !(id in cmeas) ? "?" : ccost[id] + 0) } }' \
    "$TEAM_DIR/events.log" 2>/dev/null || true
}

html_escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g' -e "s/'/\&#39;/g"; }

md_html() { # minimal Markdown -> HTML: headings, lists, tables, code, bold, links
  html_escape | awk '
    function inline(x) { gsub(/`[^`]+`/, "<code>&</code>", x); gsub(/<code>`/, "<code>", x); gsub(/`<\/code>/, "</code>", x)
      while (match(x, /\*\*[^*]+\*\*/)) x = substr(x, 1, RSTART - 1) "<b>" substr(x, RSTART + 2, RLENGTH - 4) "</b>" substr(x, RSTART + RLENGTH)
      o = ""; while (match(x, /https?:\/\/[^ )<]+/)) { u = substr(x, RSTART, RLENGTH); o = o substr(x, 1, RSTART - 1) "<a href=\"" u "\">" u "</a>"; x = substr(x, RSTART + RLENGTH) }
      return o x }
    function close_all() { if (inl) print "</ul>"; if (intab) print "</table></div>"; inl = 0; intab = 0 }
    /^#+ / { close_all(); h = match($0, /^#+/); lvl = RLENGTH + 1; if (lvl > 6) lvl = 6; print "<h" lvl ">" inline(substr($0, RLENGTH + 2)) "</h" lvl ">"; next }
    /^\|/ { if ($0 ~ /^\|[-: |]+\|$/) next
            if (!intab) { close_all(); print "<div class=tw><table>"; intab = 1; tag = "th" } else tag = "td"
            n = split($0, c, "|"); row = "<tr>"; for (k = 2; k < n; k++) row = row "<" tag ">" inline(c[k]) "</" tag ">"; print row "</tr>"; next }
    /^ *[-*] / { if (intab) close_all(); if (!inl) { print "<ul>"; inl = 1 } t = $0; sub(/^ *[-*] /, "", t); print "<li>" inline(t) "</li>"; next }
    /^ *[0-9]+\. / { if (intab) close_all(); if (!inl) { print "<ul>"; inl = 1 } t = $0; sub(/^ *[0-9]+\. /, "", t); print "<li>" inline(t) "</li>"; next }
    /^ *$/ { close_all(); next }
    { close_all(); print "<p>" inline($0) "</p>" }
    END { close_all() }'
}

report_section_file() { # <file> <empty text>
  if [ -s "$1" ]; then md_html <"$1"; else printf '<p class=empty>%s</p>\n' "$2"; fi
}

report_html() {
  local out="$TEAM_DIR/report.html" id title status fields k v cf
  {
    cat <<'HEAD'
<!doctype html><html lang=en><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1">
<title>squad report</title>
<style>
:root{--bg:#f7f7f5;--fg:#1d1d1b;--mut:#6b6b66;--card:#fff;--line:#e3e2dd;--acc:#2f5bd3;--warn:#b25b00;--ok:#1f7a4a;--bad:#b3261e;color-scheme:light}
@media (prefers-color-scheme:dark){:root{--bg:#141413;--fg:#ecebe6;--mut:#a3a29b;--card:#1e1e1c;--line:#34332f;--acc:#8fa8ff;--warn:#f0a35a;--ok:#5cc58e;--bad:#ff8a80;color-scheme:dark}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
header{padding:20px 16px 0;max-width:1100px;margin:auto}h1{margin:0 0 4px;font-size:22px}.sub{color:var(--mut);margin:0 0 12px}
nav{display:flex;flex-wrap:wrap;gap:6px;border-bottom:1px solid var(--line);padding-bottom:8px}
nav button,.f button{font:inherit;border:1px solid var(--line);background:var(--card);color:var(--fg);border-radius:999px;padding:6px 14px;cursor:pointer;min-height:36px}
nav button[aria-selected=true],.f button[aria-pressed=true]{background:var(--acc);border-color:var(--acc);color:#fff}
main{max-width:1100px;margin:auto;padding:16px}section[hidden]{display:none}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin:0 0 12px}
.card h3{margin:0 0 8px;font-size:16px}dl{display:grid;grid-template-columns:max-content 1fr;gap:4px 14px;margin:0}dt{color:var(--mut)}dd{margin:0;overflow-wrap:anywhere}
.badge{display:inline-block;font-size:12px;padding:2px 8px;border-radius:999px;border:1px solid currentColor;margin-left:6px}
.prov{color:var(--warn)}.final{color:var(--ok)}.empty{color:var(--mut)}
.tw{overflow-x:auto}table{border-collapse:collapse;width:100%;margin:8px 0}th,td{border-bottom:1px solid var(--line);padding:6px 8px;text-align:left;vertical-align:top}th{color:var(--mut);font-weight:600}
td.n{text-align:right;font-variant-numeric:tabular-nums}code{font-size:13px;background:color-mix(in srgb,var(--line) 50%,transparent);padding:1px 4px;border-radius:4px}
details{margin-top:8px}summary{cursor:pointer;color:var(--acc)}.f{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}a{color:var(--acc)}
pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px}
@media (prefers-reduced-motion:no-preference){nav button,.f button{transition:background .15s}}
</style>
HEAD
    printf '<header><h1>squad · %s</h1><p class=sub>Built %s from %s. Open again after <code>squad report</code>; the report tab in herdr refreshes by itself.</p>\n' \
      "$(basename "$REPO" | html_escape)" "$(date '+%Y-%m-%d %H:%M')" "$(echo "$TEAM_DIR" | html_escape)"
    echo '<nav role=tablist>'
    for k in "To test" Decisions Observer Timeline QA Cost Events; do printf '<button role=tab data-t="%s">%s</button>' "${k// /-}" "$k"; done
    echo '</nav></header><main>'

    # To test: what the human looks at, where, and the feedback still open
    echo '<section id=To-test><div class=card><h3>To test</h3><p class=sub>Decisions that change what you see. Look where it says, then answer with <code>squad feedback "…"</code>.</p>'
    local tt; tt=$(decisions_tsv | awk -F'\t' '{ s = ""; see = ""; d = ""; for (i = 3; i <= NF; i++) { if ($i ~ /^Status=/) s = substr($i, 8); if ($i ~ /^See=/) see = substr($i, 5); if ($i ~ /^Decision=/) d = substr($i, 10) }
        if (see == "") see = "-"; if (d == "") d = "-"   # no empty field: read joins empty tab fields
        if (s ~ /^(to test|provisional)/) print $1 "\t" $2 "\t" see "\t" d }')
    if [ -n "$tt" ]; then
      echo '<div class=tw><table><tr><th>Decision</th><th>Where to look</th><th>What was decided</th></tr>'
      while IFS=$'\t' read -r id title see d; do
        printf '<tr><td>%s · %s</td><td>%s</td><td>%s</td></tr>\n' "$(html_escape <<<"$id")" "$(html_escape <<<"$title")" "$(html_escape <<<"${see:-—}")" "$(html_escape <<<"$d")"
      done <<<"$tt"
      echo '</table></div>'
    else
      echo '<p class=empty>Nothing to test right now.</p>'
    fi
    echo '</div><div class=card><h3>Your feedback</h3>'; report_section_file "$TEAM_DIR/FEEDBACK.md" "No feedback yet."
    echo '</div></section>'

    # Decisions
    echo '<section id=Decisions><div class=f><button data-f=all aria-pressed=true>All</button><button data-f=prov aria-pressed=false>Open for the owner</button><button data-f=final aria-pressed=false>Final</button></div>'
    if [ -n "$(decisions_tsv)" ]; then
      while IFS=$'\t' read -r id title fields; do
        status=$(tr '\t' '\n' <<<"$fields" | sed -n 's/^Status=//p')
        case "$status" in final*) k=final ;; *) k=prov ;; esac   # provisional and "to test" both wait for the owner
        printf '<div class="card dec" data-k=%s><h3>%s · %s<span class="badge %s">%s</span></h3><dl>\n' "$k" "$(html_escape <<<"$id")" "$(html_escape <<<"$title")" "$k" "$(html_escape <<<"${status:-no status}")"
        while IFS= read -r v; do
          [ -n "$v" ] || continue
          printf '<dt>%s</dt><dd>%s</dd>\n' "${v%%=*}" "$(printf '%s\n' "${v#*=}" | md_html | sed 's#^<p>##; s#</p>$##')"
        done < <(tr '\t' '\n' <<<"$fields")
        echo '</dl>'
        for cf in $(tr '\t' '\n' <<<"$fields" | sed -n 's/^GPT=//p' | grep -oE 'consult/[0-9]+\.md' || true); do
          [ -f "$TEAM_DIR/$cf" ] && { printf '<details><summary>GPT consult (%s)</summary>' "$cf"; md_html <"$TEAM_DIR/$cf"; echo '</details>'; }
        done
        echo '</div>'
      done < <(decisions_tsv)
    else
      echo '<p class=empty>No decisions recorded yet (DECISIONS.md).</p>'
    fi
    echo '</section>'

    # Observer
    echo '<section id=Observer><div class=card><h3>Now</h3>'; report_section_file "$TEAM_DIR/observer/NOW.md" "The observer has not written a pass yet."
    echo '</div><div class=card><h3>Suggestions</h3>'; report_section_file "$TEAM_DIR/observer/SUGGESTIONS.md" "No suggestions yet."
    echo '</div><div class=card><h3>Lessons for the next run</h3>'; report_section_file "$TEAM_DIR/LESSONS.md" "No lessons yet (written at the end of a run)."
    echo '</div></section>'

    # Timeline and Cost from the same numbers
    echo '<section id=Timeline><div class=card><h3>Minutes per task</h3><p class=sub>From events.log: dispatch to report per seat; wait = the rest (queues, the lead, the human).</p><div class=tw><table><tr><th>Task</th><th>State</th><th>Total</th><th>Dev</th><th>Test</th><th>Review</th><th>Wait</th></tr>'
    task_stats | awk -F'\t' '{ printf "<tr><td>%s</td><td>%s</td><td class=n>%d</td><td class=n>%d</td><td class=n>%d</td><td class=n>%d</td><td class=n>%d</td></tr>\n", $1, $2, $3, $4, $5, $6, $7 }'
    echo '</table></div></div></section>'

    echo '<section id=QA><div class=card><h3>Quality per task</h3><div class=tw><table><tr><th>Task</th><th>Contract</th><th>Review rounds</th><th>Changes asked</th><th>Tester FAIL</th><th>BLOCKED</th><th>Stops</th><th>Rows not verified (latest test)</th></tr>'
    task_stats | while IFS=$'\t' read -r id _ _ _ _ _ _ chg fails blk stl _ _; do
      local nv="" rounds contract
      rounds=$(( $(review_round "$id") - 1 ))
      contract=no; [ -f "$TEAM_DIR/reports/$id-contract.md" ] && contract=yes
      [ -f "$TEAM_DIR/reports/$id-test.md" ] && nv=$(report_rows "$TEAM_DIR/reports/$id-test.md" | awk '$2 != "pass" { printf "%s%s(%s)", (n++ ? ", " : ""), $1, $2 }')
      printf '<tr><td>%s</td><td>%s</td><td class=n>%s</td><td class=n>%s</td><td class=n>%s</td><td class=n>%s</td><td class=n>%s</td><td>%s</td></tr>\n' "$id" "$contract" "$rounds" "$chg" "$fails" "$blk" "$stl" "${nv:-—}"
    done
    echo '</table></div></div></section>'

    echo '<section id=Cost><div class=card><h3>Cost per task</h3><p class=sub>Minutes from events.log. Claude and Codex 5-hour usage in percentage points, measured between dispatch and report when it was recorded; plan windows are shared by all seats, so this is an estimate, not exact tokens.</p><div class=tw><table><tr><th>Task</th><th>Seat minutes (dev + test + review)</th><th>Claude 5h points</th><th>Codex 5h points</th></tr>'
    task_stats | awk -F'\t' '{ printf "<tr><td>%s</td><td class=n>%d</td><td class=n>%s</td><td class=n>%s</td></tr>\n", $1, $4 + $5 + $6, ($12 == "?" ? "?" : ($12 > 0 ? $12 : "—")), ($13 == "?" ? "?" : ($13 > 0 ? $13 : "—")) }'
    echo '</table></div></div></section>'

    echo '<section id=Events><div class=card><h3>Last 200 events</h3><pre>'
    { tail -200 "$TEAM_DIR/events.log" 2>/dev/null || true; } | html_escape
    echo '</pre></div></section></main>'
    cat <<'FOOT'
<script>
const tabs=[...document.querySelectorAll('nav button')],secs=[...document.querySelectorAll('main section')];
function show(t){tabs.forEach(b=>b.setAttribute('aria-selected',b.dataset.t===t));secs.forEach(s=>s.hidden=s.id!==t);try{localStorage.setItem('squad-tab',t)}catch(e){}}
tabs.forEach(b=>b.onclick=()=>show(b.dataset.t));let t='To-test';try{t=localStorage.getItem('squad-tab')||t}catch(e){}show(t);
document.querySelectorAll('.f button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.f button').forEach(x=>x.setAttribute('aria-pressed',x===b));
document.querySelectorAll('.dec').forEach(c=>c.hidden=!(b.dataset.f==='all'||c.dataset.k===b.dataset.f))});
</script>
FOOT
  } >"$out.tmp.$$" && mv "$out.tmp.$$" "$out"
  echo "$out"
}

report_text() { # the live view: what each seat does now, what waits for the owner, then the history
  local w=${COLUMNS:-$([ -t 1 ] && tput cols 2>/dev/null || echo 100)} e=$'\033' agents i name role st tp task phase when title icon ic pc rc line n
  rgb() { printf '%s[38;2;%d;%d;%dm' "$e" "$((16#${1:1:2}))" "$((16#${1:3:2}))" "$((16#${1:5:2}))"; }
  local R="${e}[0m" B="${e}[1m" D="${e}[2m" GRN RED YEL BLU MAU PNK PCH TXT SUB SURF
  if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then rgb() { :; }; R=""; B=""; D=""; fi   # no colour: the same lines, plain
  GRN=$(rgb '#a6e3a1'); RED=$(rgb '#f38ba8'); YEL=$(rgb '#f9e2af'); BLU=$(rgb '#89b4fa'); MAU=$(rgb '#cba6f7')
  PNK=$(rgb '#f5c2e7'); PCH=$(rgb '#fab387'); TXT=$(rgb '#cdd6f4'); SUB=$(rgb '#7f849c'); SURF=""; [ -z "$R" ] || SURF="${e}[48;2;49;50;68m"
  role_c() { case "$1" in lead) printf '%s' "$MAU" ;; dev) printf '%s' "$BLU" ;; tester) printf '%s' "$GRN" ;; reviewer) printf '%s' "$YEL" ;;
    observer) printf '%s' "$PNK" ;; planner) rgb '#b4befe' ;; critic) printf '%s' "$PCH" ;; *) printf '%s' "$TXT" ;; esac; }
  phase_c() { case "$1" in *PASSED|MERGED|APPROVED|"PLAN APPROVED") printf '%s' "$GRN" ;; *FAILED|"CHANGES ASKED"|BLOCKED|"NEEDS YOU") printf '%s' "$RED" ;;
    WAITS*|"CONTRACT WRITTEN"|"IN CRITIQUE") printf '%s' "$YEL" ;; idle|WATCHING|DONE) printf '%s' "$SUB" ;; *) printf '%s' "$BLU" ;; esac; }
  fit() { local LC_ALL=en_US.UTF-8 n=$1 x=$2; [ "$n" -gt 1 ] || n=1   # <n> <text>: at most n characters, the last one "…" when cut
    if [ "${#x}" -le "$n" ]; then printf '%s' "$x"; else printf '%s…' "${x:0:$((n - 1))}"; fi; }
  ev_phase() { case "$1" in PASS) echo "TEST PASSED" ;; FAIL) echo "TEST FAILED" ;; MERGE) echo MERGED ;; APPROVE) echo APPROVED ;; CHANGES) echo "CHANGES ASKED" ;; BLOCKED) echo BLOCKED ;; *) echo x ;; esac; }
  head_() { printf '\n %s▍%s%s%s %s%s%s\n' "$2" "$R$B" "$1" "$R" "$D" "${3:-}" "$R"; }
  # the header band: the team in one line
  local merged total own lock needs=0
  merged=$(grep -cE '^\| *T-[^|]*\|[^|]*\|[^|]*\| *\**merged' "$TEAM_DIR/TASKS.md" 2>/dev/null || true)
  total=$(grep -cE '^\| *T-[0-9]' "$TEAM_DIR/TASKS.md" 2>/dev/null || true)
  own=$(heavy_owner | cut -d: -f1,3); lock="lock free"; [ -z "$own" ] || lock="lock: ${own%%@*} $(( ($(date +%s) - ${own##*:}) / 60 ))m"
  agents=$(herdr_team agent list 2>/dev/null) || agents=""
  jq -e '.result.agents | type == "array"' <<<"$agents" >/dev/null 2>&1 || agents='{"result":{"agents":[]}}'   # herdr away or an error: every seat shows off
  needs=$(jq --arg s " ${S_NAME[*]} " '[.result.agents[] | select(.agent_status == "blocked" and (.name as $n | $s | contains(" " + $n + " ")))] | length' <<<"$agents" 2>/dev/null || echo 0)
  [ -z "$R" ] || printf '%s[H%s[2J' "$e" "$e"
  line=" squad · $(basename "$REPO")   ${merged:-0}/${total:-0} merged   $lock   $([ "${needs:-0}" -gt 0 ] && echo "$needs need you" || echo "nobody waits")"
  printf '%s%s%s%s' "$SURF" "$B$TXT" "$line" "$R$SURF"
  printf '%*s' $(( w - ${#line} - 26 > 0 ? w - ${#line} - 26 : 1 )) ''
  printf '%s%s o: HTML page · q: quit  %s\n' "$D" "$SUB" "$R"
  # 1. each seat: what it does now
  head_ "NOW" "$BLU" "$(date +%H:%M)"
  for ((i = 0; i < $(seat_count); i++)); do
    name=${S_NAME[$i]}; role=${S_ROLE[$i]}
    st=$(jq -r --arg n "$name" '[.result.agents[] | select(.name == $n) | .agent_status][0] // "off"' <<<"$agents" 2>/dev/null) || st=off
    tp=$(seat_phase "$name" "$role" || true); [ -n "$tp" ] || tp="|||"; task=${tp%%|*}; tp=${tp#*|}; phase=${tp%%|*}; tp=${tp#*|}; when=$(ago_min "${tp%%|*}")
    phase=$(seat_follow "$task" "$phase" "$role" "${tp#*|}")
    title=""; case "$task" in T-*) title=$(task_title "$task") ;; esac
    case "$st" in working) icon="●"; ic=$GRN ;; blocked) icon="◆"; ic=$RED; phase="NEEDS YOU" ;; idle|done) icon="○"; ic=$SUB ;; *) icon="·"; ic=$SUB; phase=off ;; esac
    if [ "$role" = observer ]; then task=""; title=""; when=""; case "$phase" in "NEEDS YOU"|off) ;; *) phase=WATCHING ;; esac; fi
    if [ "$role" = planner ] && [ -n "$(plan_state)" ]; then local pl; pl=$(plan_state); task=${pl%%|*}; pl=${pl#*|}; case "$phase" in "NEEDS YOU"|off) ;; *) phase=${pl%%|*} ;; esac; pl=${pl#*|}; when=${pl%%|*}; title=${pl#*|}; fi
    [ -n "$phase" ] || phase=idle
    rc=$(role_c "$role"); pc=$(phase_c "$phase")
    printf '  %s%s%s %s%-9s%s %s%-8s%s %s%-15s%s %s%-14s%s %s%s%s %s%s%s\n' "$ic" "$icon" "$R" "$B$rc" "$name" "$R" "$rc$D" "$role" "$R" "$pc$B" "$phase" "$R" \
      "$TXT" "${task:-}" "$R" "$TXT" "$([ $((w - 76)) -lt 8 ] || fit $((w - 76)) "$title")" "$R" "$SUB" "$when" "$R"
  done
  # 2. what waits for the owner
  local tt fb; fb=$(grep -c '^- Status: open' "$TEAM_DIR/FEEDBACK.md" 2>/dev/null || true); [ "${fb:-0}" != 0 ] || fb=""
  tt=$(decisions_tsv | awk -F'\t' '{ s = ""; see = ""; for (i = 3; i <= NF; i++) { if ($i ~ /^Status=/) s = substr($i, 8); if ($i ~ /^See=/) see = substr($i, 5) } if (s !~ /^final/) print $1 "\t" $2 "\t" see }' | head -8 || true)
  n=$(printf '%s' "$tt" | grep -c . || true)
  head_ "WAITS FOR $(printf '%s' "$OWNER_NAME" | tr '[:lower:]' '[:upper:]')" "$YEL" "$n to test · then: squad feedback \"…\"${fb:+ · your feedback open: $fb}"
  if [ -z "$tt" ]; then printf '  %snothing to test%s\n' "$SUB" "$R"; else
    while IFS=$'\t' read -r id what see; do
      printf '  %s%s%s  %s%s%s\n' "$YEL$B" "$id" "$R" "$TXT" "$(fit $((w - 10)) "$what")" "$R"
      printf '         %slook:%s %s%s%s\n' "$SUB" "$R" "$D" "$(fit $((w - 16)) "${see:-?}")" "$R"
    done <<<"$tt"
  fi
  # 3. the observer: the newest pass; repeated passes fold into one line
  head_ "OBSERVER" "$PNK" "every 20 min"
  if [ -s "$TEAM_DIR/observer/NOW.md" ]; then
    awk -v w="$w" -v sub_="$SUB" -v t="$TXT" -v r="$R" '
      /^# / { h[++np] = $0; next } /^Largest loss:/ && np { l[np] = $0 }
      END { if (!np) exit; same = 1; while (same < np && l[same + 1] == l[1]) same++
        x = h[1]; sub(/^# */, "", x); print sub_ "\t" x
        y = l[1]; sub(/^Largest loss: */, "", y); print t "\tLargest loss: " y
        if (same > 1) { z = h[same]; sub(/^# */, "", z); print sub_ "\tthe same for " same " passes (since " z ")" } }' "$TEAM_DIR/observer/NOW.md" | while IFS=$'\t' read -r c x; do printf '  %s%s%s\n' "$c" "$(fit $((w - 4)) "$x")" "$R"; done
  else printf '  %sno pass yet%s\n' "$SUB" "$R"; fi
  local open_s; open_s=$(awk '/^## / { t = $0 } tolower($0) ~ /^- status: *open/ && t != "" { sub(/^#+ */, "", t); print t; t = "" }' "$TEAM_DIR/observer/SUGGESTIONS.md" 2>/dev/null | head -4 || true)
  [ -z "$open_s" ] || printf '%s\n' "$open_s" | while IFS= read -r s; do printf '  %s→%s %s\n' "$PNK" "$R" "$(fit $((w - 6)) "$s")"; done
  # 4. tasks: the status in colour; a long wait for the lead stands out
  head_ "TASKS" "$GRN" "minutes: total · dev · test · review · wait │ changes · fails │ cost: Claude · Codex 5h points"
  task_stats_raw | tail -12 | while IFS=$'\t' read -r id stt tot dv te rv wt ch fl _ _ cc cx _; do
    case "$stt" in merged) pc=$GRN ;; open) pc=$BLU ;; *) pc=$SUB ;; esac
    local wc=$TXT fc=$TXT; [ "${wt:-0}" -ge 60 ] && wc=$PCH; [ "${fl:-0}" -gt 0 ] && fc=$RED
    printf '  %s%-15s%s %s%-7s%s %s%5s · %4s · %4s · %4s · %s%5s%s │ %s · %s%s%s │ %s%s · %s%s\n' "$B$TXT" "$id" "$R" "$pc" "$stt" "$R" "$TXT" "$tot" "$dv" "$te" "$rv" "$wc" "$wt" "$TXT" "$ch" "$fc" "$fl" "$R" "$SUB" "${cc:-0}" "${cx:-0}" "$R"
  done
  # 5. the newest events, without the observer's routine passes
  head_ "EVENTS" "$MAU" "newest last"
  { awk '$1 !~ /^[0-9][0-9][0-9][0-9]-/ { $0 = "- " $0 } $5 != "OBSERVE" && NF >= 5' "$TEAM_DIR/events.log" 2>/dev/null || true; } | tail -6 | while read -r _ tm seat tk ev rest; do   # an older log has no date
    pc=$(phase_c "$(ev_phase "$ev")")
    rc=$TXT; for ((i = 0; i < $(seat_count); i++)); do [ "${S_NAME[$i]}" != "$seat" ] || rc=$(role_c "${S_ROLE[$i]}"); done
    printf '  %s%s%s  %s%-10s%s %-15s %s%s%s %s%s%s\n' "$SUB" "${tm%:*}" "$R" "$rc" "$seat" "$R" "$tk" "$pc$B" "$ev" "$R" "$D" "$([ $((w - 50)) -lt 8 ] || fit $((w - 50)) "$rest")" "$R"
  done
}

open_url() { if command -v open >/dev/null 2>&1; then open "$1"; elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1"; fi; }

cmd_report() {
  find_repo; load_conf
  case "${1:-}" in
    --live)
      local key=""
      while :; do
        report_text
        report_html >/dev/null
        key=""; read -rsn1 -t 20 key || true
        case "$key" in o|O) open_url "$TEAM_DIR/report.html" ;; q|Q) return 0 ;; esac
      done ;;
    --open) open_url "$(report_html)" ;;
    *) report_html ;;
  esac
}

# ---- squad feedback: the human's answer after testing what can be seen ---------------
# squad feedback "<text>" | squad feedback --file <path>
cmd_feedback() {
  find_repo; load_conf
  local text n
  case "${1:-}" in
    --file) [ -f "${2:-}" ] || die "usage: squad feedback --file <path>"; text=$(cat "$2") ;;
    "") die "usage: squad feedback \"<what you saw and what you want>\"  (or --file <path>)" ;;
    *) text="$*" ;;
  esac
  [ -n "${text//[[:space:]]/}" ] || die "the feedback is empty."
  mutex "$TEAM_DIR/.feedback.lock"   # create, number and append under one lock
  [ -f "$TEAM_DIR/FEEDBACK.md" ] || cp "$TEMPLATES/FEEDBACK.md" "$TEAM_DIR/FEEDBACK.md"
  # the highest F-number + 1: a pasted note with its own headings, or a deleted entry, never repeats an id
  n=$(( $(sed -n 's/^## F-\([0-9][0-9]*\) · .*/\1/p' "$TEAM_DIR/FEEDBACK.md" | sort -n | tail -1 || true) + 1 ))
  printf '\n## F-%s · %s\n\n%s\n\n- Status: open\n' "$n" "$(date '+%Y-%m-%d %H:%M')" "$text" >>"$TEAM_DIR/FEEDBACK.md"
  rmdir "$TEAM_DIR/.feedback.lock"
  log_event owner - FEEDBACK "F-$n $(printf '%s' "$text" | head -1 | cut -c1-80)"
  if herdr_team agent prompt "$LEAD" "[squad] Feedback F-$n from $OWNER_NAME in $TEAM_DIR/FEEDBACK.md: $(printf '%s' "$text" | head -1 | cut -c1-120). Turn it into a brief or a decision, then mark F-$n done with its id. (Notification: first finish what you were doing.)" >/dev/null 2>&1; then
    say "F-$n saved and sent to $LEAD."
  else
    say "F-$n saved in .team/FEEDBACK.md; the lead could not be reached now and will read it at its next start."
  fi
}

# ---- the verify switch -----------------------------------------------------------
# the owner's global Stop hook runs the whole repository's verify at every turn end;
# in a team that is a heavy run outside the lock. verify_hook off writes the
# file that hook already honours into every team worktree.
apply_verify_switch() {
  local wt exclude
  exclude="$GIT_COMMON/info/exclude"
  for wt in "$WT_ROOT"/*/; do
    [ -d "$wt" ] || continue
    if [ "$VERIFY_HOOK" = off ]; then : >"${wt}.agents-verify-off"; else rm -f "${wt}.agents-verify-off"; fi
  done
  if [ "$VERIFY_HOOK" = off ]; then
    mkdir -p "$(dirname "$exclude")"
    grep -qxF '.agents-verify-off' "$exclude" 2>/dev/null || printf '.agents-verify-off\n' >>"$exclude"
  fi
}

# squad herdr <args> — herdr, bound to the session of the team this directory
# belongs to. One stable command for every project, so one permission rule
# (squad permissions) covers them all.
cmd_herdr() {
  find_repo
  local sock; sock=$(cat "$TEAM_DIR/herdr.sock" 2>/dev/null || true)
  if [ -n "$sock" ]; then HERDR_SOCKET_PATH=$sock exec herdr "$@"; else exec herdr "$@"; fi
}

# ---- usage ---------------------------------------------------------------------
# Plan usage per vendor, as JSON {p5,r5,p7,r7}: percent used and reset time
# (epoch seconds) of the 5-hour and 7-day windows. Codex writes rate_limits into
# its session files; Claude passes them to its status line, which 'squad
# statusline' saves. Missing data prints nothing.
CLAUDE_USAGE="${XDG_CACHE_HOME:-$HOME/.cache}/squad/claude-usage.json"

usage_codex() {
  local dir="${CODEX_HOME:-$HOME/.codex}/sessions" f
  [ -d "$dir" ] || return 0
  f=$(find "$dir" -name 'rollout-*.jsonl' -mtime -7 -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -1)
  [ -n "$f" ] || return 0
  grep '"rate_limits"' "$f" | tail -1 \
    | jq -c '[.. | objects | select(.rate_limits? and (.rate_limits | type) == "object") | .rate_limits][0] // empty
             | {p5: .primary.used_percent, r5: .primary.resets_at, p7: .secondary.used_percent, r7: .secondary.resets_at}' 2>/dev/null
}

usage_claude() { [ -f "$CLAUDE_USAGE" ] && jq -c '{p5, r5, p7, r7}' "$CLAUDE_USAGE" 2>/dev/null; return 0; }

# bar <percent> <resets_at> -> "▓▓░░░ 41%" (a window past its reset shows 0%)
bar() {
  local pct=${1:-} reset=${2:-} now cells i out=""
  [ -n "$pct" ] && [ "$pct" != null ] || { printf '%s' "  —  "; return; }
  now=$(date +%s)
  if [ -n "$reset" ] && [ "$reset" != null ] && [ "${reset%.*}" -le "$now" ]; then pct=0; fi
  pct=${pct%.*}
  cells=$(( (pct + 10) / 20 )); [ "$cells" -gt 5 ] && cells=5
  for ((i = 0; i < 5; i++)); do if [ "$i" -lt "$cells" ]; then out="${out}▓"; else out="${out}░"; fi; done
  printf '%s %3s%%' "$out" "$pct"
}

usage_line() { # one line: Claude always, another vendor only when it has data
  local name json line="" r5 when
  for name in Claude Codex; do
    if [ "$name" = Claude ]; then json=$(usage_claude); else json=$(usage_codex); fi
    if [ -z "$json" ]; then
      [ "$name" = Claude ] && line="$line$name —   "
      continue
    fi
    line="$line$name 5h $(bar "$(jq -r .p5 <<<"$json")" "$(jq -r .r5 <<<"$json")") 7d $(bar "$(jq -r .p7 <<<"$json")" "$(jq -r .r7 <<<"$json")")"
    # nearly used up: when does it come back?
    r5=$(jq -r --argjson now "$(date +%s)" 'if (.p5 // 0) >= 80 and (.r5 // 0) > $now then .r5 else empty end' <<<"$json")
    if [ -n "$r5" ] && [ "$r5" != null ]; then
      when=$(date -r "${r5%.*}" '+%H:%M' 2>/dev/null || date -d "@${r5%.*}" '+%H:%M' 2>/dev/null)
      line="$line (5h back $when)"
    fi
    line="$line   "
  done
  printf '%s\n' "${line%   }"
}

cmd_usage() { usage_line; }

# squad statusline — Claude Code status line: saves the plan usage Claude
# passes on stdin (for 'squad watch') and prints a compact line.
cmd_statusline() {
  local input model
  input=$(cat)
  mkdir -p "$(dirname "$CLAUDE_USAGE")"
  jq -c '.rate_limits // empty | {p5: .five_hour.used_percentage, r5: .five_hour.resets_at, p7: .seven_day.used_percentage, r7: .seven_day.resets_at}' \
    <<<"$input" 2>/dev/null >"$CLAUDE_USAGE.tmp" && [ -s "$CLAUDE_USAGE.tmp" ] && mv "$CLAUDE_USAGE.tmp" "$CLAUDE_USAGE"
  rm -f "$CLAUDE_USAGE.tmp"
  model=$(jq -r '.model.display_name // empty' <<<"$input" 2>/dev/null)
  local json; json=$(usage_claude)
  if [ -n "$json" ]; then
    printf '%s  5h %s  7d %s\n' "$model" "$(bar "$(jq -r .p5 <<<"$json")" "$(jq -r .r5 <<<"$json")")" "$(bar "$(jq -r .p7 <<<"$json")" "$(jq -r .r7 <<<"$json")")"
  else
    printf '%s\n' "$model"
  fi
}

# squad watch — the live board in the team tab, refreshed every 20 s:
#   plan usage · progress of the whole goal · every task with its state and
#   owner · every seat's state and the last event.
# Colour only on a terminal (and never with NO_COLOR), so --once stays plain.
# ---- trouble: dead, login, blocked and stalled seats ---------------------------
# A seat that stops on a sign-in error, a prompt, or simply stops working with a
# task open sends no message. The watch loop finds it, shows it in red, writes
# one line to events.log and tells the lead once (hive: 72 min unseen).
seat_trouble() { # <agents json> <index> <open task or ""> -> dead|login|blocked|stalled|""
  local json=$1 i=$2 task=$3 name state text since now f
  name=${S_NAME[$i]}
  state=$(seat_state "$json" "$name")
  f="$TEAM_DIR/observer/.seen/$name"
  now=$(date +%s)
  if [ "$state" = working ]; then rm -f "$f"; return 0; fi
  if [ "$state" = off ]; then [ -n "$task" ] && echo dead; return 0; fi
  text=$(herdr_team agent read "$name" --source visible 2>/dev/null | tail -12 || true)
  case "$text" in *"Please run /login"*|*"API Error: 401"*|*"API Error: 403"*|*"OAuth token has expired"*|*"Invalid API key"*) echo login; return 0 ;; esac
  [ "$state" = blocked ] && { echo blocked; return 0; }
  [ -n "$task" ] || { rm -f "$f"; return 0; }
  # busy, not stalled: the seat's own heavy run is alive, or it waits in the heavy queue or on background work
  if seat_busy "$name"; then rm -f "$f"; return 0; fi
  mkdir -p "$(dirname "$f")"
  [ -f "$f" ] || echo "$now" >"$f"
  since=$(cat "$f")
  [ $((now - since)) -ge $((STALL_MINUTES * 60)) ] && echo stalled
  return 0
}

trouble_hint() { # <kind> <seat>
  case "$1" in
    dead) echo "its agent is gone (closed pane or crash): run 'squad up' to start it again" ;;
    login) echo "it shows a sign-in error: $OWNER_NAME must run /login in its pane" ;;
    blocked) echo "it waits on a prompt or a question: read it with squad herdr agent read $2 --source visible" ;;
    stalled) echo "it has an open task and has not worked for $STALL_MINUTES min: read its pane, then re-send or re-dispatch" ;;
  esac
}

alert_trouble() { # <index> <trouble> <task>: once per seat and kind
  local name=${S_NAME[$1]} kind=$2 task=$3 f hint
  f="$TEAM_DIR/observer/.alerted/$name"
  mkdir -p "$(dirname "$f")"
  if [ "$(cat "$f" 2>/dev/null)" = "$kind" ]; then
    [ -e "$f.untold" ] || return 0   # logged, and the lead could not be told yet (it showed a dialog): only the message, again
  else
    echo "$kind" >"$f"; rm -f "$f.untold"
    # the watch's own finding, never the seat's report: SEAT_BLOCKED is not the BLOCKED a seat reports with squad done
    log_event "$name" "${task:--}" "SEAT_$(echo "$kind" | tr '[:lower:]' '[:upper:]')"
  fi
  hint=$(trouble_hint "$kind" "$name")
  [ "$name" = "$LEAD" ] && return 0
  if tell_lead "[squad] $name is $kind${task:+ on $task}: $hint. (Notification: first finish what you were doing.)"; then rm -f "$f.untold"; else : >"$f.untold"; fi
}

idle_dev_check() { # <index> <state> <open task>: a dev with nothing to do (GUPP: work on the hook gets run)
  local name=${S_NAME[$1]} f a now since
  f="$TEAM_DIR/observer/.idle/$name"; a="$TEAM_DIR/observer/.idle/$name.told"
  [ "$IDLE_MINUTES" -gt 0 ] || return 0
  if [ -n "$3" ] || [ "$2" = working ] || [ "$2" = off ] || seat_busy "$name"; then rm -f "$f" "$a" "$a.owner"; return 0; fi
  mkdir -p "$(dirname "$f")"; now=$(date +%s)
  [ -f "$f" ] || echo "$now" >"$f"
  since=$(cat "$f")
  if [ $((now - since)) -ge $((IDLE_MINUTES * 60)) ] && [ ! -f "$a" ] \
     && tell_lead "[squad] $name has had no task for $(( (now - since) / 60 )) min: write its next brief and dispatch it (squad dispatch $name <ID>). (Notification: first finish what you were doing.)"; then
    : >"$a"   # told; a lead that shows a dialog is told at a later tick
    log_event "$name" - IDLE "no task for $(( (now - since) / 60 )) min"
  fi
  # the lead was told and nothing happened: after IDLE_OWNER_MINUTES the owner is told once, when tasks are open (ticket 024)
  if [ $((now - since)) -ge $((IDLE_OWNER_MINUTES * 60)) ] && [ -f "$a" ] && [ ! -f "$a.owner" ]; then
    local open; open=$(awk -F'|' '/^\| *T-[0-9]/ { st = $5; gsub(/^ +| +$/, "", st); if (st != "merged") n++ } END { print n + 0 }' "$TEAM_DIR/TASKS.md" 2>/dev/null || echo 0)
    [ "$open" -gt 0 ] || return 0
    : >"$a.owner"
    log_event "$name" - IDLE "no task for $(( (now - since) / 60 )) min, $open open task(s): $OWNER_NAME is told"
    v_notify "squad: $name has no task" "$name has had no task for $(( (now - since) / 60 )) min; $open open task(s) in TASKS.md."
  fi
}

# The watchdog (observer S-48), from the team tab's strip: it tells the owner when the team stalls while
# work waits for the lead, when a seat stops at its usage limit, and when Claude's week reaches 80 %.
# ---- herdr's own sidebar shows the squad (ticket 016) -------------------------------
# Each seat's Agents entry: its role, ticket, task and phase (display-only metadata; herdr keeps
# owning the agent's state). The workspace entry: the team's progress. The Agents list shows only
# squad's seats, the ones that need the owner first. Sent when something changed, and again after
# a herdr restart (it forgets metadata and views).
task_title() { awk -F'|' -v id="$1" '{ t = $2; gsub(/^ +| +$/, "", t) } t == id { x = $3; gsub(/^ +| +$/, "", x); gsub(/`/, "", x); sub(/ \[.*/, "", x); print x; exit }' "$TEAM_DIR/TASKS.md" 2>/dev/null || true; }   # <ID> -> its title in TASKS.md

seat_phase() { # <seat> <role> -> "TASK|PHASE|EPOCH" from its newest event, the phase in plain words
  awk -v s="$1" -v r="$2" '{ if ($1 ~ /^[0-9][0-9][0-9][0-9]-/) { a = $3; k = $4; v = $5; ww = $1 " " $2 } else { a = $2; k = $3; v = $4; ww = "" } }   # an older log has no date
    a == s && k != "-" && v ~ /^(DISPATCH_FAILED|DISPATCH_NOT_STARTED)$/ && k == t && e == "DISPATCH" { e = v; d = $0; w = ww; at = NR; next }   # only the attempt it ends: a queued task that times out leaves the running one
    a == s && k != "-" && v ~ /^(DISPATCH|DONE|PASS|FAIL|APPROVE|CHANGES|BLOCKED|HEAVY_START|HEAVY_END|MERGE|CONTRACT)$/ { t = k; e = v; d = $0; w = ww; at = NR }
    END { if (t == "") { print "|||"; exit }
      if (e == "DISPATCH") {
        if (r == "dev") p = "CODING"
        else if (r == "tester") p = (index(d, "contract=1") ? "WRITING CONTRACT" : (t ~ /^CANDIDATE-/ ? "TESTING CANDIDATE" : "TESTING"))
        else if (r == "reviewer") p = "REVIEWING"
        else if (r == "planner") p = "PLANNING"
        else p = "WORKING" }
      else if (e == "DISPATCH_FAILED" || e == "DISPATCH_NOT_STARTED") p = "NOT STARTED"
      else if (e == "HEAVY_START") p = "RUNNING CHECKS"
      else if (e == "HEAVY_END") p = (index(d, "rc=0 ") ? "CHECKS PASSED" : "CHECKS FAILED")
      else if (e == "DONE") p = (r == "dev" ? "WAITS FOR TEST" : "DONE")
      else if (e == "PASS") p = "TEST PASSED"
      else if (e == "FAIL") p = "TEST FAILED"
      else if (e == "APPROVE") p = "APPROVED"
      else if (e == "CHANGES") p = "CHANGES ASKED"
      else if (e == "MERGE") p = "MERGED"
      else if (e == "CONTRACT") p = "CONTRACT WRITTEN"
      else if (e == "BLOCKED") p = "BLOCKED"
      print t "|" p "|" w "|" at }' "$TEAM_DIR/events.log" 2>/dev/null
}

seat_follow() { # <task> <phase> <role> <line of the seat's step>: a finished seat follows what happened to its task later
  local later; case "$2" in WAITS*|DONE|"TEST PASSED"|"TEST FAILED"|APPROVED|"CHANGES ASKED"|"CHECKS PASSED"|"CHECKS FAILED"|"CONTRACT WRITTEN") ;; *) printf '%s' "$2"; return 0 ;; esac   # an active step (TESTING…) stays
  later=$(awk -v t="$1" -v at="${4:-0}" 'NR > at { if ($1 ~ /^[0-9][0-9][0-9][0-9]-/) { k = $4; v = $5 } else { k = $3; v = $4 } } NR > at && k == t && v ~ /^(MERGE|PASS|FAIL|APPROVE|CHANGES|DISPATCH)$/ { e = v } END { print e }' "$TEAM_DIR/events.log" 2>/dev/null)
  case "$later" in MERGE) printf MERGED ;; PASS) [ "$3" = tester ] && printf '%s' "$2" || printf 'TEST PASSED' ;; FAIL) [ "$3" = tester ] && printf '%s' "$2" || printf 'TEST FAILED' ;;
    APPROVE) [ "$3" = reviewer ] && printf '%s' "$2" || printf APPROVED ;; CHANGES) [ "$3" = reviewer ] && printf '%s' "$2" || printf 'CHANGES ASKED' ;; *) printf '%s' "$2" ;; esac
}

plan_state() { # -> "TASK|PHASE|WHEN|GOAL" of the newest plan (its own steps only), or nothing
  local pl; pl=$(awk '$1 ~ /^[0-9][0-9][0-9][0-9]-/ && $5 == "PLAN_START" { p = $4; g = $0; sub(/^([^ ]+ ){5}/, "", g); last = $5; w = $1 " " $2; next }
    $1 ~ /^[0-9][0-9][0-9][0-9]-/ && $5 ~ /^PLAN_/ && p != "" && $4 == p { last = $5; w = $1 " " $2 }
    END { print p "|" last "|" w "|" g }' "$TEAM_DIR/events.log" 2>/dev/null || true)
  [ -n "${pl%%|*}" ] || return 0
  local t=${pl%%|*} ph; [ "$t" != - ] || t=PLAN; pl=${pl#*|}
  case "${pl%%|*}" in PLAN_APPROVED) ph="PLAN APPROVED" ;; PLAN_CRITIQUE) ph="IN CRITIQUE" ;; *) ph=PLANNING ;; esac
  pl=${pl#*|}; printf '%s|%s|%s|%s' "$t" "$ph" "$(ago_min "${pl%%|*}")" "${pl#*|}"
}

clip() { local LC_ALL=en_US.UTF-8 x=$2; printf '%s' "${x:0:$1}"; }   # <n> <text>: its first n characters (never half a letter)

ago_min() { # <"YYYY-MM-DD HH:MM:SS"> -> minutes since, as "12m" or "3h05"
  local t m; [ -n "$1" ] || return 0
  t=$(date -j -f '%Y-%m-%d %H:%M:%S' "$1" +%s 2>/dev/null || date -d "$1" +%s 2>/dev/null) || return 0
  m=$(( ($(date +%s) - t) / 60 )); [ "$m" -ge 0 ] || m=0
  if [ "$m" -lt 60 ]; then printf '%dm' "$m"; else printf '%dh%02d' $((m / 60)) $((m % 60)); fi
}

ui_sync() { # tell herdr what each seat does; quiet, best effort, only what changed
  local agents i name role pane kind tp task phase when title sig dir="$TEAM_DIR/observer/.ui" merged total ws rnd needs lock own at
  mkdir -p "$dir"
  agents=$(herdr_team agent list 2>/dev/null) || return 0
  needs=$(jq --arg s " ${S_NAME[*]} " '[.result.agents[] | select(.agent_status == "blocked" and (.name as $n | $s | contains(" " + $n + " ")))] | length' <<<"$agents" 2>/dev/null || echo 0)   # squad's seats only
  for ((i = 0; i < $(seat_count); i++)); do
    name=${S_NAME[$i]}; role=${S_ROLE[$i]}
    pane=$(jq -r --arg n "$name" '[.result.agents[] | select(.name == $n) | .pane_id][0] // empty' <<<"$agents" 2>/dev/null)
    kind=$(jq -r --arg n "$name" '[.result.agents[] | select(.name == $n) | .agent][0] // empty' <<<"$agents" 2>/dev/null)
    [ -n "$pane" ] && [ -n "$kind" ] || continue
    tp=$(seat_phase "$name" "$role"); task=${tp%%|*}; tp=${tp#*|}; phase=${tp%%|*}; tp=${tp#*|}; when=$(ago_min "${tp%%|*}"); at=${tp#*|}
    title=""; rnd=""
    phase=$(seat_follow "$task" "$phase" "$role" "$at")
    case "$task" in
      CANDIDATE-*) title="tests $(grep -m1 -- '- Branch:' "$TEAM_DIR/tasks/$task.md" 2>/dev/null | grep -oE 'task/T-[0-9A-Za-z._-]*[0-9A-Za-z]' | cut -d/ -f2 | tr '\n' ' ' || true)" ;;
      T-*) title=$(clip 60 "$(task_title "$task")")
           rnd=$(awk -v t="$task" '$1 ~ /^[0-9][0-9][0-9][0-9]-/ && $4 == t && $5 == "DISPATCH" && $0 ~ /round=/ { n = $0; sub(/.*round=/, "", n); sub(/ .*/, "", n) } END { print n }' "$TEAM_DIR/events.log" 2>/dev/null) ;;
      F-*|"") ;;
    esac
    case "$role" in
      observer) phase=WATCHING; task="loss"; when=""
                title=$(clip 60 "$(grep -m1 '^Largest loss:' "$TEAM_DIR/observer/NOW.md" 2>/dev/null | sed 's/^Largest loss: *//' || true)") ;;
      planner) local pl; pl=$(plan_state)
               if [ -n "$pl" ]; then task=${pl%%|*}; pl=${pl#*|}; phase=${pl%%|*}; pl=${pl#*|}; when=${pl%%|*}; title=$(clip 60 "${pl#*|}"); fi ;;
    esac
    [ -n "$phase" ] || phase=idle
    local meta="${rnd:+r$rnd · }${when}"
    sig="$pane|$kind|$task|$phase|$title|$meta"
    [ "$(cat "$dir/$name" 2>/dev/null)" = "$sig" ] && continue
    if herdr_team pane report-metadata "$pane" --source squad:seat --agent "$kind" --display-agent "$name" \
         ${task:+--title "$task${title:+ · $title}"} --state-label "working=$phase" --state-label "idle=$phase" --state-label "done=$phase" --state-label "blocked=NEEDS YOU" \
         --token "role=$role" --token "ticket=${task:--}" --token "task=${title:- }" --token "phase=$phase" --token "when=${meta:- }" >/dev/null 2>&1; then
      printf '%s' "$sig" >"$dir/$name"
    fi
  done
  # the team's header under its workspace: progress, the lock, and how many seats need the owner
  merged=$(grep -cE '^\| *T-[^|]*\|[^|]*\|[^|]*\| *\**merged' "$TEAM_DIR/TASKS.md" 2>/dev/null || true)
  total=$(grep -cE '^\| *T-[0-9]' "$TEAM_DIR/TASKS.md" 2>/dev/null || true)
  own=$(heavy_owner | cut -d: -f1,3); lock="free"
  [ -z "$own" ] || lock="${own%%@*} $(( ($(date +%s) - ${own##*:}) / 60 ))m"
  ws=$(herdr_team workspace list 2>/dev/null | jq -r --arg l "$(basename "$REPO") team" '.result.workspaces[] | select(.label == $l) | .workspace_id' 2>/dev/null | head -1)
  sig="$ws|${merged:-0}/${total:-0}|$lock|$needs"
  if [ -n "$ws" ] && [ "$(cat "$dir/.team" 2>/dev/null)" != "$sig" ]; then
    herdr_team workspace report-metadata "$ws" --source squad:team --token "team=${merged:-0}/${total:-0} merged" --token "lock=lock $lock" \
      --token "needs=$([ "${needs:-0}" -gt 0 ] && echo "$needs need you" || echo "nobody waits")" >/dev/null 2>&1 && printf '%s' "$sig" >"$dir/.team"
  fi
  # the Agents list: squad's seats, the ones that need the owner first (one view per herdr server)
  [ -e "$dir/.view" ] || { herdr_socket_call agent.view.set '{"source":"squad:view","label":"squad","filter":{"op":"exists","field":{"token":"role"}},"sort":[{"field":"attention","order":"desc"},{"field":"state_change_seq","order":"desc"}]}' >/dev/null 2>&1 && : >"$dir/.view"; }
  mkdir -p "$HOME/.config/squad/teams" && printf '%s\n' "$TEAM_DIR" >"$HOME/.config/squad/teams/$SESSION_NAME" 2>/dev/null || true
  return 0
}
ui_reset() { rm -rf "$TEAM_DIR/observer/.ui"; }   # after a herdr restart or a squad up: send everything again

herdr_socket_call() { # <method> <params json>: one raw call on herdr's socket (no CLI for it); prints the reply
  local sock; sock=$(cat "$TEAM_DIR/herdr.sock" 2>/dev/null || true); [ -n "$sock" ] || sock=${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "$sock" "$1" "$2" <<'PY'
import json, socket, sys, time
end = time.time() + 5
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(5); s.connect(sys.argv[1])
s.sendall((json.dumps({"id": "squad", "method": sys.argv[2], "params": json.loads(sys.argv[3])}) + "\n").encode())
buf = b""
while b"\n" not in buf:
    left = end - time.time()
    if left <= 0: sys.exit(1)
    s.settimeout(left)
    c = s.recv(65536)
    if not c: break
    buf += c
line = buf.split(b"\n", 1)[0].strip()
if not line: sys.exit(1)
print(line.decode())
r = json.loads(line)
sys.exit(0 if r.get("id") == "squad" and "result" in r and "error" not in r else 1)
PY
}

# herdr's top-right status line: every running squad team on this machine in one short line
cmd_herdr_line() {
  local f td sock agents nb nw out="" n left end; end=$(( $(perl -MTime::HiRes=time -e 'printf "%d", time * 1000') + 2000 ))
  for f in "$HOME/.config/squad/teams"/*; do
    [ -f "$f" ] || continue
    left=$(( end - $(perl -MTime::HiRes=time -e 'printf "%d", time * 1000') )); [ "$left" -gt 50 ] || break   # herdr stops the command after 3 s: print what we have
    [ "$left" -le 1000 ] || left=1000
    td=$(cat "$f"); [ -d "$td" ] || { rm -f "$f"; continue; }   # a team that is gone leaves the list
    sock=$(cat "$td/herdr.sock" 2>/dev/null || true); [ -n "$sock" ] || continue
    agents=$(HERDR_SOCKET_PATH=$sock perl -MTime::HiRes=ualarm -e 'ualarm(shift(@ARGV) * 1000); exec @ARGV' "$left" herdr agent list 2>/dev/null) || continue
    n=$(basename "$(dirname "$td")")
    # squad's seats only (they carry the role token), not the owner's own agents in the same session
    nb=$(jq '[.result.agents[] | select(.tokens.role != null and .agent_status == "blocked")] | length' <<<"$agents" 2>/dev/null || echo 0)
    nw=$(jq '[.result.agents[] | select(.tokens.role != null and .agent_status == "working")] | length' <<<"$agents" 2>/dev/null || echo 0)
    [ "${nb:-0}${nw:-0}" != 00 ] || continue   # a team at rest stays out of the line
    if [ "${nb:-0}" -gt 0 ]; then out="${out:+$out   }$n: $nb need you · $nw working"; else out="${out:+$out   }$n: $nw working"; fi
  done
  printf '%s\n' "${out:-squad: nobody needs you}"
}

# herdr's sidebar and status line for squad, written into the owner's herdr config (a backup is kept)
SIDEBAR_MARK="# squad sidebar (ticket 016)"
SIDEBAR_END="# end of squad sidebar"
cmd_ui_setup() {
  local cfg="${HERDR_CONFIG_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml}" bak tmp
  [ -f "$cfg" ] || { mkdir -p "$(dirname "$cfg")"; : >"$cfg"; }
  bak="$cfg.before-squad"; [ -e "$bak" ] || cp "$cfg" "$bak"   # the first backup is the one from before squad
  cp "$cfg" "$cfg.squad-last"
  # take out squad's earlier block (from its mark to its end mark, or to the next table that is not squad's)
  tmp=$(mktemp)
  # squad's earlier block: everything to its end mark; an older block without one: only its own lines
  awk -v m="$SIDEBAR_MARK" -v e="$SIDEBAR_END" '
    index($0, m) == 1 { skip = 1; old = 1; next }
    skip && index($0, e) == 1 { skip = 0; next }
    skip && index($0, "[ui]") == 1 { old = 0 }
    skip && old && $0 ~ /^[[:space:]]*(\[ui\.sidebar\.(agents|spaces)\]|rows[[:space:]]*=|row_gap[[:space:]]*=|#|$)/ { next }
    skip && old && $0 ~ /^[[:space:]]*\[/ { skip = 0 }
    skip && !old { next }
    !skip { print }' "$cfg" >"$tmp"
  if grep -qE '^[[:space:]]*\[[[:space:]]*ui[[:space:]]*\][[:space:]]*(#.*)?$|^[[:space:]]*\[[[:space:]]*ui\.sidebar\.(agents|spaces)[[:space:]]*\]|^[[:space:]]*ui[[:space:]]*\.' "$tmp"; then rm -f "$tmp"; die "your herdr config already has its own [ui] or sidebar settings: squad leaves them alone ($cfg)."; fi
  cat "$tmp" >"$cfg"; rm -f "$tmp"
  cat >>"$cfg" <<TOML
$SIDEBAR_MARK: who does what, who needs you; written by 'squad ui-setup' (backup: $(basename "$bak"))
[ui]
status_indicators = "symbols"
tab_bar_right = [{ type = "command", command = "$SQUAD_HOME/bin/squad herdr-line", interval_seconds = 10, timeout_seconds = 3 }]

[ui.sidebar.agents]
row_gap = 1
rows = [
  ["state_icon", "agent", "state_text"],
  [{ token = "\$role", bold = true, rules = [{ equals = "lead", fg = "#cba6f7" }, { equals = "dev", fg = "#89b4fa" }, { equals = "tester", fg = "#a6e3a1" }, { equals = "reviewer", fg = "#f9e2af" }, { equals = "observer", fg = "#f5c2e7" }, { equals = "planner", fg = "#b4befe" }, { equals = "critic", fg = "#fab387" }] }, "\$ticket", { token = "\$when", dim = true }],
  [{ token = "\$task", dim = true }],
]

[ui.sidebar.spaces]
rows = [
  ["state_icon", "workspace"],
  [{ token = "\$team", fg = "#a6e3a1" }],
  [{ token = "\$needs", fg = "#a6adc8", rules = [{ contains = "need you", fg = "#f38ba8", bold = true }] }, { token = "\$lock", dim = true }],
]
$SIDEBAR_END
TOML
  if ! HERDR_CONFIG_PATH="$cfg" herdr config check >/dev/null 2>&1; then cp "$cfg.squad-last" "$cfg"; die "herdr did not accept the settings; your config is back as it was."; fi
  herdr server reload-config >/dev/null 2>&1 || true
  say "herdr's sidebar and status line now show squad (backup: $bak)."
}

v_notify() { # <title> <body>: a herdr notification to the owner; an answer other than "shown" goes to events.log
  local r; r=$(herdr notification show "$1" --body "$2" --sound request 2>/dev/null | jq -r '.result.reason // .error.code // empty' 2>/dev/null | head -1) || true
  [ -n "$r" ] || r="no answer"
  [ "$r" = shown ] || log_event "$LEAD" - NOTIFY_NOT_SHOWN "$r: $1"
  # notify_os on: the operating system's notification too (macOS); the texts are arguments, never script text
  [ "$NOTIFY_OS" != on ] || ! command -v osascript >/dev/null 2>&1 \
    || osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' "$1" "$2" >/dev/null 2>&1 || true
  sleep 1   # herdr drops a second notification within about a second
  return 0
}

# A condition that still holds (ticket 025): the caller calls owner_alert at every tick while it holds and
# owner_alert_end when it ends. The owner is told at once, then again every OWNER_REPEAT_MINUTES, OWNER_REPEATS times at most.
OWNER_REPEAT_MINUTES=30 OWNER_REPEATS=3
owner_alert() { # <key> <title> <body>
  local f="$TEAM_DIR/observer/.watchdog/held-$1" n=0 last=0 now; now=$(date +%s)
  mkdir -p "$TEAM_DIR/observer/.watchdog"
  if [ -f "$f" ]; then
    read -r n last <"$f" || true
    [ "${n:-0}" -le "$OWNER_REPEATS" ] && [ $((now - ${last:-0})) -ge $((OWNER_REPEAT_MINUTES * 60)) ] || return 0
  fi
  put "$f" "$((n + 1)) $now"
  if [ "$n" -gt 0 ]; then v_notify "$2" "$3 (reminder $n of $OWNER_REPEATS)"; else v_notify "$2" "$3"; fi
}
owner_alert_end() { rm -f "$TEAM_DIR/observer/.watchdog/held-$1"; }

# A state file is written whole (a hidden temp file, then mv), so a reader never sees half of it; a number is
# read with a default, so a missing, empty or damaged file never stops the watch on an arithmetic error.
put() { local f=$1 t; shift; t="$(dirname "$f")/.tmp.$$.$(basename "$f")"; printf '%s\n' "$@" >"$t" && mv "$t" "$f"; }   # <file> <line...>
num_in() { local x=""; { read -r x _ <"$1"; } 2>/dev/null || true; [[ "$x" =~ ^[0-9]+$ ]] || x=0; echo "$x"; }   # <file> -> the number that starts it, or 0
detached() { ( "$@" ) >/dev/null 2>&1 </dev/null & disown $! 2>/dev/null || true; }   # <command...>: started, not waited for (a hook returns at once)

# ---- each seat by itself (ticket 023) ---------------------------------------------
# A seat that waits for the owner, is stuck, or runs without its squad options is handled while the other
# seats work. squad never answers a seat's question or permission prompt: it only tells the owner.
BLOCKED_MINUTES=5        # a seat blocked this long (and no hook told squad sooner): tell the owner
RESTART_GAP_MINUTES=10   # at most one automatic restart of a seat in this time
RESTART_MAX=3            # after this many restarts of a seat in one hour squad stops and tells the owner, until 'squad up'
NOTICE_RESENDS=3         # after the owner was told of a notice, it is sent to the lead this many times more, then no more

seat_question() { # <seat> -> the first line of what it asks, from its screen
  local t; t=$(pane_tail "$1" 15 | sed 's/^[[:space:]│]*//; s/[[:space:]│]*$//' | grep -v '^$' || true)
  clip 200 "$({ grep -m1 '?' <<<"$t" || head -1 <<<"$t"; } || true)"
}

seat_options() { # <agents json> <index> -> yes | no | nothing (not known): the seat's process carries its seat file
  local name=${S_NAME[$2]} pane cl
  pane=$(jq -r --arg n "$name" '[.result.agents[] | select(.name == $n) | .pane_id // empty][0] // empty' <<<"$1" 2>/dev/null) || return 0
  [ -n "$pane" ] || return 0
  cl=$(herdr_team pane process-info --pane "$pane" 2>/dev/null | jq -r '.result.process_info.foreground_processes[]?.cmdline // empty' 2>/dev/null) || return 0
  case "$cl" in *"$TEAM_DIR/seats/$name.md"*) echo yes ;; *"${S_KIND[$2]}"*) echo no ;; esac   # only a shell, or no answer: decide nothing
  return 0
}

pane_shell() { # <pane> -> "shell" when its foreground is only a bare shell (the test revive_helpers uses); anything else, or no answer: nothing
  herdr_team pane process-info --pane "$1" 2>/dev/null | jq -r '.result.process_info.foreground_processes | if length > 0 and all(.cmdline | test("^-?([^ ]*/)?(zsh|bash|sh|fish)$")) then "shell" else empty end' 2>/dev/null || true
}

seat_restart() { # <index> <open task> <why>: start the seat again with its full options (start_seat, as 'squad up' does); true when it runs again
  local i=$1 task=$2 why=$3 name=${S_NAME[$1]} mk="$TEAM_DIR/observer/.watchdog" f now n ws pane round quit agents st last hold=""
  f=$(readlink "$TEAM_DIR/up.lock" 2>/dev/null || true)
  [ -z "$f" ] || ! kill -0 "$f" 2>/dev/null || return 1   # 'squad up' runs: it starts the seats itself
  f="$mk/restart-$name"; now=$(date +%s)
  if [ ! -e "$f.stopped" ]; then
    n=$(awk -v t=$((now - 3600)) '$1 > t' "$f" 2>/dev/null | wc -l | tr -d ' ')
    [ "$n" -lt "$RESTART_MAX" ] || { : >"$f.stopped"; log_event "$name" "${task:--}" SEAT_RESTART_STOPPED "$n restarts in one hour: $why"; }
  fi
  if [ -e "$f.stopped" ]; then   # stopped: nothing more, also after the hour, until 'squad up' or the seat is seen healthy (seats_tick)
    owner_alert "restart-$name" "squad: $name does not stay up" "squad restarted it $RESTART_MAX times in one hour ($why) and stopped. Read its pane, then run squad up."
    return 1
  fi
  last=$(tail -1 "$f" 2>/dev/null || true); [[ "$last" =~ ^[0-9]+$ ]] || last=0
  [ $((now - last)) -ge $((RESTART_GAP_MINUTES * 60)) ] || return 1
  ws=$(herdr_team workspace list 2>/dev/null | jq -r --arg l "$(basename "$REPO") team" '.result.workspaces[] | select(.label == $l) | .workspace_id' 2>/dev/null | head -1) || ws=""
  pane=""; [ -z "$ws" ] || pane=$(herdr_team pane list --workspace "$ws" 2>/dev/null | jq -r --arg l "$name" '.result.panes[] | select(.label == $l) | .pane_id' 2>/dev/null | head -1) || pane=""
  if [ -z "$pane" ]; then   # its pane is closed: only 'squad up' lays out a new one
    owner_alert "restart-$name" "squad: $name is gone" "Its pane is closed${task:+ and $task is open}: run squad up."
    return 1
  fi
  # The tick's state is old by now, and herdr reads it from the screen: read it again, and type only into a seat that
  # is free. squad never types into a seat that works, is busy, gets a dispatch or shows a dialog.
  agents=$(herdr_team agent list 2>/dev/null) || agents=""
  st=$(seat_state "$agents" "$name" 2>/dev/null) || st=""
  case "$st" in
    idle|"done")
      if seat_busy "$name"; then hold="it has a run, a place in the heavy queue or background work"
      elif queue_lock_held "$name"; then hold="a dispatch is being delivered to it"
      elif ! wait_ready "$name" "${S_KIND[$i]}" 0; then hold="it is not at an empty prompt (a dialog or a menu)"; fi ;;
    off)   # as 'squad up': an agent herdr sees in the pane without a name is not gone; anything but a bare shell is not typed into
      if [ -n "$(jq -r --arg p "$pane" '.result.agents[] | select(.pane_id == $p and .name == null) | .pane_id' <<<"$agents" 2>/dev/null)" ]; then hold="an agent without a name runs in its pane"
      elif [ "$(pane_shell "$pane")" != shell ]; then hold="its pane does not show a bare shell"; fi ;;
    *) hold="it is ${st:-not readable} now" ;;
  esac
  if [ -n "$hold" ]; then   # nothing is typed; the next tick looks again, and the owner is told when it stays so
    [ -f "$mk/defer-$name" ] || put "$mk/defer-$name" "$now"
    [ $((now - $(num_in "$mk/defer-$name"))) -lt $((RESTART_GAP_MINUTES * 60)) ] \
      || owner_alert "restart-$name" "squad: $name needs a restart" "squad does not start it again ($why) while $hold. Read its pane, then run squad up."
    return 1
  fi
  rm -f "$mk/defer-$name"
  echo "$now" >>"$f"
  if [ "$st" != off ]; then   # the agent runs: end it at its own prompt, then start it again in the same pane
    quit=/exit; [ "${S_KIND[$i]}" != codex ] || quit=/quit
    herdr_team agent prompt "$name" "$quit" >/dev/null 2>&1 || true
    wait_for_state "$name" "${SQUAD_EXIT_WAIT:-20}" off || { log_event "$name" "${task:--}" SEAT_RESTART_FAILED "it did not exit: $why"; return 1; }
  fi
  if ! ( HERDR_SOCKET_PATH=$(cat "$TEAM_DIR/herdr.sock" 2>/dev/null || true)
         if [ -n "$HERDR_SOCKET_PATH" ]; then export HERDR_SOCKET_PATH; else unset HERDR_SOCKET_PATH; fi
         START_FAILED=0; start_seat "$i" "$pane"; [ "$START_FAILED" = 0 ] ) >/dev/null 2>&1; then
    log_event "$name" "${task:--}" SEAT_RESTART_FAILED "it did not become ready: $why"
    owner_alert "restart-$name" "squad: $name did not start again" "squad started it again ($why) and it did not become ready. Read its pane, then run squad up."
    return 1
  fi
  owner_alert_end "restart-$name"
  log_event "$name" "${task:--}" SEAT_RESTART "$why"
  # a lead or a dev goes on with its open task (ticket 023); other seats wait for the lead's next dispatch
  case "${S_ROLE[$i]}" in lead|dev) ;; *) return 0 ;; esac
  if [ -n "$task" ]; then
    round=$(awk -v s="$name" -v t="$task" '$3 == s && $4 == t && $5 == "DISPATCH" { r = 1; for (k = 6; k <= NF; k++) if ($k ~ /^round=[0-9]+$/) r = substr($k, 7) } END { print r + 0 }' "$TEAM_DIR/events.log" 2>/dev/null || echo 1)
    [ "$round" -ge 1 ] 2>/dev/null || round=1
    herdr_team agent prompt "$name" "[squad] squad started you again at $(date +%H:%M) ($why). Your open task: $(default_task_line "${S_ROLE[$i]}" "$task" "$round")" >/dev/null 2>&1 || true
  elif [ "${S_ROLE[$i]}" = lead ]; then
    herdr_team agent prompt "$name" "$(restart_note)" >/dev/null 2>&1 || true
  fi
  return 0
}

seats_tick() { # <agents json>
  local agents=$1 mk="$TEAM_DIR/observer/.watchdog" i n name st task now up=0 w q kind why opt opens bare="it ran without its squad options"
  n=$(seat_count); now=$(date +%s); opens=$(open_tasks)
  for ((i = 0; i < n; i++)); do [ "$(seat_state "$agents" "${S_NAME[$i]}")" = off ] || up=1; done
  [ "$up" = 1 ] || return 0   # a team that is down (no seat runs) is not in trouble
  for ((i = 0; i < n; i++)); do
    name=${S_NAME[$i]}; st=$(seat_state "$agents" "$name"); task=$(awk -v s="$name" '$1 == s { print $2; exit }' <<<"$opens")
    # a. it waits for the owner: its hook said so (seats/<seat>.owner-wait), or herdr shows it blocked for BLOCKED_MINUTES
    w="$TEAM_DIR/seats/$name.owner-wait"
    if [ "$st" = blocked ]; then
      [ -f "$mk/blocked-$name" ] || put "$mk/blocked-$name" "$now"
      if [ -f "$w" ] || [ $((now - $(num_in "$mk/blocked-$name"))) -ge $((BLOCKED_MINUTES * 60)) ]; then
        q=$(sed -n '2p' "$w" 2>/dev/null || true); [ -n "$q" ] || q=$(seat_question "$name")
        owner_alert "wait-$name" "squad: $name waits for you${task:+ ($task)}" "${q:-It shows a prompt or a question.}"
      fi
    elif [ -f "$w" ] && [ $((now - $(num_in "$w"))) -lt 120 ]; then :   # the hook was first; herdr's state follows it
    else rm -f "$mk/blocked-$name" "$w"; owner_alert_end "wait-$name"; fi
    [ "$st" != working ] || owner_alert_end "fail-$name"
    # b. it is stuck (watch_once found it): the lead was told; the owner is told too, also while other seats work
    kind=$(cat "$TEAM_DIR/observer/.alerted/$name" 2>/dev/null || true)
    case "$kind" in
      stalled) owner_alert "stuck-$name" "squad: $name stalled${task:+ on $task}" "$(trouble_hint "$kind" "$name")" ;;
      login) owner_alert "stuck-$name" "squad: $name needs a sign-in" "$(trouble_hint "$kind" "$name")" ;;
      *) owner_alert_end "stuck-$name" ;;
    esac
    # c. its agent is gone with a task open (the lead: always), or it runs without its squad options (herdr resumed
    #    it bare). seat_restart off (the default; the owner, 21 Nov 2026): the watch ends and starts no seat; it logs
    #    the case and tells the owner. seat_restart on: start it again; a seat at work or at a prompt is left alone
    #    until it is idle.
    why=""
    if [ "$st" = off ]; then { [ -z "$task" ] && [ "$name" != "$LEAD" ]; } || why="its agent was gone"
    elif { [ "$st" = idle ] || [ "$st" = "done" ]; } && loads_role "${S_KIND[$i]}"; then
      opt=$(seat_options "$agents" "$i")
      if [ "$opt" = yes ]; then rm -f "$TEAM_DIR/seats/$name.no-options" "$mk/bare-$name"; owner_alert_end "bare-$name"; owner_alert_end "options-$name"
      elif [ "$opt" = no ] || [ -f "$TEAM_DIR/seats/$name.no-options" ]; then why=$bare; fi
    fi
    if [ "$SEAT_RESTART" != on ]; then
      case "$why" in
        "") owner_alert_end "gone-$name" ;;
        "$bare")
          owner_alert_end "gone-$name"
          [ -e "$mk/held-options-$name" ] || log_event "$name" "${task:--}" SEAT_NO_OPTIONS "it runs without its squad options: $OWNER_NAME is told"
          owner_alert "options-$name" "squad: $name runs without its squad options" "$name runs without its squad options: run squad up." ;;
        *)
          [ -e "$mk/held-gone-$name" ] || log_event "$name" "${task:--}" SEAT_GONE "its agent is gone: $OWNER_NAME is told"
          owner_alert "gone-$name" "squad: $name is gone${task:+ ($task)}" "$name is gone: run squad up." ;;
      esac
    elif [ "$why" = "$bare" ] && [ -e "$mk/bare-$name" ]; then
      # squad started it with its options and they still do not show: the check cannot be trusted here; never restart in a loop
      owner_alert "bare-$name" "squad: check $name's options" "squad started $name again and still cannot see its squad options in its process. Read its pane."
    elif [ -n "$why" ]; then
      if seat_restart "$i" "$task" "$why" && [ "$why" = "$bare" ]; then : >"$mk/bare-$name"; rm -f "$TEAM_DIR/seats/$name.no-options"; fi
    else   # nothing to start: a seat that runs is healthy again, so a stop of its restarts ends
      owner_alert_end "restart-$name"; rm -f "$mk/defer-$name"; [ "$st" = off ] || rm -f "$mk/restart-$name.stopped"
    fi
  done
}

# ---- notices to the lead, and the lead's wait for the owner (ticket 025) -------------
# A DONE, a verdict or a BLOCKED is one line in the lead's pane. squad keeps each one until the lead acts
# on the task, sends it again, and tells the owner when it stays unanswered.
notice_keep() { # <seat> <task> <status> <the line sent to the lead>
  local d="$TEAM_DIR/observer/.notices"; mkdir -p "$d"
  put "$d/$2.$1" "$(date +%s) $(wc -l <"$TEAM_DIR/events.log" | tr -d ' ') $1 $3 $2" "$4"
  rm -f "$d/.sent-$2.$1" "$d/.owner-$2.$1"
}

notices_tick() {
  local d="$TEAM_DIR/observer/.notices" f b at nr seat status task line now sent lead=""; now=$(date +%s)
  for f in "$d"/*; do
    [ -f "$f" ] || continue
    b=${f##*/}
    { read -r at nr seat status task && IFS= read -r line; } <"$f" || continue
    # the lead acted on the task after the notice: its own event for it (a verdict, a merge, 'squad seen', a candidate
    # that holds it), a new dispatch of it (not a contract request to another seat: squad sends those itself), or, for
    # a BLOCKED, a wait for the owner. A candidate's notice: the lead's event for it (CANDIDATE_MERGED, a new build of
    # it, 'squad seen'), any newer candidate build, or, after a FAIL, a dispatch of the candidate or of one of its tasks.
    if awk -v n="$nr" -v l="$LEAD" -v t="$task" -v st="$status" -v s="$seat" '
         $1 !~ /^[0-9][0-9][0-9][0-9]-/ { next }
         $4 == t && $5 == "CANDIDATE" { mine = $0; sub(/.*tasks=/, "", mine); mine = " " mine " " }   # a candidate: its tasks
         NR <= n { next }
         { disp = ($5 == "DISPATCH" || $5 == "DISPATCH_QUEUED") }
         $3 == l && $4 == t { f = 1 }
         t ~ /^CANDIDATE-/ {
           if ($3 == l && $5 == "CANDIDATE") f = 1
           if (st == "FAIL" && disp && ($4 == t || index(mine, " " $4 " "))) f = 1
           next }
         disp && $4 == t && (index($0, "contract=1") == 0 || $3 == s) { f = 1 }
         $3 == l && $5 == "CANDIDATE" { x = $0; sub(/tasks=/, " ", x); if (index(x " ", " " t " ")) f = 1 }
         st == "BLOCKED" && $3 == l && $5 == "WAIT_OWNER" { f = 1 }
         END { exit !f }' "$TEAM_DIR/events.log" 2>/dev/null; then
      rm -f "$f" "$d/.sent-$b" "$d/.owner-$b"; continue
    fi
    sent=$(num_in "$d/.sent-$b"); [ "$sent" -gt 0 ] || sent=$at
    if [ $((now - sent)) -ge $((NOTICE_REDELIVER_MINUTES * 60)) ]; then
      # nothing is typed into a lead that shows a dialog (squad never answers one): the line goes out at a later tick
      [ -n "$lead" ] || { lead=free; [ "$(seat_state "$(herdr_team agent list 2>/dev/null || echo '{"result":{"agents":[]}}')" "$LEAD")" != blocked ] && ! has_menu "$(pane_tail "$LEAD" 12)" || lead=dialog; }
      if [ "$lead" = dialog ]; then :
      elif [ -e "$d/.owner-$b" ] && [ "$(num_in "$d/.owner-$b")" -ge "$NOTICE_RESENDS" ]; then :   # the owner knows: no line for ever
      elif herdr_team agent prompt "$LEAD" "$line (Sent again: no event of yours for $task since $(fmt_hm "$at"). When it needs no action: squad seen $task)" >/dev/null 2>&1; then
        put "$d/.sent-$b" "$now"
        [ ! -e "$d/.owner-$b" ] || put "$d/.owner-$b" "$(( $(num_in "$d/.owner-$b") + 1 ))"
      fi
    fi
    if [ $((now - at)) -ge $((NOTICE_OWNER_MINUTES * 60)) ] && [ ! -e "$d/.owner-$b" ]; then
      : >"$d/.owner-$b"
      v_notify "squad: $task $status waits for the lead" "$seat reported $status on $task at $(fmt_hm "$at"); the lead has not acted on it for $(( (now - at) / 60 )) min."
    fi
  done
  return 0
}

# squad seen <task> — the lead says that it read the pending notices of a task and that they need no event of
# its own (a BLOCKED answered in the dev's pane, a CONTRACT answered with squad notify): they are not sent again.
cmd_seen() {
  find_repo; load_conf
  [ $# -eq 1 ] || die "usage: squad seen <task>"
  valid_task "$1"
  [ -z "${TEAM_ROLE:-}" ] || [ "$TEAM_ROLE" = "$LEAD" ] || die "only the lead (or $OWNER_NAME at a terminal) runs squad seen."
  log_event "$LEAD" "$1" SEEN
  say "$1: its pending notices are not sent again."
}

# squad wait-owner "<what>" | --done — the lead says that the team waits for the owner: a chosen wait, not a
# lost one. The owner is told now and reminded every owner_reminder_hours; the stall alarm is silent meanwhile.
cmd_wait_owner() {
  find_repo; load_conf
  local f="$TEAM_DIR/owner-wait" what=${1:-} now; now=$(date +%s)
  [ -z "${TEAM_ROLE:-}" ] || [ "$TEAM_ROLE" = "$LEAD" ] || die "$TEAM_ROLE cannot set the team's wait for $OWNER_NAME: only the lead runs squad wait-owner (report BLOCKED with squad done)."
  if [ "$what" = --done ]; then
    [ -f "$f" ] || { say "no wait for $OWNER_NAME is set."; return 0; }
    rm -f "$f"; log_event "$LEAD" - WAIT_OWNER_DONE
    say "the wait for $OWNER_NAME is over."; return 0
  fi
  [ -n "$what" ] || die 'usage: squad wait-owner "<what the team waits for>"  |  squad wait-owner --done'
  what=${what//$'\n'/ }
  log_event "$LEAD" - WAIT_OWNER "$what"
  put "$f" "$now $(wc -l <"$TEAM_DIR/events.log" | tr -d ' ') $now" "$what"
  v_notify "squad: $(basename "$REPO") waits for you" "$what"
  say "$OWNER_NAME was told and is reminded every $OWNER_REMINDER_HOURS h. When the answer is there: squad wait-owner --done (a new dispatch ends the wait too)."
}

owner_wait_tick() {
  local f="$TEAM_DIR/owner-wait" at nr last what now; now=$(date +%s)
  [ -f "$f" ] || return 0
  { read -r at nr last && IFS= read -r what; } <"$f" || return 0
  if [ -n "$(awk -v n="$nr" 'NR > n && $5 == "DISPATCH" { print; exit }' "$TEAM_DIR/events.log" 2>/dev/null)" ]; then
    rm -f "$f"; log_event "$LEAD" - WAIT_OWNER_DONE "a new dispatch"; return 0
  fi
  [ $((now - last)) -ge $((OWNER_REMINDER_HOURS * 3600)) ] || return 0
  put "$f" "$at $nr $now" "$what"
  v_notify "squad: $(basename "$REPO") still waits for you" "$what (since $(fmt_hm "$at"))"
}
watchdog_tick() {
  local now last lastev wait key mk="$TEAM_DIR/observer/.watchdog" agents i name st text p7
  mkdir -p "$mk"; now=$(date +%s)
  # 1. a stall: no team event for stall_alert_minutes, and a verdict, a DONE or a test result is the newest event of a task
  lastev=$(awk '$1 ~ /^[0-9][0-9][0-9][0-9]-/ && $3 != "observer" && $5 != "IDLE" && $5 != "OBSERVE" && $5 != "STALLED" && $5 != "NOTIFY_NOT_SHOWN" && $5 !~ /^SEAT_/ { l = $1 " " $2 } END { print l }' "$TEAM_DIR/events.log" 2>/dev/null)
  if [ -n "$lastev" ]; then
    last=$(date -j -f '%Y-%m-%d %H:%M:%S' "$lastev" +%s 2>/dev/null || date -d "$lastev" +%s 2>/dev/null || echo "$now")
    agents=$(herdr_team agent list 2>/dev/null || echo '{"result":{"agents":[]}}')
    if [ $(( (now - last) / 60 )) -ge "$STALL_ALERT_MINUTES" ] && [ -z "$(heavy_owner)" ] && [ ! -f "$TEAM_DIR/owner-wait" ] \
       && ! jq -e '.result.agents[] | select(.agent_status == "working")' <<<"$agents" >/dev/null 2>&1; then
      # waiting for the lead: a task whose newest event is a verdict, a DONE or a test result, with no
      # queued dispatch after it, and (for an approved task) no candidate run started after it
      wait=$(awk '$1 ~ /^[0-9][0-9][0-9][0-9]-/ {
          if ($4 ~ /^CANDIDATE-/ && $5 == "DISPATCH") { open[$4] = NR }
          if ($4 ~ /^CANDIDATE-/ && ($5 == "PASS" || $5 == "FAIL")) { delete open[$4]; ended = NR }
          if ($4 ~ /^T-/ && $5 ~ /^(DISPATCH|DISPATCH_QUEUED|DONE|PASS|FAIL|APPROVE|CHANGES|MERGE|BLOCKED)$/) { e[$4] = $5; at[$4] = NR } }
        END { held = 0; for (c in open) if (open[c] > held) held = open[c]
          for (t in e) if (e[t] ~ /^(DONE|PASS|FAIL|APPROVE|CHANGES)$/ && !(e[t] == "APPROVE" && held > at[t])) printf "%s %s ", t, e[t] }' "$TEAM_DIR/events.log" 2>/dev/null)
      key="$mk/stall-$last"
      if [ -n "$wait" ] && [ ! -e "$key" ]; then
        [ -e "$key.logged" ] || { : >"$key.logged"; log_event "$LEAD" - STALLED "no event for $(( (now - last) / 60 )) min while waiting: $wait"; }
        # a lead that shows a dialog gets the line at a later tick (the owner is told below at once)
        ! tell_lead "[squad] No event for $(( (now - last) / 60 )) min, and these wait for you: $wait. Read their newest report or review and act (dispatch the next round, merge, or put it in a candidate). (Notification: first finish what you were doing.)" || : >"$key"
      fi
      if [ -n "$wait" ]; then owner_alert "stall-$last" "squad: $(basename "$REPO") stalled" "No event for $(( (now - last) / 60 )) min; waiting for the lead: $wait"; fi
    fi
  fi
  # the alert ends when the newest event changes, not when the condition is false for one tick (the lead works for a minute)
  for key in "$mk"/held-stall-*; do [ "$key" = "$mk/held-stall-${last:-}" ] || rm -f "$key"; done
  # 2. a seat at its usage limit: tell the owner once; with limit_fallback, switch a Claude seat to that model
  agents=$(herdr_team agent list 2>/dev/null || echo '{"result":{"agents":[]}}')
  for ((i = 0; i < $(seat_count); i++)); do
    name=${S_NAME[$i]}; st=$(seat_state "$agents" "$name")
    case "$st" in off|working) owner_alert_end "limit-$name"; continue ;; esac   # a seat at work is not stopped (its screen may only show the words)
    text=$(herdr_team agent read "$name" --source visible 2>/dev/null | tail -15) || continue   # no read: decide nothing
    case "$text" in *"hit your limit"*|*"hit your "*" limit"*|*"limit reached"*|*"Limit reached"*|*"reached your usage limit"*) ;; *) rm -f "$mk/limit-$name" "$mk/fallback-$name"; owner_alert_end "limit-$name"; continue ;; esac
    local resets; resets=$(printf '%s' "$text" | grep -oE 'resets [^·)]*' | head -1 || true)
    if [ ! -e "$mk/limit-$name" ]; then
      : >"$mk/limit-$name"; log_event "$name" - LIMIT "${resets:-usage limit}"
    fi
    [ -n "$LIMIT_FALLBACK" ] && [ "${S_KIND[$i]}" = claude ] || owner_alert "limit-$name" "squad: $name at its usage limit" "${resets:-usage limit}. It waits for you: answer its pane, or set limit_fallback <model> in team.conf."
    if [ -n "$LIMIT_FALLBACK" ] && [ "${S_KIND[$i]}" = claude ] && [ ! -e "$mk/fallback-$name" ] && seat_dialog "$name"; then
      # a dialog: no key and no /model goes to it (squad never answers one); only the owner is told
      owner_alert "limit-$name" "squad: $name at its usage limit" "${resets:-usage limit}. It shows a dialog, so squad does not switch it to $LIMIT_FALLBACK: answer its pane."
    elif [ -n "$LIMIT_FALLBACK" ] && [ "${S_KIND[$i]}" = claude ] && [ ! -e "$mk/fallback-$name" ]; then
      herdr_team agent send-keys "$name" Escape >/dev/null 2>&1 || true; sleep 2
      if herdr_team agent prompt "$name" "/model $LIMIT_FALLBACK" >/dev/null 2>&1; then
        : >"$mk/fallback-$name"
        log_event "$name" - FALLBACK "model=$LIMIT_FALLBACK"
        v_notify "squad: $name at its usage limit" "${resets:-usage limit}; switched to $LIMIT_FALLBACK (limit_fallback in team.conf). Set it back after the reset."
      else
        v_notify "squad: $name at its usage limit" "${resets:-usage limit}; the switch to $LIMIT_FALLBACK did not go through; squad tries again."
      fi
    fi
  done
  # 3. Claude's week at 80 %: once a day
  p7=$(usage_claude | jq -r --argjson now "$now" 'if (.r7 // 0) > 0 and (.r7 // 0) < $now then empty else (.p7 // empty) end' 2>/dev/null | cut -d. -f1 || true)   # a window past its reset is 0 %
  if [ -n "$p7" ] && [ "$p7" -ge 80 ] 2>/dev/null && [ ! -e "$mk/week-$(date +%Y%m%d)" ]; then
    : >"$mk/week-$(date +%Y%m%d)"
    v_notify "squad: Claude week at $p7 %" "The 7-day Claude usage is at $p7 %. Consider limit_fallback in team.conf before a seat stops."
  fi
  # 4. each seat by itself (ticket 023); 5. notices the lead has not acted on, the lead's wait for the owner (ticket 025)
  seats_tick "$agents" || true
  notices_tick || true
  owner_wait_tick || true
  return 0
}

TM_P="" TM_W="" TM_FLAG=""
cmd_timed() { # <seconds> -- <command...>: run it, stop it (its whole process group) after the seconds
  local secs=${1:-} rc=0
  [[ "$secs" =~ ^[1-9][0-9]{0,4}$ ]] || die "usage: squad timed <seconds> -- <command...>"
  shift; [ "${1:-}" = -- ] && shift
  [ $# -gt 0 ] || die "usage: squad timed <seconds> -- <command...>"
  command -v perl >/dev/null 2>&1 || die "squad timed needs perl (it gives the command its own process group, so all of it can be stopped)."
  TM_FLAG=$(mktemp); rm -f "$TM_FLAG"
  # globals: the trap runs after this function's locals are gone
  trap '[ -z "$TM_P" ] || ! group_alive "$TM_P" || stop_group "$TM_P"; [ -z "$TM_W" ] || kill_tree "$TM_W" KILL; [ -z "$TM_FLAG" ] || rm -f "$TM_FLAG"' EXIT
  trap 'exit 130' INT TERM HUP
  ( run_in_group "$(pwd -P)" "$@" ) & TM_P=$!
  ( sleep "$secs"; : >"$TM_FLAG"; kill -TERM -- "-$TM_P" 2>/dev/null || kill -TERM "$TM_P" 2>/dev/null; sleep 5; kill -KILL -- "-$TM_P" 2>/dev/null || true ) & TM_W=$!
  disown "$TM_W" 2>/dev/null || true   # no "Killed" notice when it is stopped
  wait "$TM_P" || rc=$?
  if group_alive "$TM_P"; then stop_group "$TM_P"; fi   # a child that ignored TERM ends too
  kill_tree "$TM_W" KILL; TM_W=""
  if [ -e "$TM_FLAG" ]; then say "squad timed: stopped after $secs s"; rc=124; fi
  rm -f "$TM_FLAG"; TM_P=""
  return "$rc"
}

watch_once() {
  local agents_json states="" i n state ev mark color=0 trouble task opens
  [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && color=1
  agents_json=$(herdr_team agent list 2>/dev/null) || agents_json='{"result":{"agents":[]}}'
  n=$(seat_count)
  opens=$(open_tasks)
  record_sessions "$agents_json"
  # a team that is down (no seat runs) is not in trouble
  local up=0
  for ((i = 0; i < n; i++)); do [ "$(seat_state "$agents_json" "${S_NAME[$i]}")" = off ] || up=1; done
  for ((i = 0; i < n; i++)); do
    state=$(seat_state "$agents_json" "${S_NAME[$i]}")
    trouble=""
    if [ "$up" = 1 ]; then
      task=$(awk -v s="${S_NAME[$i]}" '$1 == s { print $2; exit }' <<<"$opens")
      trouble=$(seat_trouble "$agents_json" "$i" "$task")
      if [ -n "$trouble" ]; then alert_trouble "$i" "$trouble" "$task"; else rm -f "$TEAM_DIR/observer/.alerted/${S_NAME[$i]}" "$TEAM_DIR/observer/.alerted/${S_NAME[$i]}.untold"; fi
    fi
    [ "$up" = 1 ] && [ "${S_ROLE[$i]}" = dev ] && idle_dev_check "$i" "$state" "$task"
    case "$state" in working) mark="●" ;; blocked) mark="!" ;; idle|done) mark="○" ;; *) mark="·" ;; esac
    if [ "$color" = 1 ]; then
      case "$state" in working) mark=$'\033[36m●\033[0m' ;; blocked) mark=$'\033[1;31m!\033[0m' ;; esac
    fi
    if [ -n "$trouble" ]; then
      if [ "$color" = 1 ]; then mark="$mark"$'\033[1;31m'" $trouble"$'\033[0m'; else mark="$mark $trouble"; fi
    fi
    states="$states${S_NAME[$i]} $mark  "
  done
  ev=$(tail -1 "$TEAM_DIR/events.log" 2>/dev/null || true)  # no events yet on a fresh team
  printf '\033[H\033[2J'
  printf ' %s\n' "$(usage_line)"
  # the status table of TASKS.md: | ID | Title | Owner | Status | Depends on |
  awk -F'|' -v color="$color" '
    function trim(x) { gsub(/^ +| +$/, "", x); return x }
    function paint(code, text) { return color == 1 ? "\033[" code "m" text "\033[0m" : text }
    /^\| *T-[0-9]/ {
      id = trim($2); owner = trim($4); st = trim($5); total++
      if (st == "merged")            { merged++;  chip = paint("32", "✔ " id) }
      else if (st ~ /^review/)       { review++;  chip = paint("35", "◆ " id " " st " " owner) }
      else if (st == "test")         { test++;    chip = paint("34", "▲ " id " test " owner) }
      else if (st == "dev")          { dev++;     chip = paint("36", "● " id " dev " owner) }
      else if (st == "blocked")      { blocked++; chip = paint("1;31", "! " id " blocked " owner) }
      else                           { todo++;    chip = paint("2", "○ " id) }
      chips = chips (chips == "" ? "" : "   ") chip
    }
    END {
      if (total == 0) { print " no tasks yet"; exit }
      cells = int(merged * 20 / total); bar = ""
      for (k = 0; k < 20; k++) bar = bar (k < cells ? "▓" : "░")
      printf " %s %d/%d merged", paint("32", bar), merged, total
      if (review)  printf " · review %d", review
      if (test)    printf " · test %d", test
      if (dev)     printf " · dev %d", dev
      if (todo)    printf " · todo %d", todo
      if (blocked) printf " · %s", paint("1;31", "blocked " blocked)
      printf "\n %s\n", chips
    }' "$TEAM_DIR/TASKS.md" 2>/dev/null || true
  printf ' %s%s\n' "$states" "${ev:+  last: $ev}"
  [ ! -L "$HEAVY_DIR/lock" ] || printf ' %s\n' "$(heavy_status | tr '\n' ' ')"
}

# ---- observer passes --------------------------------------------------------------
# squad starts each pass itself (no timer inside the observer's session, which
# dies with it): after a merge or new trouble, and at least every
# observe_minutes. A pass that reports a loss over 30 min is followed by a deep
# pass on observer_deep_model.
observer_index() { local i n; n=$(seat_count); for ((i = 0; i < n; i++)); do [ "${S_ROLE[$i]}" = observer ] && { echo "$i"; return 0; }; done; return 1; }

observe_tick() {
  local i name dir="$TEAM_DIR/observer" now last marks prev due="" pass state loss
  i=$(observer_index) || return 0
  name=${S_NAME[$i]}
  mkdir -p "$dir"
  state=$(seat_state "$(herdr_team agent list 2>/dev/null || echo '{"result":{"agents":[]}}')" "$name")
  case "$state" in idle|"done") ;; *) return 0 ;; esac
  now=$(date +%s)
  last=$(cat "$dir/.last-pass" 2>/dev/null || echo 0)
  marks=$(grep -cE ' (MERGE|STALLED|SEAT_STALLED|SEAT_DEAD|SEAT_LOGIN|SEAT_BLOCKED|BLOCKED|RESTART|FAIL)( |$)' "$TEAM_DIR/events.log" 2>/dev/null || true)
  prev=$(cat "$dir/.last-marks" 2>/dev/null || echo 0)
  if [ "$last" = 0 ]; then due="first pass"
  elif [ "${marks:-0}" != "$prev" ]; then due="new events"
  elif [ $((now - last)) -ge $((OBSERVE_MINUTES * 60)) ]; then due="$OBSERVE_MINUTES min"; fi
  [ -n "$due" ] || return 0
  pass=$(( $(cat "$dir/.pass" 2>/dev/null || echo 0) + 1 ))
  # back to the seat's own model after a deep pass
  if [ -f "$dir/.deep" ]; then
    herdr_team agent prompt "$name" "/model $(seat_model_arg "$i")" >/dev/null 2>&1 || true
    rm -f "$dir/.deep"; sleep "${SQUAD_MODEL_WAIT:-2}"
  else
    loss=$(awk '/^Largest loss:/ { sub(/^Largest loss: */, ""); if (match($0, /^[0-9]+/)) print substr($0, 1, RLENGTH); exit }' "$dir/NOW.md" 2>/dev/null || true)
    # one deep pass per loss (observer S-49): the loss is known by the first time in its line (when it started)
    local lkey lline; lline=$(grep -m1 '^Largest loss:' "$dir/NOW.md" 2>/dev/null || true)
    lkey=$(printf '%s' "$lline" | grep -oE '[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?' | head -1 || true)
    [ -n "$lkey" ] || lkey=$(printf '%s' "$lline" | sed 's/[0-9]//g' | cut -c1-60)   # no time: its cause, without the growing numbers
    if [ -n "$OBSERVER_DEEP_MODEL" ] && [ -n "$(seat_model_arg "$i")" ] && [ "${loss:-0}" -gt 30 ] && [ "$(cat "$dir/.deep-for" 2>/dev/null)" != "$((pass - 1))" ] \
       && { [ -z "$lkey" ] || ! grep -qxF -- "$lkey" "$dir/.deep-keys" 2>/dev/null; }; then
      [ -z "$lkey" ] || echo "$lkey" >>"$dir/.deep-keys"
      herdr_team agent prompt "$name" "/model $OBSERVER_DEEP_MODEL" >/dev/null 2>&1 || true
      : >"$dir/.deep"; echo "$((pass - 1))" >"$dir/.deep-for"; sleep "${SQUAD_MODEL_WAIT:-2}"
      due="deep pass: pass $((pass - 1)) found a loss of $loss min; find its cause and the change that prevents it"
    fi
  fi
  herdr_team agent prompt "$name" "Observer pass $pass ($due). Follow 'A pass' in your role file." >/dev/null 2>&1 || return 0
  echo "$pass" >"$dir/.pass"; echo "$now" >"$dir/.last-pass"; echo "${marks:-0}" >"$dir/.last-marks"
  log_event "$name" - OBSERVE "pass=$pass $due"
}

herdr_team() { # herdr bound to this team's session
  local sock; sock=$(cat "$TEAM_DIR/herdr.sock" 2>/dev/null || true)
  if [ -n "$sock" ]; then HERDR_SOCKET_PATH=$sock herdr "$@"; else herdr "$@"; fi
}

cmd_watch() {
  find_repo; load_conf
  local once=0 observe=0 a self="$SQUAD_HOME/bin/squad" sum
  for a in "$@"; do case "$a" in --once) once=1 ;; --observe) observe=1 ;; esac; done
  sum=$(cksum <"$self" 2>/dev/null || true)
  [ "$observe" = 1 ] || ui_reset   # a new strip (squad up, a herdr restart): send herdr everything again
  while :; do
    watch_once
    [ "$observe" = 1 ] || { watchdog_tick || true; ui_sync || true; report_lost_requests || true; }
    [ "$observe" = 0 ] || observe_tick
    [ "$once" = 1 ] && return 0
    sleep "${SQUAD_WATCH_POLL:-20}"
    # a new bin/squad on disk (an update): run it, so a long watch never keeps old code; a file that does not parse is not run
    if [ -n "$sum" ] && [ "$(cksum <"$self" 2>/dev/null || true)" != "$sum" ] && bash -n "$self" 2>/dev/null; then exec "$self" watch "$@"; fi
  done
}

# squad done <seat> <task> <status> — a worker's last step: tell the lead it
# finished, even while the lead is busy (herdr queues the message for it).
# herdr's 'agent wait' watches one agent at a time, so a lead waiting on one
# worker never noticed another one finishing; this push replaces that.
# DONE and PASS go through a gate: a report row for every acceptance row of the
# brief, none of them failed, and for a dev the brief's "Dev check" passing.

acceptance_rows() { # <brief> -> the row numbers of its acceptance table
  awk '/^#+ .*[Aa]cceptance/ { on = 1; next } on && /^#/ { exit }
       on && /^\| *[0-9]+ *\|/ { split($0, a, "|"); n = a[2]; gsub(/ /, "", n); print n }' "$1"
}

report_rows() { # <report> -> "<number> <result>" from its acceptance table; result is one word
  awk '/^#+ .*[Aa]cceptance/ || /^\**[Aa]cceptance\**:? *$/ { on = 1; next }
       on && /^\| *[0-9]+ *\|/ { split($0, a, "|"); n = a[2]; r = tolower(a[3]); gsub(/ /, "", n); gsub(/[*`_]/, "", r); gsub(/^ +| +$/, "", r)
         if (r ~ /^(not met|not-met|fail|failed)( |$)/) r = "fail"
         else if (r ~ /^(met|pass|passed)( |$)/) r = "pass"
         else if (r ~ /^pending( |$)/) r = "pending"
         else if (r ~ /^unavailable( |$)/) r = "unavailable"
         else if (r ~ /^inconclusive( |$)/) r = "inconclusive"
         else r = "unknown"
         print n, r; next }
       on && seen_table && !/^\|/ { exit }
       on && /^\|/ { seen_table = 1 }' "$1"
}

dev_check_cmd() { # <brief> -> the first `command` under "## Dev check", or nothing
  awk '/^#+ +Dev check/ { on = 1; next } on && /^#/ { exit }
       on && /`[^`]+`/ { match($0, /`[^`]+`/); print substr($0, RSTART + 1, RLENGTH - 2); exit }' "$1"
}

DONE_NOTE=""; DONE_UNTESTED=""
done_gate() { # <index> <task> <status> <report>: refuse what is not proven
  local i=$1 task=$2 status=$3 report=$4 brief="$TEAM_DIR/tasks/$2.md" rows results missing="" failed="" open="" n r cmd log
  case "$task" in CANDIDATE-*)
    if [ "$status" = PASS ]; then
      [ -f "$brief" ] || die "PASS refused: $task has no brief ($brief)."
      [ -f "$report" ] || die "PASS refused: write $report first."
      [ "$(grep -m1 '^RESULT:' "$report" | tr -d ' ')" = "RESULT:PASS" ] || die "PASS refused: $report does not say RESULT: PASS."
      local why; why=$(candidate_check "$task") || die "PASS refused: $why"
    fi ;;
  esac
  [ -f "$brief" ] || { DONE_NOTE="no brief $brief: gate skipped"; return 0; }
  rows=$(acceptance_rows "$brief")
  [ -n "$rows" ] || { DONE_NOTE="the brief has no acceptance rows: gate skipped"; return 0; }
  [ -f "$report" ] || die "write $report first (it needs a row for each acceptance row: $(echo $rows))."
  results=$(report_rows "$report")
  for n in $rows; do
    r=$(awk -v n="$n" '$1 == n { print $2; exit }' <<<"$results")
    case "$r" in
      "") missing="$missing $n" ;;
      fail) failed="$failed $n" ;;
      unknown) die "$status refused: acceptance row $n has no valid result. Write one of: pass, fail, pending, unavailable, inconclusive." ;;
      pass) ;;
      *) open="$open $n($r)" ;;
    esac
  done
  [ -z "$missing" ] || die "$status refused: the report has no row for acceptance row(s)$missing. Add each row with its result and evidence."
  [ -z "$failed" ] || die "$status refused: acceptance row(s)$failed failed. Fix them, or report BLOCKED (dev) / FAIL (tester)."
  if [ "${S_ROLE[$i]}" = dev ]; then
    cmd=$(dev_check_cmd "$brief")
    if [ -n "$cmd" ] && [ "$cmd" != "-" ]; then
      log="$TEAM_DIR/reports/$task-devcheck.log"
      say "squad done: running the dev check: $cmd"
      if ! ( cd "$(seat_cwd "$i")" && bash -c "$cmd" ) >"$log" 2>&1; then
        tail -15 "$log" >&2
        die "$status refused: the dev check failed ($cmd). Full output: $log"
      fi
    fi
  fi
  case "$task:$status" in CANDIDATE-*:PASS)
    [ -z "$(awk '$2 != "pass"' <<<"$results")" ] || die "PASS refused: the report has a row that is not pass (a candidate passes only when every row passes)."
    [ -z "$(awk '{ print $1 }' <<<"$results" | sort | uniq -d)" ] || die "PASS refused: the report lists a row twice."
    [ -z "$open" ] || die "PASS refused: row(s)$open are not tested; a candidate passes only when every row passes." ;; esac
  [ -z "$open" ] || { DONE_NOTE="not verified: rows$open"; DONE_UNTESTED=$(printf '%s' "$open" | sed 's/([a-z]*)//g; s/^ //; s/ /,/g'); }
}

cmd_done() {
  [ $# -ge 3 ] || die "usage: squad done <seat> <task> <status>"
  local seat=$1 task=$2 status=$3 i role="" report
  valid_task "$task"
  [[ "$status" =~ ^[A-Z_]{2,20}$ ]] || die "status '$status' must be one word in capitals (DONE, BLOCKED, PASS, FAIL, APPROVE, CHANGES, CONTRACT)."
  find_repo; load_conf
  i=$(seat_index "$seat") || die "no seat named '$seat' in this team."
  role=${S_ROLE[$i]}
  [ -z "${TEAM_ROLE:-}" ] || [ "$TEAM_ROLE" = "$seat" ] || die "$TEAM_ROLE cannot report for $seat: a seat reports only as itself."
  case "$task:$status" in CANDIDATE-*:PASS|CANDIDATE-*:FAIL) [ "$role" = tester ] || die "only the tester reports a candidate's $status." ;; esac
  case "$status" in APPROVE|CHANGES) [ "$role" = lead ] || [ "$role" = reviewer ] || die "only the lead or a reviewer gives a verdict." ;; esac
  case "$role" in
    dev) report="$TEAM_DIR/reports/$task-dev.md" ;;
    tester) if [ "$status" = CONTRACT ]; then report="$TEAM_DIR/reports/$task-contract.md"; else report="$TEAM_DIR/reports/$task-test.md"; fi ;;
    reviewer|lead) report=$(ls -t "$TEAM_DIR/reports/$task"-review-*.md 2>/dev/null | head -1 || true) ;;
    *) report="" ;;
  esac
  DONE_NOTE=""
  case "$role:$status" in dev:DONE|tester:PASS) done_gate "$i" "$task" "$status" "$report" ;; esac
  local head="" build=""   # a verdict covers one exact commit of the task; a candidate's PASS one build (ticket 018)
  case "$task:$status" in CANDIDATE-*:PASS) build=$(plan_hash "$TEAM_DIR/candidates/$task" 2>/dev/null || true) ;; esac
  case "$status" in APPROVE|CHANGES) head=$(git -C "$WT_ROOT/integration" rev-parse -q --verify "task/$task" 2>/dev/null || true) ;; esac
  [ -z "$report" ] || [ -f "$report" ] || say "squad: note — $report does not exist yet; write the report first."
  log_event "$seat" "$task" "$status" "${report:+report=$(basename "$report")}" "$(usage_tag)${DONE_UNTESTED:+ untested=$DONE_UNTESTED}${head:+ head=$head}${build:+ build=$build}"
  [ "$seat" = "$LEAD" ] && return 0
  # Codex injects a message that arrives mid-turn into the running turn and
  # would drop the unfinished step; told to finish first, it does (tested).
  local msg="[squad] $seat finished $task: $status${report:+ — report: $report}${DONE_NOTE:+ ($DONE_NOTE)}. (Notification: first finish what you were doing, then handle this.)"
  notice_keep "$seat" "$task" "$status" "$msg"
  herdr_team agent prompt "$LEAD" "$msg" >/dev/null || die "could not reach the lead; the event is in $TEAM_DIR/events.log"
  say "told $LEAD: $msg"
}

# squad git <subcommand> <args> — the git writes a team needs, for Codex seats.
# Codex's workspace-write sandbox keeps .git read-only by design (also the git
# dir a worktree points to), so switch/add/commit/merge fail inside it. This
# command, allowed by one Codex rule, runs only those writes, only inside a
# squad team; it pushes only the integration branch and never forces or deletes.
cmd_git() {
  find_repo
  [ -f "$TEAM_DIR/team.conf" ] || die "squad git only runs inside a repository with a squad team."
  local here; here=$(pwd -P)
  case "$here/" in "$REPO"/*|"$WT_ROOT"/*) ;; *) die "squad git only runs inside the team's repository or worktrees." ;; esac
  case "${1:-}" in
    switch|add|commit|merge|rebase|restore|stash) ;;
    push) # ticket 022: only the integration branch, only to origin, no arguments
      load_conf
      [ $# -eq 1 ] || die "squad git push takes no arguments: it pushes $TEAM_BASE to origin."
      case "$TEAM_BASE" in main|master|production|prod) die "squad git push: the team's base is $TEAM_BASE; main and production stay the owner's." ;; esac
      [ "$(git symbolic-ref -q --short HEAD)" = "$TEAM_BASE" ] || die "squad git push: only $TEAM_BASE is pushed (run it in the integration worktree). main and production stay the owner's."
      exec git push --no-follow-tags origin "refs/heads/$TEAM_BASE:refs/heads/$TEAM_BASE" ;;
    branch) case " $* " in *" -d "*|*" -D "*|*" --delete "*|*" -m "*|*" -M "*|*" --force "*) die "squad git branch: deleting, renaming or forcing branches is not allowed." ;; esac ;;
    *) die "squad git: '${1:-}' is not allowed. Allowed: switch add commit merge rebase restore stash branch push. Read-only git (status, diff, log, show) runs as plain git." ;;
  esac
  case " $* " in *" --force "*|*" -f "*|*" --force-with-lease"*) die "squad git: forcing is not allowed." ;; esac
  exec git "$@"
}

# squad permissions — one-time machine setup: Claude Code's status line set to
# 'squad statusline' (plan usage) unless you already have one. On a machine
# with Codex it also adds the rules so 'squad herdr', 'squad git' and
# 'squad done' never ask.
cmd_permissions() {
  local rules="${CODEX_HOME:-$HOME/.codex}/rules/default.rules"
  local sub rule
  # Codex rules only on a machine that has Codex (a team may still seat it)
  command -v codex >/dev/null 2>&1 || rules=""
  [ -z "$rules" ] || mkdir -p "$(dirname "$rules")"
  for sub in herdr git "done" heavy dispatch merge notify consult decisions report wait-owner seen; do
    [ -n "$rules" ] || break
    rule="prefix_rule(pattern=[\"$SQUAD_HOME/bin/squad\", \"$sub\"], decision=\"allow\")"
    if grep -qxF "$rule" "$rules" 2>/dev/null; then say "ok       Codex may run 'squad $sub' ($rules)"; continue; fi
    printf '%s\n' "$rule" >>"$rules"
    say "Added to $rules:"
    say "  $rule"
  done
  local claude_settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" current tmp
  local line='command -v squad >/dev/null 2>&1 && squad statusline 2>/dev/null || true'
  current=$(jq -r '.statusLine.command // empty' "$claude_settings" 2>/dev/null || true)
  if [ "$current" = "$line" ]; then
    say "ok       Claude status line shows plan usage"
  elif [ -n "$current" ]; then
    say "note     Claude already has a status line; left as is. For usage bars, use: squad statusline"
  else
    mkdir -p "$(dirname "$claude_settings")"
    [ -s "$claude_settings" ] || echo '{}' >"$claude_settings"
    tmp=$(mktemp)
    jq --arg c "$line" '.statusLine = {type: "command", command: $c}' "$claude_settings" >"$tmp" && cat "$tmp" >"$claude_settings"
    rm -f "$tmp"
    say "Set Claude's status line to 'squad statusline' ($claude_settings)"
  fi
}

# The install command a fresh worktree needs, from the lockfile in the repo.
detect_setup() {
  local r=$REPO
  if   [ -f "$r/pnpm-lock.yaml" ]; then echo "pnpm install --frozen-lockfile"
  elif [ -f "$r/yarn.lock" ] && [ -f "$r/.yarnrc.yml" ]; then echo "yarn install --immutable"
  elif [ -f "$r/yarn.lock" ]; then echo "yarn install --frozen-lockfile"
  elif [ -f "$r/package-lock.json" ]; then echo "npm ci"
  elif [ -f "$r/bun.lock" ] || [ -f "$r/bun.lockb" ]; then echo "bun install --frozen-lockfile"
  elif [ -f "$r/uv.lock" ]; then echo "uv sync"
  elif [ -f "$r/poetry.lock" ]; then echo "poetry install"
  elif [ -f "$r/Gemfile.lock" ]; then echo "bundle install"
  fi
}

cmd_init() {
  parse_preset_flag "$@"
  find_repo
  local conf_src
  if [ -n "$PRESET" ]; then conf_src=$(preset_path "$PRESET")
  elif [ -f "$USER_CONF" ]; then conf_src=$USER_CONF
  else conf_src=$(preset_path default); fi

  mkdir -p "$TEAM_DIR/roles" "$TEAM_DIR/reports" "$TEAM_DIR/tasks"
  say "Setting up $TEAM_DIR"
  local new_conf=0; [ -e "$TEAM_DIR/team.conf" ] || new_conf=1
  copy_if_missing "$conf_src" "$TEAM_DIR/team.conf"
  if [ "$new_conf" = 1 ] && [ -n "$PRESET" ]; then mark_preset "$TEAM_DIR/team.conf" "$PRESET"
  elif [ "$new_conf" = 1 ] && [ "$conf_src" != "$USER_CONF" ]; then mark_preset "$TEAM_DIR/team.conf" default; fi
  # a new team.conf with an empty 'setup' line gets the repo's install command
  local detected; detected=$(detect_setup)
  if [ "$new_conf" = 1 ] && [ -n "$detected" ] && grep -qE '^setup[[:space:]]*$' "$TEAM_DIR/team.conf"; then
    local tmp; tmp=$(mktemp)
    awk -v cmd="$detected" '/^setup[[:space:]]*$/ && !done {print "setup " cmd; done=1; next} {print}' "$TEAM_DIR/team.conf" >"$tmp" \
      && cat "$tmp" >"$TEAM_DIR/team.conf"; rm -f "$tmp"
    say "  setup    $detected (detected; change it in .team/team.conf)"
  fi
  copy_if_missing "$TEMPLATES/SPEC.md" "$TEAM_DIR/SPEC.md"
  copy_if_missing "$TEMPLATES/TASKS.md" "$TEAM_DIR/TASKS.md"
  copy_if_missing "$TEMPLATES/GOAL.md" "$TEAM_DIR/GOAL.md"
  copy_if_missing "$TEMPLATES/DECISIONS.md" "$TEAM_DIR/DECISIONS.md"
  copy_if_missing "$TEMPLATES/LESSONS.md" "$TEAM_DIR/LESSONS.md"
  mutex "$TEAM_DIR/.feedback.lock"   # the same lock as squad feedback: never copy over a saved entry
  copy_if_missing "$TEMPLATES/FEEDBACK.md" "$TEAM_DIR/FEEDBACK.md"
  rmdir "$TEAM_DIR/.feedback.lock"
  mkdir -p "$TEAM_DIR/observer" "$TEAM_DIR/consult"

  # Keep team files out of commits without touching the tracked .gitignore.
  local exclude; exclude="$(cd "$REPO" && git rev-parse --git-common-dir)/info/exclude"
  case "$exclude" in /*) ;; *) exclude="$REPO/$exclude" ;; esac
  mkdir -p "$(dirname "$exclude")"
  grep -qxF '.team/' "$exclude" 2>/dev/null || printf '.team/\n' >>"$exclude"

  update_conf
  load_conf
  # a new team starts with a draft plan: no task starts before the planner proves it and the owner approves it
  [ "$new_conf" = 1 ] && grep -qE '^[[:space:]]*seat[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+planner([[:space:]]|$)' "$TEAM_DIR/team.conf" 2>/dev/null && [ ! -f "$TEAM_DIR/PLAN.md" ] \
    && SUBST_N=1 SUBST_F1="{{GOAL}}" SUBST_T1="(the goal: squad plan \"<goal>\")" subst "$TEMPLATES/PLAN.md" >"$TEAM_DIR/PLAN.md"
  # Protocol and roles belong to the tool: refresh them so upgrades take effect.
  render_team_files
  say "  updated  .team/PROTOCOL.md, .team/roles/ and .team/tasks/_TEMPLATE.md"
  write_roster
  say ""
  say "Team of $(seat_count) seats defined in .team/team.conf (from ${conf_src/#$HOME/~})."
  say "Next: write your goal in .team/GOAL.md, then run 'squad up' (from any terminal: it opens this repository's own herdr session)."
}

# ---- keeping team.conf up to date ---------------------------------------------------
# A new squad version brings new settings and seats. update_conf adds to an existing
# team.conf what its preset has and the file lacks (settings by keyword, seats by role),
# says what it added, and leaves everything that is there alone. 'upgrade off' stops it.
# The preset is the one recorded at init ("# preset: <name>"), else 'default'.
conf_preset() { sed -n 's/^# preset: *\([A-Za-z0-9_-]*\).*/\1/p' "$1" 2>/dev/null | head -1; }

mark_preset() { # <conf> <name>: record the preset a team.conf came from (atomic rename)
  local tmp="$1.tmp.$$"
  { printf '# preset: %s\n' "$2"; grep -v '^# preset:' "$1" || true; } >"$tmp" && mv "$tmp" "$1"
}

update_conf() { # the whole read, decide and write runs under one mutex
  [ -f "$TEAM_DIR/team.conf" ] || return 0
  local rc=0
  mutex "$TEAM_DIR/.conf.lock"
  update_conf_locked || rc=$?
  rmdir "$TEAM_DIR/.conf.lock" 2>/dev/null || true
  return "$rc"
}

update_conf_locked() {
  local conf="$TEAM_DIR/team.conf" preset src key rest line role devs adds="" tmp n
  grep -qE '^[[:space:]]*upgrade[[:space:]]+off([[:space:]]|#|$)' "$conf" && return 0
  preset=$(conf_preset "$conf")
  if [ -z "$preset" ]; then
    # an older team.conf has no mark: judge by its seats (one dev and no reviewer: small; five or more devs: large)
    local nd nr; nd=$(grep -cE '^[[:space:]]*seat[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+dev([[:space:]]|$)' "$conf" || true)
    nr=$(grep -cE '^[[:space:]]*seat[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+reviewer([[:space:]]|$)' "$conf" || true)
    if [ "$nd" -le 1 ] && [ "$nr" = 0 ]; then preset=small; elif [ "$nd" -ge 5 ]; then preset=large; else preset=default; fi
    mark_preset "$conf" "$preset"
    say "  note     team.conf had no preset mark; squad takes it as '$preset' (from its seats) and wrote '# preset: $preset' at the top. Change that line to choose another."
  fi
  src="$PRESETS/$preset.conf"
  [ -f "$src" ] || { say "  note     team.conf names preset '$preset', which squad does not have: not updated."; return 0; }
  # settings: each keyword of the preset that team.conf does not have
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    read -r key rest <<<"$line" || true
    case "${key:-}" in ""|seat) continue ;; esac
    grep -qE "^[[:space:]]*$key([[:space:]]|$)" "$conf" && continue
    [ "$key" = setup ] && [ -z "$rest" ] && rest=$(detect_setup)
    adds="$adds$key${rest:+ $rest}"$'\n'
  done <"$src"
  # seats: each role of the preset that team.conf has no seat for
  devs=$(awk '$1 == "seat" && $4 == "dev" { d = d (d ? "," : "") $2 } END { print d }' "$conf")
  for role in tester reviewer observer planner critic; do
    awk -v r="$role" '$1 == "seat" && $4 == r { f = 1 } END { exit !f }' "$conf" && continue
    line=$(awk -v r="$role" '$1 == "seat" && $4 == r { print; exit }' "$src")
    [ -n "$line" ] || continue
    if awk -v n="$(awk '{print $2}' <<<"$line")" '$1 == "seat" && $2 == n { f = 1 } END { exit !f }' "$conf"; then
      say "  note     preset seat '$(awk '{print $2}' <<<"$line")' not added: team.conf already has a seat with that name."
      continue
    fi
    if [ "$role" = reviewer ]; then
      [ -n "$devs" ] || continue
      line=$(awk -v d="$devs" '{ $5 = d; print }' <<<"$line")
    fi
    adds="$adds$line"$'\n'
  done
  # seats that must never wait on a prompt: a Codex reviewer gets -a never (an action that needs
  # approval is refused, not asked: openai/codex mcp_tool_call.rs), a Claude observer gets dontAsk
  local fixed
  local seatfix='
    { c = index($0, "#"); code = c ? substr($0, 1, c - 1) : $0; com = c ? substr($0, c) : ""; sub(/[[:space:]]+$/, "", code); sub(/^[[:space:]]+/, "", code)
      split(code, f, /[[:space:]]+/); add = ""
      # a seat that already bypasses approvals is left alone: codex refuses -a together with the bypass flag
      if (f[1] == "seat" && f[3] == "codex" && (f[4] == "reviewer" || f[4] == "critic") && (" " code " ") !~ / (-a|--ask-for-approval|--dangerously-bypass-approvals-and-sandbox|--yolo)[ =]/) add = "-a never"
      if (f[1] == "seat" && f[3] == "claude" && f[4] == "observer" && (" " code " ") !~ / (--permission-mode|--dangerously-skip-permissions)[ =]/) add = "--permission-mode dontAsk" }'
  fixed=$(awk "$seatfix"' add != "" { print f[2] ": " add }' "$conf")
  if [ -n "$fixed" ]; then
    tmp="$conf.tmp.$$"
    awk "$seatfix"' { if (add != "") print code " " add (com != "" ? "  " com : ""); else print }' "$conf" >"$tmp" && mv "$tmp" "$conf"
    say "  updated  .team/team.conf: seats that must never wait on a prompt:"
    printf '%s\n' "$fixed" | sed 's/^/             /'
  fi
  [ -n "$adds" ] || return 0
  tmp="$conf.tmp.$$"
  { cat "$conf"; printf '\n# added by squad update-conf on %s (preset %s)\n%s' "$(date '+%Y-%m-%d %H:%M')" "$preset" "$adds"; } >"$tmp" && mv "$tmp" "$conf"
  n=$(printf '%s' "$adds" | grep -c .)
  say "  updated  .team/team.conf: $n line(s) added from preset '$preset' (put 'upgrade off' in it to stop this):"
  printf '%s' "$adds" | sed 's/^/             /'
}

cmd_update_conf() {
  find_repo
  [ -f "$TEAM_DIR/team.conf" ] || die "no .team/team.conf here. Run 'squad init' first."
  local before; before=$(cksum <"$TEAM_DIR/team.conf")
  update_conf
  [ "$before" != "$(cksum <"$TEAM_DIR/team.conf")" ] || say "team.conf has every setting and seat of its preset: nothing to add."
  load_conf
}

cmd_new() {
  [ $# -ge 1 ] || die "usage: squad new <dir> [--preset NAME]"
  local dir=$1; shift
  need git ""
  [ ! -e "$dir" ] || die "'$dir' already exists. Use 'squad init' inside it instead."
  mkdir -p "$dir"
  ( cd "$dir"
    git init -q
    git commit -q --allow-empty -m "Initial commit" \
      || die "git could not create the first commit (set user.name and user.email)."
    cmd_init "$@" )
  say ""
  say "Project created in $dir. Then:  cd $dir && squad up"
}

cmd_config() {
  parse_preset_flag "$@"
  if [ -n "$PRESET" ] || [ ! -f "$USER_CONF" ]; then
    mkdir -p "$(dirname "$USER_CONF")"
    cp "$(preset_path "${PRESET:-default}")" "$USER_CONF"
    mark_preset "$USER_CONF" "${PRESET:-default}"
    say "Wrote your default team from the '${PRESET:-default}' preset."
  fi
  say "Your default team: $USER_CONF"
  say "Edit it to change the seats every new 'squad init' starts with."
}

cmd_presets() {
  local f
  for f in "$PRESETS"/*.conf; do
    printf '%-10s %s\n' "$(basename "$f" .conf)" "$(grep -c '^seat ' "$f") seats"
  done
}

# ---- doctor ------------------------------------------------------------------

cmd_doctor() {
  local ok=0 tool i n kinds=""
  for tool in git jq herdr; do
    if command -v "$tool" >/dev/null 2>&1; then say "ok       $tool"; else say "MISSING  $tool"; ok=1; fi
  done
  if git rev-parse --git-dir >/dev/null 2>&1; then
    find_repo
    if [ -f "$TEAM_DIR/team.conf" ]; then
      load_conf; n=$(seat_count)
      for ((i = 0; i < n; i++)); do
        case " $kinds " in *" ${S_KIND[$i]} "*) continue ;; esac
        kinds="$kinds ${S_KIND[$i]}"
        if command -v "${S_KIND[$i]}" >/dev/null 2>&1; then say "ok       ${S_KIND[$i]} (agent)"
        else say "MISSING  ${S_KIND[$i]} (agent used in team.conf; if its command has another name, ignore this)"; ok=1; fi
      done
    else
      say "note     no .team/team.conf here yet (run 'squad init')"
    fi
  fi
  if command -v codex >/dev/null 2>&1; then
    local codex_rules="${CODEX_HOME:-$HOME/.codex}/rules/default.rules"
    local sub missing=""
    for sub in herdr git "done" heavy; do
      grep -qF "\"$SQUAD_HOME/bin/squad\", \"$sub\"" "$codex_rules" 2>/dev/null || missing="$missing $sub"
    done
    if [ -z "$missing" ]; then
      say "ok       codex may run the squad commands of its seats without asking"
    else
      say "note     Codex seats will ask before 'squad herdr' / 'squad git' calls; run: squad permissions"
    fi
  fi
  # Codex shows an "Update available" dialog on start that blocks a seat
  if command -v codex >/dev/null 2>&1; then
    local codex_conf="${CODEX_HOME:-$HOME/.codex}/config.toml"
    if grep -Eq '^check_for_update_on_startup *= *false' "$codex_conf" 2>/dev/null; then
      say "ok       codex update check off (no update dialog blocking seats)"
    else
      say "note     codex may show an update dialog that blocks a seat on start; to avoid it add"
      say "         check_for_update_on_startup = false   to $codex_conf"
    fi
  fi
  if [ "${HERDR_ENV:-}" = 1 ]; then say "ok       running inside herdr"; else say "note     not inside herdr ('squad up' opens this repository's own herdr session)"; fi
  return $ok
}

# ---- up / brief --------------------------------------------------------------

require_herdr() {
  need herdr "See https://herdr.dev"
  need jq "(brew install jq / apt install jq)"
  [ "${HERDR_ENV:-}" = 1 ] || die "run this from a pane inside herdr (start 'herdr' in the repository first)."
}

mark_briefed() { mkdir -p "$TEAM_DIR/.briefed" && : >"$TEAM_DIR/.briefed/$1"; }
is_briefed() { [ -f "$TEAM_DIR/.briefed/$1" ]; }

brief() { # [seat names...] — none: every seat. The lead goes last.
  local i n failed=0 name want=" $* "; n=$(seat_count)
  wanted() { [ "$want" = "  " ] || case "$want" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
  for ((i = 0; i < n; i++)); do
    [ "${S_ROLE[$i]}" != lead ] || continue
    name=${S_NAME[$i]}
    wanted "$name" || continue
    # role already loaded as a system prompt: nothing to type, nothing to wait for
    if loads_role "${S_KIND[$i]}"; then mark_briefed "$name"; continue; fi
    if herdr agent prompt "$name" \
      "You are '$name' on an agent team. Read $TEAM_DIR/PROTOCOL.md and $(role_file "${S_ROLE[$i]}") now. Do not start any work yet. Reply with the single word READY." \
      --wait --timeout 180000 >/dev/null; then
      say "  briefed $name"; mark_briefed "$name"
    else
      say "  could not brief $name (see the error above; open its pane and check it)"
      failed=1
    fi
  done
  wanted "$LEAD" || return $failed
  # The lead is briefed last and not waited on: it goes straight to the human.
  # A restarted team (approved spec on disk) resumes from the files instead of
  # starting over: agents have no memory, everything is in .team/ and git.
  local lead_msg
  lead_msg="You are the lead of an agent team. Read $TEAM_DIR/PROTOCOL.md, $TEAM_DIR/ROSTER.md and $(role_file lead) now, then begin Phase 1: read $TEAM_DIR/GOAL.md (ask me for the goal only if it is empty), write the spec and continue without waiting for me."
  if grep -qE '^Status: *APPROVED' "$TEAM_DIR/SPEC.md" 2>/dev/null; then
    lead_msg="You are the lead of an agent team that is resuming after a restart; nobody remembers earlier work, it is all in files. Read $TEAM_DIR/PROTOCOL.md, $TEAM_DIR/ROSTER.md and $(role_file lead), then $TEAM_DIR/SPEC.md (already approved), $TEAM_DIR/TASKS.md, the reports in $TEAM_DIR/reports/ and $TEAM_DIR/events.log. Tell me in a few lines where things stand and what you will do next, then continue Phase 3 from the current state: never redo merged tasks, and check git for work on task branches that TASKS.md does not show yet."
  fi
  local k; for ((k = 0; k < n; k++)); do [ "${S_NAME[$k]}" = "$LEAD" ] && break; done
  if loads_role "${S_KIND[$k]}"; then
    # the role is in the lead's system prompt: one short line to start it
    lead_msg="Start: read GOAL.md (ask me for the goal only if it is empty), write the spec, then run the team until everything is green."
    grep -qE '^Status: *APPROVED' "$TEAM_DIR/SPEC.md" 2>/dev/null \
      && lead_msg="Resume after a restart: read SPEC.md (approved), TASKS.md, reports/ and events.log, tell me where things stand, then continue Phase 3."
  fi
  case " ${RESUMED[*]:-} " in *" $LEAD "*) lead_msg=$(restart_note) ;; esac
  if herdr agent prompt "$LEAD" "$lead_msg" >/dev/null; then
    say "  briefed $LEAD"; mark_briefed "$LEAD"
  else
    say "  could not brief $LEAD (open its pane and check it)"
    failed=1
  fi
  return $failed
}

restart_note() {
  echo "squad restarted the team at $(date +%H:%M); your conversation is resumed. Before you go on, check what the stop left behind: squad heavy --status (the lock and the queue), uncommitted work in each worktree under $WT_ROOT, and $TEAM_DIR/events.log since the stop. Then continue from the files."
}

cmd_brief() {
  require_herdr; find_repo; load_conf; render_team_files; write_herdr_socket; write_roster
  brief || die "some seats were not briefed. Fix them, then run 'squad brief' again."
}

setup_worktree() {
  [ -n "$SETUP_CMD" ] || return 0
  say "  running setup in ${1#"$WT_ROOT"/}"
  ( cd "$1" && eval "$SETUP_CMD" ) || die "the setup command failed in $1"
}

split() { # <pane> <direction> <cwd> [ratio kept by <pane>] -> new pane id
  local ratio=()
  [ -n "${4:-}" ] && ratio=(--ratio "$4")
  herdr pane split "$1" --direction "$2" --cwd "$3" ${ratio[@]+"${ratio[@]}"} --no-focus \
    | jq -er '.result.pane.pane_id' || die "unexpected response from herdr while creating panes."
}

# lay_row <first pane> <direction> <seat index...> — put the seats in equal
# parts along <direction>; the first seat takes <first pane>. Sets PANES[].
lay_row() {
  local pane=$1 dir=$2; shift 2
  local total=$# k=0 i
  for i in "$@"; do
    if [ "$k" -eq 0 ]; then PANES[$i]=$pane
    else
      # keep 1/(remaining) of the space for what is already there
      PANES[$i]=$(split "$pane" "$dir" "$(seat_cwd "$i")" "$(awk -v r="$((total - k + 1))" 'BEGIN { printf "%.3f", 1 / r }')")
      pane=${PANES[$i]}
    fi
    k=$((k + 1))
  done
}

new_tab() { # <workspace> <label> <cwd> -> root pane of the new tab
  herdr tab create --workspace "$1" --label "$2" --cwd "$3" --no-focus \
    | jq -er '.result.root_pane.pane_id' || die "unexpected response from herdr while creating a tab."
}

# The team workspace, layout picked by terminal width (SQUAD_LAYOUT overrides):
#   talk     (default)      tab team: lead 60% | devs, live strip below
#                           tab review: reviewers + tester · tab changes: lazygit
#   mission  (>= 220 cols)  one tab: lead | each dev | reviewers + tester, strip below
#   focus    (< 120 cols)   tabs: lead + strip · devs · review · changes
make_layout() { # <workspace> <tab> <root pane>; sets PANES[] and says the mode
  local ws=$1 tab=$2 root=$3 width height mode i strip p ratio obs="" plnr="" crt=""
  local devs=() others=()
  for ((i = 0; i < $(seat_count); i++)); do
    case "${S_ROLE[$i]}" in dev) devs+=("$i") ;; reviewer|tester) others+=("$i") ;; observer) obs=$i ;; planner) plnr=$i ;; critic) crt=$i ;; esac
  done
  read -r width height < <(herdr pane layout --pane "$root" | jq -r '.result.layout.area | "\(.width) \(.height)"')
  mode=${SQUAD_LAYOUT:-}
  if [ -z "$mode" ]; then
    # no client attached yet (started from outside herdr): width 0 -> talk
    if [ "${width:-0}" -ge 220 ]; then mode=mission; elif [ "${width:-0}" -gt 0 ] && [ "${width:-0}" -lt 120 ]; then mode=focus; else mode="talk"; fi
  fi
  herdr tab rename "$tab" team >/dev/null 2>&1 || true
  # live board: 5 rows at the bottom of the first tab
  [ "${height:-0}" -gt 0 ] 2>/dev/null || height=40
  ratio=$(awk -v h="$height" 'BEGIN { r = 1 - 6 / h; if (r < 0.75) r = 0.75; if (r > 0.95) r = 0.95; printf "%.3f", r }')
  strip=$(split "$root" down "$WT_ROOT/integration" "$ratio")
  herdr pane rename "$strip" watch >/dev/null 2>&1 || true
  herdr pane run "$strip" "$SQUAD_HOME/bin/squad watch" >/dev/null
  PANES[$LEAD_I]=$root
  case "$mode" in
    mission)
      p=$(split "$root" right "$(seat_cwd "${devs[0]:-$LEAD_I}")" 0.4)
      [ "${#devs[@]}" -gt 0 ] && lay_row "$p" right "${devs[@]}"
      if [ "${#others[@]}" -gt 0 ]; then
        p=$(split "${PANES[${devs[$((${#devs[@]} - 1))]:-$LEAD_I}]}" right "$(seat_cwd "${others[0]}")" 0.5)
        lay_row "$p" down "${others[@]}"
      fi ;;
    focus)
      [ "${#devs[@]}" -gt 0 ] && lay_row "$(new_tab "$ws" devs "$(seat_cwd "${devs[0]}")")" down "${devs[@]}"
      [ "${#others[@]}" -gt 0 ] && lay_row "$(new_tab "$ws" review "$(seat_cwd "${others[0]}")")" down "${others[@]}" ;;
    *)
      mode="talk"
      if [ "${#devs[@]}" -gt 0 ]; then
        p=$(split "$root" right "$(seat_cwd "${devs[0]}")" 0.6)
        lay_row "$p" down "${devs[@]}"
      fi
      [ "${#others[@]}" -gt 0 ] && lay_row "$(new_tab "$ws" review "$(seat_cwd "${others[0]}")")" right "${others[@]}" ;;
  esac
  if command -v lazygit >/dev/null 2>&1; then
    p=$(new_tab "$ws" changes "$WT_ROOT/integration")
    herdr pane rename "$p" changes >/dev/null 2>&1 || true
    herdr pane run "$p" "lazygit" >/dev/null
  fi
  if [ -n "$plnr" ]; then
    PANES[$plnr]=$(plan_tab "$ws" "$plnr")
    [ -z "$crt" ] || PANES[$crt]=$(split "${PANES[$plnr]}" right "$WT_ROOT/integration" 0.5)   # the critic beside the planner
  fi
  [ -z "$obs" ] || PANES[$obs]=$(observer_tab "$ws" "$obs")
  report_tab "$ws"
  # name every seat's pane now, not when its agent starts: a seat held back
  # (trust dialog) must still be found by its label when 'squad up' resumes
  for ((i = 0; i < $(seat_count); i++)); do
    [ -n "${PANES[$i]:-}" ] && herdr pane rename "${PANES[$i]}" "${S_NAME[$i]}" >/dev/null 2>&1
  done
  say "  layout: $mode (${width:-?} columns; SQUAD_LAYOUT=talk|mission|focus to choose)"
}

plan_tab() { # <workspace> <planner index> -> the planner's pane, in its own tab "plan"
  local p
  p=$(new_tab "$1" plan "$WT_ROOT/integration")
  herdr pane rename "$p" "${S_NAME[$2]}" >/dev/null 2>&1 || true
  echo "$p"
}

observer_tab() { # <workspace> <observer index> -> the observer's pane; the watcher that drives its passes below
  local p w
  p=$(new_tab "$1" observer "$WT_ROOT/integration")
  w=$(split "$p" down "$WT_ROOT/integration" 0.7)
  herdr pane rename "$w" observe >/dev/null 2>&1 || true
  herdr pane run "$w" "$SQUAD_HOME/bin/squad watch --observe" >/dev/null
  herdr pane rename "$p" "${S_NAME[$2]}" >/dev/null 2>&1 || true
  echo "$p"
}

revive_helpers() { # <pane list json>: after a herdr restart a helper pane holds only its shell: run its program again
  local l c p fg
  for l in watch observe report changes; do
    case " ${S_NAME[*]} " in *" $l "*) continue ;; esac   # a seat with that name is an agent's pane, not the helper
    p=$(jq -r --arg l "$l" '.result.panes[] | select(.label == $l) | .pane_id' <<<"$1" | head -1)
    [ -n "$p" ] || continue
    # idle: herdr names only bare shells (no arguments) in the foreground; anything else, or no answer, is left alone
    fg=$(herdr pane process-info --pane "$p" 2>/dev/null | jq -r '.result.process_info.foreground_processes | if length > 0 and all(.cmdline | test("^-?([^ ]*/)?(zsh|bash|sh|fish)$")) then "shell" else "busy" end' 2>/dev/null) || fg=""
    [ "$fg" = shell ] || continue
    case "$l" in
      watch) c="$SQUAD_HOME/bin/squad watch" ;;
      observe) c="$SQUAD_HOME/bin/squad watch --observe" ;;
      report) c="$SQUAD_HOME/bin/squad report --live" ;;
      changes) command -v lazygit >/dev/null 2>&1 || continue; c=lazygit ;;
    esac
    if herdr pane run "$p" "$c" >/dev/null 2>&1; then say "  restarted the $l pane"; fi
  done
}

report_tab() { # <workspace>: the report, live, in the terminal ('o' opens the HTML page)
  local p
  p=$(new_tab "$1" report "$WT_ROOT/integration")
  herdr pane rename "$p" report >/dev/null 2>&1 || true
  herdr pane run "$p" "$SQUAD_HOME/bin/squad report --live" >/dev/null
}

# herdr's `agent start` does not wait for the pane's shell: on a shell that is
# still starting (rc files, plugin managers) it fails at once with
# agent_pane_busy. Retry that case for up to a minute; anything else is final.
START_ERR=""
start_agent() { # <herdr agent start args...>
  local out deadline=$((SECONDS + 60))
  while :; do
    if out=$(herdr agent start "$@" 2>&1); then START_ERR=""; return 0; fi
    START_ERR=$out
    case "$out" in
      *agent_pane_busy*) [ "$SECONDS" -lt "$deadline" ] || { printf '%s\n' "$out" >&2; return 1; }; sleep 1 ;;
      *) printf '%s\n' "$out" >&2; return 1 ;;
    esac
  done
}

# Name the first-run dialog a stuck agent is showing, from its pane's text.
explain_stuck() { # <name> <pane> [herdr's error]
  local text; text=$(herdr pane read "$2" 2>/dev/null || true)
  case "${3:-}" in
    *agent_name_taken*)
      say "    → another workspace of this herdr session already runs a seat named '$1' (usually a second 'squad up')."
      say "      Close the extra workspace (squad down closes one), then run 'squad up' once."
      return 0 ;;
  esac
  case "$text" in
    *"rust this folder"*|*"o you trust"*|*"afety check"*)
      say "    → it asks whether to trust this folder (first run of this project only)."
      say "      Open pane '$1', choose trust."
      STUCK_ON_TRUST=1 ;;
    *"pdate available"*)
      say "    → Codex wants to update itself before starting. Open pane '$1' and choose Skip."
      say "      To stop this for good: check_for_update_on_startup = false in ~/.codex/config.toml" ;;
    *"ign in"*|*"og in"*|*"login"*)
      say "    → it is not signed in. Open pane '$1' and sign in once." ;;
    *)
      say "    → open pane '$1' and answer what it shows (usually a first-run dialog)." ;;
  esac
}

# Agents whose CLI can load a system prompt at start: their role is loaded
# there (survives /clear and /new, nothing typed into the pane, no READY
# round trip). Others are briefed with a typed message.
loads_role() { case "$1" in claude|codex) return 0 ;; *) return 1 ;; esac; }

write_seat_file() { # <index> -> path of .team/seats/<seat>.md
  local i=$1 f="$TEAM_DIR/seats/${S_NAME[$1]}.md"
  mkdir -p "$TEAM_DIR/seats"
  {
    printf '# You are seat `%s` (role: %s) on an agent team\n\n' "${S_NAME[$i]}" "${S_ROLE[$i]}"
    printf 'This is loaded at start and stays across context clears. Team directory: %s\n\n' "$TEAM_DIR"
    cat "$TEAM_DIR/PROTOCOL.md"; printf '\n\n'
    cat "$(role_file "${S_ROLE[$i]}")"
  } >"$f"
  echo "$f"
}

START_FAILED=0
STUCK_ON_TRUST=0
TRUST_WAIT=" "  # agent kinds held back until one trust dialog is answered
STARTED=()  # seats started or adopted in this run: only these get briefed
RESUMED=()  # seats that came back with their own conversation

write_seat_settings() { # <index> -> settings file with the SessionStart hook that records the session id
  local f="$TEAM_DIR/seats/${S_NAME[$1]}.settings.json"
  mkdir -p "$TEAM_DIR/seats"
  # the observer runs in dontAsk mode: it never waits on a prompt; what it may do is listed here
  # (Claude Code docs, permissions: "//path" is absolute; Edit rules cover every file-writing tool;
  # read-only commands such as git log, cat and ls need no rule)
  local allow='[]'
  if [ "${S_ROLE[$1]}" = observer ]; then
    # rules match the command text as written: both the plain name and the full path the role file renders
    allow=$(jq -n --arg obs "Edit(/$TEAM_DIR/observer/**)" --arg sq "$SQUAD_HOME/bin/squad" \
      '[$obs] + ([$sq, "squad"] | map("Bash(" + . + " heavy --status)", "Bash(" + . + " herdr agent read *)", "Bash(" + . + " herdr agent list*)", "Bash(" + . + " report*)"))')
  fi
  jq -n --arg c "'$SQUAD_HOME/bin/squad' session-id '${S_NAME[$1]}'" --argjson allow "$allow" --argjson h "$(seat_hooks)" \
    '{hooks: ($h + {SessionStart: ([{hooks: [{type: "command", command: $c}]}] + $h.SessionStart)})} + (if ($allow | length) > 0 then {permissions: {allow: $allow}} else {} end)' >"$f"
  echo "$f"
}

seat_hooks() { # -> the hooks every Claude seat gets, as JSON: one event a line (a new hook is one more line)
  jq -n --arg s "'$SQUAD_HOME/bin/squad' seat-hook" '
    def h(e): [{hooks: [{type: "command", command: ($s + " " + e)}]}];
    {}
    + {SessionStart: h("SessionStart")}
    + {PermissionRequest: h("PermissionRequest")}
    + {PreToolUse: (h("AskUserQuestion") | map({matcher: "AskUserQuestion"} + .))}
    + {StopFailure: h("StopFailure")}
    + {Stop: h("Stop")}'
}

write_local_hooks() { # <worktree>: the same hooks in the worktree's own Claude settings, which Claude Code loads at
  # every start: a seat that herdr resumed without squad's options still has them. Other content of the file is kept:
  # only squad's own commands of an earlier write are replaced, also in a group that holds the user's command too.
  local f="$1/.claude/settings.local.json" cur='{}' tmp exclude="$GIT_COMMON/info/exclude"
  [ -d "$1" ] || return 0
  git -C "$1" ls-files --error-unmatch .claude/settings.local.json >/dev/null 2>&1 && return 0   # tracked: the project's own file
  [ ! -s "$f" ] || cur=$(cat "$f")
  jq -e 'type == "object"' <<<"$cur" >/dev/null 2>&1 || return 0   # not JSON squad can read: left alone
  mkdir -p "$1/.claude"; tmp="$f.squad.$$"
  if jq --argjson h "$(seat_hooks)" --arg m "/bin/squad' seat-hook " \
       '.hooks = (reduce ($h | to_entries[]) as $e (.hooks // {}; .[$e.key] = ([(.[$e.key] // [])[]
           | if any(.hooks[]?; (.command // "") | contains($m)) then .hooks |= map(select((.command // "") | contains($m) | not)) | select(.hooks | length > 0) else . end]
         + $e.value)))' \
       <<<"$cur" >"$tmp" 2>/dev/null; then mv "$tmp" "$f"; else rm -f "$tmp"; return 0; fi
  mkdir -p "$(dirname "$exclude")"
  grep -qxF '.claude/settings.local.json' "$exclude" 2>/dev/null || printf '.claude/settings.local.json\n' >>"$exclude"
}

# squad seat-hook <event> — the hooks of a Claude seat (stdin: the hook's JSON). It prints nothing and never
# fails, so Claude Code goes on as without a hook: squad never answers for the seat, it only tells the owner.
cmd_seat_hook() { ( seat_hook "$@" ) >/dev/null 2>&1 || true; return 0; }

hook_args() { # the argument lists of this process's ancestors: the agent that ran the hook is one of them
  local p=$$ k
  for k in 1 2 3 4 5 6; do
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ') || break
    [ -n "$p" ] && [ "$p" -gt 1 ] || break
    ps -o args= -p "$p" 2>/dev/null || true
  done
}

hook_seat() { # <hook json> <ancestors' arguments> -> the seat this session is: its pane's TEAM_ROLE, the seat file in its arguments, or its recorded conversation
  local s=${TEAM_ROLE:-} id f
  [ -n "$s" ] || s=$(printf '%s\n' "$2" | sed -n "s|.*$TEAM_DIR/seats/\\([a-z][a-z0-9_-]*\\)\\.md.*|\\1|p" | head -1)
  if [ -z "$s" ]; then
    id=$(jq -r '.session_id // empty' <<<"$1" 2>/dev/null || true)
    [ -z "$id" ] || for f in "$TEAM_DIR"/seats/*.session; do
      [ -f "$f" ] && [ "$(cat "$f")" = "$id" ] && { s=${f##*/}; s=${s%.session}; break; }
    done
  fi
  [ -n "$s" ] && seat_index "$s" >/dev/null && echo "$s"
}

seat_hook() {
  local ev=${1:-} json seat task q err src args w n now; now=$(date +%s)
  json=$(cat)
  find_repo; load_conf
  args=$(hook_args)
  seat=$(hook_seat "$json" "$args") || return 0
  task=$(open_tasks | awk -v s="$seat" '$1 == s { print $2; exit }')
  case "$ev" in
    PermissionRequest|AskUserQuestion)   # the seat stops and waits for the owner: the state file, and the owner is told at once
      w="$TEAM_DIR/seats/$seat.owner-wait"
      [ ! -f "$w" ] || [ $((now - $(num_in "$w"))) -ge 10 ] || return 0   # the same wait, reported twice
      if [ "$ev" = AskUserQuestion ]; then q=$(jq -r '.tool_input.questions[0].question // .tool_input.question // empty' <<<"$json" 2>/dev/null || true)
      else q=$(jq -r '"permission for \(.tool_name // "a tool"): \(.tool_input | (.command // .file_path // .url // tostring))"' <<<"$json" 2>/dev/null || true); fi
      q=$(clip 200 "$(printf '%s\n' "$q" | head -1)")
      mkdir -p "$TEAM_DIR/seats"; put "$w" "$now" "$q"
      owner_alert_end "wait-$seat"
      # in the background: the seat's dialog does not wait for the notification commands
      detached owner_alert "wait-$seat" "squad: $seat waits for you${task:+ ($task)}" "${q:-It shows a prompt or a question.}" ;;
    StopFailure)   # the turn ended on an error of the service: a usage limit, a sign-in error
      err=$(jq -r '.error // "error"' <<<"$json" 2>/dev/null || echo error)
      w=fail; [ "$err" != rate_limit ] || w=limit   # a usage limit: the key of the watchdog's own alert, so one notification
      [ -e "$TEAM_DIR/observer/.watchdog/held-$w-$seat" ] || log_event "$seat" "${task:--}" SEAT_STOPPED "$err"
      if [ "$err" = rate_limit ]; then
        [ -n "$LIMIT_FALLBACK" ] || detached owner_alert "limit-$seat" "squad: $seat at its usage limit" "Its turn stopped (rate_limit). It waits for you: answer its pane, or set limit_fallback <model> in team.conf."
      else   # told once until the seat works again (seats_tick ends it)
        detached owner_alert "fail-$seat" "squad: $seat stopped: $err" "Its turn ended on an error${task:+ with $task open}. Read its pane$([ "$err" != authentication_failed ] || printf ' and run /login there')."
      fi ;;
    SessionStart)   # started or resumed without squad's options (herdr resumed it bare)
      src=$(jq -r '.source // empty' <<<"$json" 2>/dev/null || true)
      case "$src" in startup|resume) ;; *) return 0 ;; esac
      case "$args" in *"$TEAM_DIR/seats/$seat.md"*) rm -f "$TEAM_DIR/seats/$seat.no-options"; owner_alert_end "options-$seat"; return 0 ;; esac
      if [ ! -f "$TEAM_DIR/seats/$seat.no-options" ]; then   # once per seat; the owner is told here too: the watch may not run (after a herdr restart its pane is only a shell)
        log_event "$seat" - SEAT_NO_OPTIONS "source=$src: it runs without its squad options"
        detached owner_alert "options-$seat" "squad: $seat runs without its squad options" "$seat runs without its squad options: run squad up."   # the watch's key: one notification
      fi
      : >"$TEAM_DIR/seats/$seat.no-options" ;;
    Stop)   # the turn ended: how many background tasks the seat still waits for (0: free), and when; seat_busy reads it (ticket 024)
      n=$(jq -r '(.background_tasks // []) | length' <<<"$json" 2>/dev/null) || return 0
      [ -z "$n" ] || { mkdir -p "$TEAM_DIR/seats"; put "$TEAM_DIR/seats/$seat.background" "$n $now"; } ;;
  esac
}

# squad session-id <seat> — the SessionStart hook of a Claude seat (stdin: the
# hook's JSON). Never fails: a hook error must not stop the agent.
cmd_session_id() { ( session_id "$@" ) >/dev/null 2>&1 || true; return 0; }
session_id() {
  local seat=${1:-} json id
  json=$(cat); id=$(jq -r '.session_id // empty' <<<"$json")
  [ -n "$seat" ] && [ -n "$id" ] || return 0
  find_repo; mkdir -p "$TEAM_DIR/seats"; printf '%s\n' "$id" >"$TEAM_DIR/seats/$seat.session"
  # a new or cleared session waits for no background work; a compaction keeps the session and what it waits for
  case "$(jq -r '.source // empty' <<<"$json")" in startup|resume|clear) rm -f "$TEAM_DIR/seats/$seat.background" ;; esac
}

record_sessions() { # <agents json>: herdr knows each running seat's conversation; keep it for resume
  local i n id; n=$(seat_count)
  mkdir -p "$TEAM_DIR/seats"
  for ((i = 0; i < n; i++)); do
    id=$(jq -r --arg n "${S_NAME[$i]}" '[.result.agents[] | select(.name == $n) | .agent_session.value // empty][0] // empty' <<<"$1" 2>/dev/null || true)
    [ -n "$id" ] && [ "$id" != "$(cat "$TEAM_DIR/seats/${S_NAME[$i]}.session" 2>/dev/null)" ] && printf '%s\n' "$id" >"$TEAM_DIR/seats/${S_NAME[$i]}.session"
  done
  return 0
}

seat_resume_id() { # <index> -> the conversation to resume, or nothing
  local i=$1 id f
  case "${S_KIND[$i]}" in
    claude)
      id=$(cat "$TEAM_DIR/seats/${S_NAME[$i]}.session" 2>/dev/null) || return 0
      [ -n "$id" ] || return 0
      for f in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/"$id".jsonl; do [ -f "$f" ] && { echo "$id"; return 0; }; done ;;
    codex)
      # the newest interactive Codex session started in this seat's folder; only
      # when no other Codex seat shares that folder (it could be the other's)
      # the id squad recorded for this seat (from herdr, while it ran); its rollout file must still exist
      id=$(cat "$TEAM_DIR/seats/${S_NAME[$i]}.session" 2>/dev/null) || return 0
      [ -n "$id" ] || return 0
      [[ "$id" =~ ^[A-Za-z0-9-]+$ ]] || return 0
      [ -n "$(find "${CODEX_HOME:-$HOME/.codex}/sessions" -name "rollout-*$id*.jsonl" -print 2>/dev/null | head -1)" ] && echo "$id" ;;
  esac
  return 0
}
start_seat() { # <index> <pane>
  local i=$1 pane=$2 name kind args
  name=${S_NAME[$i]}; kind=${S_KIND[$i]}; args=${S_ARGS[$i]}
  herdr pane rename "$pane" "$name" >/dev/null 2>&1 || true
  # The agent inherits its identity from the shell environment of its pane.
  herdr pane run "$pane" "export TEAM_ROLE='$name' TEAM_DIR='$TEAM_DIR' TEAM_BASE='$TEAM_BASE'; clear" >/dev/null
  # Agent arguments: the seat's own (split on spaces by design), then write
  # access to $TEAM_DIR — it lives outside the seat's worktree, and without it
  # every report, spec or task edit stops on a permission prompt.
  local -a start_args=("$name" --kind "$kind" --pane "$pane" --timeout 90000) agent_args=()
  # shellcheck disable=SC2206  # split on spaces by design
  [ -n "$args" ] && agent_args=($args)
  # …and the repository's git directory: a worktree's commits and merges write
  # there, outside the worktree, so without it every commit asks first.
  case "$kind" in claude|codex) agent_args+=(--add-dir "$TEAM_DIR" --add-dir "$GIT_COMMON") ;; esac
  # the lead reviews each task where it was built: the devs' worktrees
  case "${S_ROLE[$i]}:$kind" in lead:claude|observer:claude) agent_args+=(--add-dir "$WT_ROOT") ;; esac
  # the seat's identity, protocol and role as a system prompt
  if loads_role "$kind"; then
    local seat_file; seat_file=$(write_seat_file "$i")
    if [ "$kind" = claude ]; then agent_args+=(--append-system-prompt-file "$seat_file")
    else   # Codex: a short pointer; the whole text typed into the pane is cut by the terminal's input line limit
      agent_args+=(-c "developer_instructions=$(printf 'You are seat %s on an agent team. Before anything else, read %s: it is your identity, the team protocol and your role, and it stays true across context clears. Read it again after a clear.' "$name" "$seat_file" | jq -Rs .)")
    fi
  fi
  # Codex rejects --add-dir under its read-only default (an untrusted folder)
  # and exits; workspace-write is its normal mode in a trusted project.
  if [ "$kind" = codex ]; then
    case " $args " in *" -s "*|*" --sandbox "*|*" --sandbox="*) ;; *) agent_args+=(-s workspace-write) ;; esac
  fi
  # the seat's conversation: a Claude seat records its session id at every
  # start, /clear and compaction (SessionStart hook); after a restart, both
  # agents resume the seat's own conversation instead of starting blank
  [ "$kind" = claude ] && agent_args+=(--settings "$(write_seat_settings "$i")")
  [ "$kind" != claude ] || write_local_hooks "$(seat_cwd "$i")"
  local resume_id=""
  [ "${SQUAD_FRESH:-0}" = 1 ] || resume_id=$(seat_resume_id "$i")
  if [ -n "$resume_id" ]; then
    case "$kind" in
      claude) agent_args=(--resume "$resume_id" "${agent_args[@]}") ;;
      codex) agent_args=(resume "$resume_id" "${agent_args[@]}") ;;
    esac
  elif [ -f "$TEAM_DIR/seats/$name.started" ] && [ "${SQUAD_FRESH:-0}" != 1 ]; then
    log_event "$name" - FRESH_START "no saved conversation to resume (none had a message yet, or it was deleted)"
  fi
  local -a fresh_args=("${start_args[@]}")
  [ "${#agent_args[@]}" -gt 0 ] && start_args+=(-- "${agent_args[@]}")
  if [ -n "$resume_id" ] && ! start_agent "${start_args[@]}"; then
    # the agent refused the old conversation: start it fresh once, and say so
    log_event "$name" - FRESH_START "resume of $resume_id was refused"
    say "  $name could not resume $resume_id; starting it fresh"
    resume_id=""
    case "$kind" in
      claude) agent_args=("${agent_args[@]:2}") ;;
      codex) agent_args=("${agent_args[@]:2}") ;;
    esac
    start_args=("${fresh_args[@]}")
    [ "${#agent_args[@]}" -gt 0 ] && start_args+=(-- "${agent_args[@]}")
    herdr pane run "$pane" "clear" >/dev/null 2>&1 || true
  fi
  if [ -n "$resume_id" ] || start_agent "${start_args[@]}"; then
    mkdir -p "$TEAM_DIR/seats"; : >"$TEAM_DIR/seats/$name.started"
    if [ -n "$resume_id" ]; then say "  resumed $name ($kind, conversation $resume_id)"; RESUMED+=("$name")
    else say "  started $name ($kind${args:+ $args})"; fi
    STARTED+=("$name")
  else
    say "  $name did not become ready."
    STUCK_ON_TRUST=0
    explain_stuck "$name" "$pane" "$START_ERR"
    # Claude and Codex both save trust per repository: one answer covers every
    # seat of that agent, so don't make the human answer the same dialog again
    [ "$STUCK_ON_TRUST" = 1 ] && TRUST_WAIT="$TRUST_WAIT$kind "
    START_FAILED=1
  fi
}

# ---- one herdr session per repository -------------------------------------------
herdr_home() { echo "${HERDR_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr}"; }

session_socket() { # the socket of this team's herdr session (it may not run yet)
  local sock
  sock=$(herdr session list --json 2>/dev/null \
    | jq -r --arg n "$SESSION_NAME" '[.. | objects | select(.name? == $n) | (.socket // .socket_path // empty)][0] // empty' 2>/dev/null) || true
  [ -n "$sock" ] || sock="$(herdr_home)/sessions/$SESSION_NAME/herdr.sock"
  echo "$sock"
}

# Inside herdr: refuse to start this repository's team in another repository's
# session. Outside herdr: start (or attach) the repository's own session and
# start the team in it.
up_from_outside() {
  need herdr "See https://herdr.dev"
  need jq "(brew install jq / apt install jq)"
  local sock; sock=$(session_socket)
  mkdir -p "$TEAM_DIR"
  if HERDR_SOCKET_PATH=$sock herdr workspace list >/dev/null 2>&1; then
    say "herdr session '$SESSION_NAME' is running: bringing the team up in it."
    HERDR_SOCKET_PATH=$sock HERDR_ENV=1 SQUAD_HEADLESS=1 "$SQUAD_HOME/bin/squad" up || say "(see the messages above; the session opens anyway)"
  else
    say "Starting herdr session '$SESSION_NAME'; the team starts in it (log: .team/up.log)."
    ( for _ in $(seq 1 60); do HERDR_SOCKET_PATH=$sock herdr workspace list >/dev/null 2>&1 && break; sleep 1; done
      HERDR_SOCKET_PATH=$sock HERDR_ENV=1 SQUAD_HEADLESS=1 "$SQUAD_HOME/bin/squad" up ) >"$TEAM_DIR/up.log" 2>&1 &
  fi
  [ "${SQUAD_NO_ATTACH:-0}" = 1 ] && return 0
  exec herdr session attach "$SESSION_NAME"
}

check_session() {
  local here=${HERDR_SOCKET_PATH:-} want
  [ -n "$here" ] || return 0
  want=$(session_socket)
  [ "$here" = "$want" ] && return 0
  # an older team that already runs in this session keeps it
  [ "$(cat "$TEAM_DIR/herdr.sock" 2>/dev/null)" = "$here" ] && return 0
  die "this herdr session is not '$SESSION_NAME', the session of $(basename "$REPO"). Each repository runs in its own session: run 'squad up' from a terminal outside herdr, or 'herdr session attach $SESSION_NAME' and 'squad up' there. (To keep this session, add 'session <its name>' to .team/team.conf.)"
}

# One 'squad up' at a time per team: worktrees and npm installs take minutes,
# and a second run in that time creates a second workspace (seen on a team).
up_lock() { # .team/up.lock -> <pid>: a link, created atomically; a dead owner's lock is taken over
  local f="$TEAM_DIR/up.lock" pid
  mkdir -p "$TEAM_DIR"
  until ln -s "$$" "$f" 2>/dev/null; do
    pid=$(readlink "$f" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      die "another 'squad up' for this team is running (pid $pid; started from outside herdr, it logs to .team/up.log). Wait for it to finish; the team appears in herdr's workspace '$(basename "$REPO") team'."
    fi
    mutex "$TEAM_DIR/.up.clean"
    [ "$(readlink "$f" 2>/dev/null || true)" != "$pid" ] || rm -f "$f"
    rmdir "$TEAM_DIR/.up.clean"
  done
  trap '[ "$(readlink "$TEAM_DIR/up.lock" 2>/dev/null)" = "$$" ] && rm -f "$TEAM_DIR/up.lock"' EXIT
}

cmd_up() {
  find_repo
  if [ "${HERDR_ENV:-}" = 1 ]; then up_lock; fi
  if [ -f "$TEAM_DIR/team.conf" ]; then update_conf; else cmd_init; fi
  load_conf
  if [ "${HERDR_ENV:-}" != 1 ]; then up_from_outside; return; fi
  require_herdr
  check_session
  mkdir -p "$TEAM_DIR/reports"
  render_team_files
  write_herdr_socket
  write_roster
  local i n; n=$(seat_count)

  git -C "$REPO" rev-parse --verify -q HEAD >/dev/null \
    || die "the repository has no commits yet. Make a first commit, then run 'squad up'."

  say "Preparing worktrees under $WT_ROOT"
  mkdir -p "$WT_ROOT"
  if [ ! -d "$WT_ROOT/integration" ]; then
    if git -C "$REPO" show-ref --verify --quiet "refs/heads/$TEAM_BASE"; then
      git -C "$REPO" worktree add "$WT_ROOT/integration" "$TEAM_BASE" >/dev/null \
        || die "git could not create the integration worktree (see the error above)."
    else
      git -C "$REPO" worktree add -b "$TEAM_BASE" "$WT_ROOT/integration" HEAD >/dev/null \
        || die "git could not create the integration worktree (see the error above)."
    fi
    setup_worktree "$WT_ROOT/integration"
  fi
  for ((i = 0; i < n; i++)); do
    case "${S_ROLE[$i]}" in dev|tester) ;; *) continue ;; esac
    if [ ! -d "$WT_ROOT/${S_NAME[$i]}" ]; then
      git -C "$REPO" worktree add --detach "$WT_ROOT/${S_NAME[$i]}" "$TEAM_BASE" >/dev/null \
        || die "git could not create the worktree for ${S_NAME[$i]} (see the error above)."
      setup_worktree "$WT_ROOT/${S_NAME[$i]}"
    fi
  done

  apply_verify_switch

  # herdr agent names are unique per herdr session (server), not per workspace
  local ws_label agents_json ws_json ws other
  ws_label="$(basename "$REPO") team"
  agents_json=$(herdr agent list) || die "herdr did not answer 'agent list'."
  ws_json=$(herdr workspace list) || die "herdr did not answer 'workspace list'."
  ws=$(jq -r --arg l "$ws_label" '.result.workspaces[] | select(.label == $l) | .workspace_id' <<<"$ws_json" | head -1)
  for ((i = 0; i < n; i++)); do
    other=$(jq -r --arg n "${S_NAME[$i]}" --arg w "$ws" '.result.agents[] | select(.name == $n and .workspace_id != $w) | .pane_id' <<<"$agents_json" | head -1)
    [ -z "$other" ] || die "an agent named '${S_NAME[$i]}' already runs in another workspace of this herdr session (pane $other) — probably another project's team. Run this team in its own session: herdr --session $(basename "$REPO")"
  done

  local lead_i=0 p_lead pane
  for ((i = 0; i < n; i++)); do [ "${S_ROLE[$i]}" = lead ] && lead_i=$i; done
  local PANES=()
  if [ -z "$ws" ]; then
    say "Creating the team workspace"
    # new agents: nobody has been briefed yet
    rm -f "$TEAM_DIR"/.briefed/*
    local created
    created=$(herdr workspace create --cwd "$WT_ROOT/integration" --label "$ws_label" --focus) \
      || die "unexpected response from herdr while creating the workspace."
    p_lead=$(jq -er '.result.root_pane.pane_id' <<<"$created") || die "unexpected response from herdr while creating the workspace."
    ws=$(jq -er '.result.workspace.workspace_id' <<<"$created")
    LEAD_I=$lead_i
    make_layout "$ws" "$(jq -r '.result.tab.tab_id' <<<"$created")" "$p_lead"
  else
    # Resume: panes carry their seat name as label (squad sets it on start).
    say "Resuming the team workspace ($ws)"
    local panes_json
    panes_json=$(herdr pane list --workspace "$ws") || die "herdr did not answer 'pane list'."
    for ((i = 0; i < n; i++)); do
      PANES[$i]=$(jq -r --arg l "${S_NAME[$i]}" '.result.panes[] | select(.label == $l) | .pane_id' <<<"$panes_json" | head -1)
    done
    p_lead=${PANES[$lead_i]:-$(jq -r '.result.panes[0].pane_id' <<<"$panes_json")}
    for ((i = 0; i < n; i++)); do
      [ -z "${PANES[$i]}" ] || continue
      if [ "${S_ROLE[$i]}" = observer ]; then PANES[$i]=$(observer_tab "$ws" "$i")
      elif [ "${S_ROLE[$i]}" = planner ]; then PANES[$i]=$(plan_tab "$ws" "$i")
      elif [ "${S_ROLE[$i]}" = critic ] && [ -n "${PANES[$(seat_index "$(first_role planner)" 2>/dev/null || echo 0)]:-}" ]; then
        PANES[$i]=$(split "${PANES[$(seat_index "$(first_role planner)")]}" right "$WT_ROOT/integration" 0.5)
      else PANES[$i]=$(split "$p_lead" down "$(seat_cwd "$i")"); fi
      say "  added a pane for ${S_NAME[$i]}"
    done
    if [ -z "$(jq -r '.result.panes[] | select(.label == "report") | .pane_id' <<<"$panes_json" | head -1)" ]; then
      report_tab "$ws"; say "  added the report tab"
    fi
    revive_helpers "$panes_json"
  fi

  rm -f "$TEAM_DIR"/observer/.watchdog/restart-* "$TEAM_DIR"/observer/.watchdog/defer-* "$TEAM_DIR"/observer/.watchdog/held-restart-*   # the owner ran squad up: the watch may restart a seat again
  say "Starting agents"
  local name detected
  for ((i = 0; i < n; i++)); do
    name=${S_NAME[$i]}; pane=${PANES[$i]}
    if [ -n "$(jq -r --arg n "$name" '.result.agents[] | select(.name == $n) | .pane_id' <<<"$agents_json")" ]; then
      if is_briefed "$name"; then say "  $name already running"
      else say "  $name already running, not briefed yet"; STARTED+=("$name"); fi
      continue
    fi
    # an agent herdr detected in the seat's pane but never named (its start
    # timed out on a first-run dialog that was answered later): adopt it
    detected=$(jq -r --arg p "$pane" '.result.agents[] | select(.pane_id == $p and .name == null) | .agent' <<<"$agents_json" | head -1)
    if [ -n "$detected" ] && herdr agent rename "$pane" "$name" >/dev/null; then
      say "  adopted the running $detected in $name's pane"
      STARTED+=("$name")
      continue
    fi
    case "$TRUST_WAIT" in
      *" ${S_KIND[$i]} "*) say "  $name waits: answer ${S_KIND[$i]}'s trust dialog once (above), it covers this seat too"; START_FAILED=1; continue ;;
    esac
    start_seat "$i" "$pane"
  done

  if [ "$START_FAILED" = 1 ]; then
    say ""
    say "Some agents need attention (see above). Answer them in their panes, then run"
    say "'squad up' again: it keeps what runs and starts only what is missing."
    exit 1
  fi

  if [ "${#STARTED[@]}" -gt 0 ]; then
    say "Briefing agents"
    brief "${STARTED[@]}" || die "some seats were not briefed. Fix them, then run 'squad brief'."
  fi
  if [ "${#RESUMED[@]}" -gt 0 ]; then
    log_event squad - RESTART "resumed: ${RESUMED[*]}"
    for ((i = 0; i < n; i++)); do
      [ "${S_ROLE[$i]}" = observer ] || continue
      case " ${RESUMED[*]} " in *" ${S_NAME[$i]} "*) herdr agent prompt "${S_NAME[$i]}" "$(restart_note) Write that as your next pass." >/dev/null || true ;; esac
    done
  fi

  say ""
  say "Team is up. The '$LEAD' pane reads .team/GOAL.md (or asks you for the goal once),"
  say "writes the spec, runs the team and reviews every task. It calls you when"
  say ".team/READY.md says everything is green."
}

# ---- status / clean ----------------------------------------------------------

cmd_status() {
  find_repo; load_conf
  local i n; n=$(seat_count)
  say "Team ($n seats) for $REPO"
  for ((i = 0; i < n; i++)); do
    printf '  %-12s %-9s %-9s %s\n' "${S_NAME[$i]}" "${S_ROLE[$i]}" "${S_KIND[$i]}" "${S_ARGS[$i]}"
  done
  if [ -f "$TEAM_DIR/SPEC.md" ]; then say ""; say "Spec: $(grep -m1 '^Status:' "$TEAM_DIR/SPEC.md" | sed 's/^Status: *//; s/ *<!--.*//' || echo unknown)"; fi
  if [ -f "$TEAM_DIR/TASKS.md" ]; then
    say ""; say "Tasks:"
    # The first table in the file is the status table.
    awk '/^\|/ {print "  " $0; seen=1; next} seen {exit}' "$TEAM_DIR/TASKS.md"
  fi
  if [ "${HERDR_ENV:-}" = 1 ] && command -v herdr >/dev/null 2>&1; then
    local agents_json state
    agents_json=$(herdr agent list 2>/dev/null) || agents_json='{"result":{"agents":[]}}'
    say ""; say "Agents:"
    for ((i = 0; i < n; i++)); do
      state=$(jq -r --arg n "${S_NAME[$i]}" '[.result.agents[] | select(.name == $n) | .agent_status][0] // "not running"' <<<"$agents_json")
      printf '  %-12s %s\n' "${S_NAME[$i]}" "$state"
    done
  fi
}

# squad down — stop the team: close its herdr workspace (and every agent in
# it). Worktrees, branches and .team/ stay; 'squad up' starts it again.
cmd_down() {
  require_herdr; find_repo
  local ws
  ws=$(herdr workspace list | jq -r --arg l "$(basename "$REPO") team" '.result.workspaces[] | select(.label == $l) | .workspace_id' | head -1)
  herdr_socket_call agent.view.clear '{"source":"squad:view"}' >/dev/null 2>&1 || true; ui_reset
  local f; for f in "$HOME/.config/squad/teams"/*; do   # the tab bar line stops counting this team
    [ -f "$f" ] && [ "$(cat "$f")" = "$TEAM_DIR" ] && rm -f "$f"; done
  [ -n "$ws" ] || { say "No team workspace is open."; return 0; }
  herdr workspace close "$ws" >/dev/null || die "herdr could not close workspace $ws."
  rm -f "$TEAM_DIR"/.briefed/*
  say "Team stopped (workspace $ws closed). Worktrees and branches are kept; 'squad clean' removes the worktrees."
}

cmd_clean() {
  find_repo
  [ -d "$WT_ROOT" ] || { say "No team worktrees to remove."; return 0; }
  local wt kept=0
  # the dev snapshots first: they hold nothing but committed code
  for wt in "$WT_ROOT"/.runs/*/; do
    [ -d "$wt" ] && git -C "$REPO" worktree remove --force "${wt%/}" 2>/dev/null && say "  removed snapshot .runs/$(basename "$wt")"
  done
  rmdir "$WT_ROOT/.runs" 2>/dev/null || true
  for wt in "$WT_ROOT"/*/; do
    [ -d "$wt" ] || continue
    wt=${wt%/}
    # No --force: git refuses to remove a worktree with uncommitted changes.
    if git -C "$REPO" worktree remove "$wt" 2>/dev/null; then say "  removed ${wt#"$WT_ROOT"/}"
    else say "  kept    ${wt#"$WT_ROOT"/} (has uncommitted changes, or is not a worktree)"; kept=1; fi
  done
  rmdir "$WT_ROOT" 2>/dev/null || true
  say "Branches were not deleted. Your work is on '$(sed -n 's/^base  *//p' "$TEAM_DIR/team.conf" 2>/dev/null | head -1)' and the task/* branches."
  return $kept
}

# ---- main --------------------------------------------------------------------

cmd=${1:-help}; [ $# -gt 0 ] && shift
# -h or --help as a command's first argument: the help and nothing else (ticket 024: 'squad plan --help'
# wrote a plan with the goal "--help"); 'squad herdr' passes it on to herdr
case "$cmd:${1:-}" in herdr:*) ;; *:-h|*:--help) usage; exit 0 ;; esac
case "$cmd" in
  new)     cmd_new "$@" ;;
  init)    cmd_init "$@" ;;
  up)      [ "${1:-}" = --fresh ] && export SQUAD_FRESH=1; cmd_up ;;
  brief)   cmd_brief ;;
  status)  cmd_status ;;
  clean)   cmd_clean ;;
  down)    cmd_down ;;
  config)  cmd_config "$@" ;;
  doctor)  cmd_doctor ;;
  presets) cmd_presets ;;
  herdr)   cmd_herdr "$@" ;;
  done)    cmd_done "$@" ;;
  usage)   cmd_usage ;;
  watch)   cmd_watch "$@" ;;
  statusline) cmd_statusline ;;
  git)     cmd_git "$@" ;;
  heavy)   cmd_heavy "$@" ;;
  update-conf) cmd_update_conf ;;
  dispatch) cmd_dispatch "$@" ;;
  merge)   cmd_merge "$@" ;;
  candidate) cmd_candidate "$@" ;;
  notify)  cmd_notify "$@" ;;
  consult) cmd_consult "$@" ;;
  plan)    cmd_plan "$@" ;;
  ui-setup) find_repo; load_conf; cmd_ui_setup ;;
  herdr-line) cmd_herdr_line ;;
  timed)   cmd_timed "$@" ;;
  start-seat) cmd_start_seat "$@" ;;
  decisions) cmd_decisions "$@" ;;
  feedback) cmd_feedback "$@" ;;
  _owner-filter) OWNER_MODE=${1:-visual}; owner_filter ;;   # internal: tests
  report)  cmd_report "$@" ;;
  session-id) cmd_session_id "$@" ;;
  seat-hook) cmd_seat_hook "$@" ;;
  wait-owner) cmd_wait_owner "$@" ;;
  seen) cmd_seen "$@" ;;
  permissions) cmd_permissions ;;
  -v|--version|version) say "squad $VERSION" ;;
  -h|--help|help) usage ;;
  *) usage >&2; die "unknown command '$cmd'." ;;
esac
